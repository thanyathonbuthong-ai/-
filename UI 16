--[[
    ============================================================================
    EntrenchedUI  v1.0  —  standalone Roblox UI library
    Extracted & refactored from the Entrenched Hub v2 interface.

    Dark, spring-animated, Alt-gated cursor. One file. No dependencies beyond
    an executor with standard globals (gethui / writefile / getcustomasset are
    probed at runtime and the UI degrades gracefully when they are absent).

    ------------------------------------------------------------------  API --
    local UI = EntrenchedUI.new({
        Title      = "My Hub",          -- header text
        Version    = "1.0",              -- small badge next to the title (nil to hide)
        Accent     = "Amber",            -- Amber | Violet | Crimson | Mint | Ice  (or a Color3)
        ToggleKey  = "RightShift",       -- key that shows/hides the panel ("None" disables)
        AltCursor  = true,               -- hold Left Alt to free the cursor in FPS games
        ReduceMotion = false,
        Scale      = 1,                  -- 0.5 .. 1.4 multiplier on top of viewport scale
        FontScale  = 1,
        ConfigFile = nil,                -- e.g. "MyHub_Config.json" enables auto save/load
        AutoSave   = true,
    })

    local Tab     = UI:Tab("Combat", "i_combat")      -- icon: i_combat/i_visuals/i_world/i_stats/i_settings/chevron/nil
    local Section = Tab:Section("Aimbot", "optional subtitle")

    Section:Toggle("Enabled", true, function(v) end)           -> control :Get() :Set(v) :OnChange(fn)
    Section:Slider("FOV", 0, 180, 25, 1, "°", function(v) end)
    Section:Dropdown("Target part", {"Head","Torso","Closest"}, "Head", function(v) end)
    Section:Swatches("Accent", UI.Accents, "Amber", function(name) end)   -- UI.Accents is the built-in list
    Section:Keybind("Toggle key", "None", function(v) end)
    Section:Button("Reset", "Reset now", function() end, nil, false)      -- last arg = danger style
    Section:Note("A wrapped line of help text.")

    UI:Toast("Title", "optional body", "info")   -- info | warn | kill | head
    UI:Notify("short message")
    UI:SetAccent("Mint")                         -- or a Color3
    UI:Toggle() / UI:Show() / UI:Hide()
    UI:Destroy()                                 -- removes everything, restores cursor
    ============================================================================
]]

local EntrenchedUI = {}
EntrenchedUI.__index = EntrenchedUI

------------------------------------------------------------------------
-- Boot: shared state L, services, executor caps, fault capture, maid,
-- event bus. Mirrors the original hub's `E` table but self-contained.
------------------------------------------------------------------------
local function newState(opts)
    local L = { opts = opts or {}, alive = true, faults = {} }
    local G = getgenv and getgenv() or _G

    -- tear down a previous instance of this library so reload never stacks screens
    local prev = rawget(G, "__ENTRENCHED_UI_LIB")
    if type(prev) == "table" and type(prev.unload) == "function" then
        pcall(prev.unload, "reload")
    end
    G.__ENTRENCHED_UI_LIB = L

    local function svc(n) return game:GetService(n) end
    L.Players    = svc("Players")
    L.RunService = svc("RunService")
    L.UIS        = svc("UserInputService")
    L.TextService= svc("TextService")
    L.HttpService= svc("HttpService")
    L.LP         = L.Players.LocalPlayer

    local X = {}
    for _, name in ipairs({
        "hookfunction","restorefunction","getconnections","getgc","islclosure",
        "gethui","writefile","readfile","isfile","isfolder","makefolder",
        "delfile","getcustomasset","cloneref",
    }) do
        local ok, v = pcall(function() return G[name] end)
        if ok and type(v) == "function" then X[name] = v end
    end
    L.X = X

    local warned = {}
    function L.fault(label, err)
        local msg = tostring(err)
        L.faults[#L.faults + 1] = label .. ": " .. msg
        if #L.faults > 60 then table.remove(L.faults, 1) end
        if not warned[label] then
            warned[label] = true
            warn("[EntrenchedUI] " .. label .. ": " .. msg)
        end
    end
    function L.try(label, fn, ...)
        local ok, a, b, c = pcall(fn, ...)
        if not ok then L.fault(label, a) return false end
        return true, a, b, c
    end

    -- maid
    local tasks = {}
    function L.own(item) tasks[#tasks + 1] = item return item end
    function L.connect(signal, fn)
        local ok, conn = pcall(function() return signal:Connect(fn) end)
        if ok and conn then tasks[#tasks + 1] = conn return conn end
        L.fault("connect", conn)
        return nil
    end
    local binds = {}
    function L.bind(name, priority, fn)
        pcall(function() L.RunService:UnbindFromRenderStep(name) end)
        local ok, err = pcall(function() L.RunService:BindToRenderStep(name, priority, fn) end)
        if not ok then L.fault("bind " .. name, err) return end
        binds[name] = true
    end
    function L.unbind(name)
        pcall(function() L.RunService:UnbindFromRenderStep(name) end)
        binds[name] = nil
    end
    function L.loop(label, fn)
        task.spawn(function()
            while L.alive do
                local ok, wait = pcall(fn)
                if not ok then L.fault(label, wait) wait = 1 end
                task.wait(type(wait) == "number" and wait or 0.1)
            end
        end)
    end
    local listeners = {}
    function L.on(name, fn)
        listeners[name] = listeners[name] or {}
        table.insert(listeners[name], fn)
    end
    function L.emit(name, ...)
        for _, fn in ipairs(listeners[name] or {}) do L.try("event " .. name, fn, ...) end
    end
    local unloadHooks = {}
    function L.onUnload(fn) unloadHooks[#unloadHooks + 1] = fn end
    function L.unload(reason)
        if not L.alive then return end
        L.alive = false
        for i = #unloadHooks, 1, -1 do pcall(unloadHooks[i], reason) end
        for name in pairs(binds) do pcall(function() L.RunService:UnbindFromRenderStep(name) end) end
        for i = #tasks, 1, -1 do
            local t = tasks[i]
            local ty = typeof(t)
            if ty == "RBXScriptConnection" then pcall(function() t:Disconnect() end)
            elseif ty == "Instance" then pcall(function() t:Destroy() end)
            elseif ty == "function" then pcall(t)
            end
        end
        table.clear(tasks)
        if rawget(G, "__ENTRENCHED_UI_LIB") == L then G.__ENTRENCHED_UI_LIB = nil end
    end
    function L.clock() return os.clock() end
    return L
end

