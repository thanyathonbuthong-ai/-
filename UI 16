--[[
    EntrenchedUI.lua
    Standalone UI library extracted/rebuilt from the Entrenched hub UI style.

    Features:
      * Compact mobile-friendly window
      * Fixed control/button sizes (UIScale affects the whole window evenly)
      * Sidebar tabs with selection indicator
      * Sections, labels, paragraphs
      * Buttons, toggles, sliders, dropdowns, keybinds
      * Notifications
      * Dragging
      * Minimize / close
      * Theme API
      * No game-specific / combat logic

    Example:
        local Library = loadstring(game:HttpGet(URL))()

        local Window = Library:CreateWindow({
            Title = "ENTRENCHED",
            Subtitle = "My Script",
            Version = "1.0",
            MobileScale = 0.86,
        })

        local Main = Window:AddTab("Main", "◆")
        local Section = Main:AddSection("General", "Settings")

        Section:AddToggle("Enabled", false, function(value)
            print(value)
        end)

        Section:AddButton("Test", "Click me", function()
            Window:Notify("Hello", "Button clicked")
        end)
]]

local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

Library.Theme = {
    Base = Color3.fromRGB(14, 15, 18),
    Raised = Color3.fromRGB(21, 23, 27),
    Hover = Color3.fromRGB(28, 31, 36),
    Line = Color3.fromRGB(48, 51, 58),
    Text = Color3.fromRGB(238, 240, 244),
    Dim = Color3.fromRGB(164, 168, 177),
    Mute = Color3.fromRGB(112, 116, 125),
    Accent = Color3.fromRGB(23, 153, 110),
    Good = Color3.fromRGB(62, 196, 132),
    Bad = Color3.fromRGB(220, 82, 92),
}

local function tween(obj, props, time)
    local ok, t = pcall(function()
        local x = TweenService:Create(
            obj,
            TweenInfo.new(time or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            props
        )
        x:Play()
        return x
    end)
    return ok and t or nil
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Library.Theme.Line
    s.Transparency = transparency or 0
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function label(parent, text, size, color, font)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text or ""
    l.TextColor3 = color or Library.Theme.Text
    l.TextSize = size or 14
    l.Font = font or Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Parent = parent
    return l
end

local function button(parent, text, size)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = false
    b.BackgroundColor3 = Library.Theme.Raised
    b.BorderSizePixel = 0
    b.Text = text or ""
    b.TextColor3 = Library.Theme.Text
    b.TextSize = 13
    b.Font = Enum.Font.GothamMedium
    b.Size = size or UDim2.fromOffset(90, 30)
    b.Parent = parent
    corner(b, 7)
    return b
end

local function addHover(b, normal, hover)
    b.MouseEnter:Connect(function()
        tween(b, {BackgroundColor3 = hover or Library.Theme.Hover}, 0.12)
    end)
    b.MouseLeave:Connect(function()
        tween(b, {BackgroundColor3 = normal or Library.Theme.Raised}, 0.12)
    end)
end

local function makeDrag(handle, target)
    local dragging = false
    local dragStart
    local startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position

            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart
        target.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end)
end

function Library.new()
    local self = setmetatable({}, Library)

    self._connections = {}
    self._tabs = {}
    self._destroyed = false
    self._mobileScale = 0.86

    return self
end

function Library:CreateWindow(options)
    options = options or {}

    local selfWindow = self
    local title = options.Title or "ENTRENCHED"
    local subtitle = options.Subtitle or ""
    local version = options.Version or "1.0"
    local mobileScale = math.clamp(options.MobileScale or 0.86, 0.65, 1.2)
    self._mobileScale = mobileScale

    local guiParent = options.Parent
    if not guiParent then
        guiParent = CoreGui
        if typeof(gethui) == "function" then
            local ok, h = pcall(gethui)
            if ok and h then guiParent = h end
        elseif LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui") then
            guiParent = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        end
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "EntrenchedUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = guiParent
    self.Gui = gui

    local holder = Instance.new("Frame")
    holder.Name = "Holder"
    holder.AnchorPoint = Vector2.new(0.5, 0.5)
    holder.Position = UDim2.fromScale(0.5, 0.5)
    holder.Size = UDim2.fromOffset(680, 470)
    holder.BackgroundTransparency = 1
    holder.Parent = gui
    self.Holder = holder

    local uiScale = Instance.new("UIScale")
    uiScale.Scale = UIS.TouchEnabled and mobileScale or 1
    uiScale.Parent = holder
    self.UIScale = uiScale

    local function rescale()
        if self._destroyed then return end
        uiScale.Scale = UIS.TouchEnabled and self._mobileScale or 1
    end

    self.Rescale = rescale

    local window = Instance.new("Frame")
    window.Name = "Window"
    window.Size = UDim2.fromScale(1, 1)
    window.BackgroundColor3 = Library.Theme.Base
    window.BorderSizePixel = 0
    window.Parent = holder
    corner(window, 12)
    stroke(window, Library.Theme.Line, 0.25, 1)
    self.Window = window

    local wash = Instance.new("Frame")
    wash.BackgroundColor3 = Library.Theme.Accent
    wash.BackgroundTransparency = 0.92
    wash.BorderSizePixel = 0
    wash.Size = UDim2.new(1, 0, 0, 125)
    wash.Parent = window
    corner(wash, 12)

    local header = Instance.new("Frame")
    header.BackgroundTransparency = 1
    header.Size = UDim2.new(1, 0, 0, 52)
    header.Parent = window
    self.Header = header

    local mark = Instance.new("Frame")
    mark.BackgroundColor3 = Library.Theme.Accent
    mark.BorderSizePixel = 0
    mark.Size = UDim2.fromOffset(10, 10)
    mark.Position = UDim2.fromOffset(22, 21)
    mark.Rotation = 45
    mark.Parent = header
    corner(mark, 2)

    local titleLabel = label(header, title, 16, Library.Theme.Text, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(42, 8)
    titleLabel.Size = UDim2.fromOffset(210, 22)

    local subtitleLabel = label(header, subtitle, 11, Library.Theme.Mute, Enum.Font.Gotham)
    subtitleLabel.Position = UDim2.fromOffset(42, 28)
    subtitleLabel.Size = UDim2.fromOffset(250, 18)

    local versionLabel = label(header, "v" .. version, 10, Library.Theme.Dim, Enum.Font.GothamMedium)
    versionLabel.BackgroundColor3 = Library.Theme.Raised
    versionLabel.BackgroundTransparency = 0
    versionLabel.Position = UDim2.fromOffset(245, 17)
    versionLabel.Size = UDim2.fromOffset(44, 20)
    versionLabel.TextXAlignment = Enum.TextXAlignment.Center
    corner(versionLabel, 10)

    local min = button(header, "—", UDim2.fromOffset(28, 28))
    min.Position = UDim2.new(1, -72, 0.5, -14)
    min.TextSize = 15
    min.TextColor3 = Library.Theme.Dim

    local close = button(header, "×", UDim2.fromOffset(28, 28))
    close.Position = UDim2.new(1, -38, 0.5, -14)
    close.TextSize = 18
    close.TextColor3 = Library.Theme.Dim

    addHover(min)
    addHover(close)

    local side = Instance.new("Frame")
    side.Name = "Sidebar"
    side.BackgroundTransparency = 1
    side.Position = UDim2.fromOffset(0, 52)
    side.Size = UDim2.new(0, 150, 1, -52)
    side.Parent = window
    self.Sidebar = side

    local divider = Instance.new("Frame")
    divider.BackgroundColor3 = Library.Theme.Line
    divider.BackgroundTransparency = 0.45
    divider.BorderSizePixel = 0
    divider.Position = UDim2.fromOffset(150, 64)
    divider.Size = UDim2.new(0, 1, 1, -76)
    divider.Parent = window

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.BackgroundTransparency = 1
    content.ClipsDescendants = true
    content.Position = UDim2.fromOffset(151, 52)
    content.Size = UDim2.new(1, -151, 1, -60)
    content.Parent = window
    self.Content = content

    local tabsHolder = Instance.new("Frame")
    tabsHolder.BackgroundTransparency = 1
    tabsHolder.Size = UDim2.fromScale(1, 1)
    tabsHolder.Parent = content

    local selection = Instance.new("Frame")
    selection.BackgroundColor3 = Library.Theme.Accent
    selection.BorderSizePixel = 0
    selection.Size = UDim2.fromOffset(3, 18)
    selection.Visible = false
    selection.Parent = side
    corner(selection, 2)
    self.Selection = selection

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 4)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = side

    local sidePad = Instance.new("UIPadding")
    sidePad.PaddingTop = UDim.new(0, 9)
    sidePad.PaddingLeft = UDim.new(0, 12)
    sidePad.PaddingRight = UDim.new(0, 12)
    sidePad.Parent = side

    local opened = true

    local function setVisible(value)
        opened = value
        holder.Visible = value
    end

    min.Activated:Connect(function()
        setVisible(false)
    end)

    close.Activated:Connect(function()
        self:Destroy()
    end)

    -- A small reopen pill stays usable after minimize.
    local pill = Instance.new("TextButton")
    pill.Name = "Reopen"
    pill.Visible = false
    pill.AnchorPoint = Vector2.new(0.5, 0.5)
    pill.Position = UDim2.fromScale(0.5, 0.86)
    pill.Size = UDim2.fromOffset(150, 38)
    pill.BackgroundColor3 = Library.Theme.Base
    pill.BorderSizePixel = 0
    pill.Text = title
    pill.TextColor3 = Library.Theme.Text
    pill.TextSize = 13
    pill.Font = Enum.Font.GothamBold
    pill.Parent = gui
    corner(pill, 19)
    stroke(pill, Library.Theme.Line, 0.2, 1)

    min.Activated:Connect(function()
        holder.Visible = false
        pill.Visible = true
    end)

    pill.Activated:Connect(function()
        pill.Visible = false
        holder.Visible = true
    end)

    makeDrag(header, holder)

    self._tabsHolder = tabsHolder
    self._setVisible = setVisible

    function selfWindow:AddTab(name, icon)
        local tab = {
            Window = selfWindow,
            Name = name,
            Sections = {},
        }

        local tabButton = Instance.new("TextButton")
        tabButton.Name = "Tab_" .. name
        tabButton.LayoutOrder = #selfWindow._tabs + 1
        tabButton.Size = UDim2.new(1, 0, 0, 34)
        tabButton.BackgroundColor3 = Library.Theme.Raised
        tabButton.BackgroundTransparency = 1
        tabButton.BorderSizePixel = 0
        tabButton.Text = ""
        tabButton.Parent = side
        corner(tabButton, 7)

        local iconLabel = label(tabButton, icon or "◆", 14, Library.Theme.Mute, Enum.Font.GothamBold)
        iconLabel.Position = UDim2.fromOffset(10, 0)
        iconLabel.Size = UDim2.fromOffset(22, 34)
        iconLabel.TextXAlignment = Enum.TextXAlignment.Center

        local nameLabel = label(tabButton, name, 12, Library.Theme.Dim, Enum.Font.GothamMedium)
        nameLabel.Position = UDim2.fromOffset(38, 0)
        nameLabel.Size = UDim2.new(1, -44, 1, 0)

        local page = Instance.new("ScrollingFrame")
        page.Name = "Page_" .. name
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.Size = UDim2.fromScale(1, 1)
        page.CanvasSize = UDim2.new()
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.ScrollBarThickness = 2
        page.ScrollBarImageColor3 = Library.Theme.Accent
        page.Visible = false
        page.Parent = tabsHolder

        local pagePad = Instance.new("UIPadding")
        pagePad.PaddingTop = UDim.new(0, 10)
        pagePad.PaddingBottom = UDim.new(0, 14)
        pagePad.PaddingLeft = UDim.new(0, 14)
        pagePad.PaddingRight = UDim.new(0, 14)
        pagePad.Parent = page

        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 10)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = page

        tab.Button = tabButton
        tab.Page = page
        tab.Icon = iconLabel
        tab.Label = nameLabel
        table.insert(selfWindow._tabs, tab)

        local function select()
            for _, other in ipairs(selfWindow._tabs) do
                other.Page.Visible = false
                other.Button.BackgroundTransparency = 1
                other.Label.TextColor3 = Library.Theme.Dim
                other.Icon.TextColor3 = Library.Theme.Mute
            end

            page.Visible = true
            tabButton.BackgroundTransparency = 0.72
            tabButton.BackgroundColor3 = Library.Theme.Accent
            nameLabel.TextColor3 = Library.Theme.Text
            iconLabel.TextColor3 = Library.Theme.Accent

            selection.Visible = true
            selection.Position = UDim2.new(0, 12, 0, tabButton.AbsolutePosition.Y - side.AbsolutePosition.Y + 8)
        end

        tab.Select = select

        tabButton.Activated:Connect(select)

        if #selfWindow._tabs == 1 then
            select()
        end

        function tab:AddSection(sectionTitle, sectionSubtitle)
            local sec = {
                Tab = tab,
                Controls = {},
            }

            local frame = Instance.new("Frame")
            frame.Name = "Section"
            frame.BackgroundColor3 = Library.Theme.Raised
            frame.BackgroundTransparency = 0.18
            frame.BorderSizePixel = 0
            frame.Size = UDim2.new(1, 0, 0, 0)
            frame.AutomaticSize = Enum.AutomaticSize.Y
            frame.Parent = page
            corner(frame, 9)
            stroke(frame, Library.Theme.Line, 0.45, 1)

            local pad = Instance.new("UIPadding")
            pad.PaddingTop = UDim.new(0, 11)
            pad.PaddingBottom = UDim.new(0, 11)
            pad.PaddingLeft = UDim.new(0, 12)
            pad.PaddingRight = UDim.new(0, 12)
            pad.Parent = frame

            local layout = Instance.new("UIListLayout")
            layout.Padding = UDim.new(0, 7)
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Parent = frame

            local heading = label(frame, sectionTitle or "Section", 13, Library.Theme.Text, Enum.Font.GothamBold)
            heading.Size = UDim2.new(1, 0, 0, 20)

            if sectionSubtitle and sectionSubtitle ~= "" then
                local sub = label(frame, sectionSubtitle, 10, Library.Theme.Mute, Enum.Font.Gotham)
                sub.Size = UDim2.new(1, 0, 0, 18)
                sub.TextWrapped = true
            end

            table.insert(tab.Sections, sec)

            function sec:AddLabel(text)
                local l = label(frame, text, 12, Library.Theme.Dim)
                l.Size = UDim2.new(1, 0, 0, 24)
                l.TextWrapped = true
                table.insert(sec.Controls, l)
                return l
            end

            function sec:AddParagraph(titleText, bodyText)
                local wrap = Instance.new("Frame")
                wrap.BackgroundTransparency = 1
                wrap.Size = UDim2.new(1, 0, 0, 0)
                wrap.AutomaticSize = Enum.AutomaticSize.Y
                wrap.Parent = frame

                local lay = Instance.new("UIListLayout")
                lay.Padding = UDim.new(0, 2)
                lay.Parent = wrap

                local h = label(wrap, titleText or "", 11, Library.Theme.Text, Enum.Font.GothamMedium)
                h.Size = UDim2.new(1, 0, 0, 18)

                local b = label(wrap, bodyText or "", 10, Library.Theme.Mute)
                b.Size = UDim2.new(1, 0, 0, 0)
                b.AutomaticSize = Enum.AutomaticSize.Y
                b.TextWrapped = true

                table.insert(sec.Controls, wrap)
                return wrap
            end

            function sec:AddButton(text, caption, callback)
                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, caption and 42 or 34)
                row.Parent = frame

                local titleL = label(row, text or "Button", 12, Library.Theme.Text, Enum.Font.GothamMedium)
                titleL.Position = UDim2.fromOffset(0, 0)
                titleL.Size = UDim2.new(1, -106, 1, 0)

                local b = button(row, caption or "Run", UDim2.fromOffset(96, 30))
                b.AnchorPoint = Vector2.new(1, 0.5)
                b.Position = UDim2.new(1, 0, 0.5, 0)
                addHover(b)

                if callback then b.Activated:Connect(function() callback() end) end
                table.insert(sec.Controls, row)
                return b
            end

            function sec:AddToggle(text, default, callback)
                local state = default == true

                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, 34)
                row.Parent = frame

                local titleL = label(row, text or "Toggle", 12, Library.Theme.Text, Enum.Font.GothamMedium)
                titleL.Size = UDim2.new(1, -62, 1, 0)

                local t = Instance.new("TextButton")
                t.AutoButtonColor = false
                t.Text = ""
                t.AnchorPoint = Vector2.new(1, 0.5)
                t.Position = UDim2.new(1, 0, 0.5, 0)
                t.Size = UDim2.fromOffset(42, 22)
                t.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Line
                t.BorderSizePixel = 0
                t.Parent = row
                corner(t, 11)

                local knob = Instance.new("Frame")
                knob.Size = UDim2.fromOffset(18, 18)
                knob.AnchorPoint = Vector2.new(0, 0.5)
                knob.Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
                knob.BackgroundColor3 = Library.Theme.Text
                knob.BorderSizePixel = 0
                knob.Parent = t
                corner(knob, 9)

                local control = {}

                function control:Set(value, silent)
                    state = value == true
                    tween(t, {BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Line})
                    tween(knob, {
                        Position = state and UDim2.new(1, -20, 0.5, 0)
                            or UDim2.new(0, 2, 0.5, 0)
                    })
                    if callback and not silent then callback(state) end
                end

                function control:Get()
                    return state
                end

                t.Activated:Connect(function() control:Set(not state) end)
                table.insert(sec.Controls, control)
                return control
            end

            function sec:AddSlider(text, minValue, maxValue, default, callback, suffix)
                minValue = tonumber(minValue) or 0
                maxValue = tonumber(maxValue) or 100
                local value = math.clamp(tonumber(default) or minValue, minValue, maxValue)

                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, 48)
                row.Parent = frame

                local titleL = label(row, text or "Slider", 12, Library.Theme.Text, Enum.Font.GothamMedium)
                titleL.Position = UDim2.fromOffset(0, 0)
                titleL.Size = UDim2.new(1, -70, 0, 20)

                local valueL = label(row, "", 11, Library.Theme.Dim, Enum.Font.GothamMedium)
                valueL.AnchorPoint = Vector2.new(1, 0)
                valueL.Position = UDim2.new(1, 0, 0, 0)
                valueL.Size = UDim2.fromOffset(65, 20)
                valueL.TextXAlignment = Enum.TextXAlignment.Right

                local bar = Instance.new("Frame")
                bar.Position = UDim2.fromOffset(0, 29)
                bar.Size = UDim2.new(1, 0, 0, 6)
                bar.BackgroundColor3 = Library.Theme.Line
                bar.BorderSizePixel = 0
                bar.Parent = row
                corner(bar, 3)

                local fill = Instance.new("Frame")
                fill.BackgroundColor3 = Library.Theme.Accent
                fill.BorderSizePixel = 0
                fill.Size = UDim2.fromScale(0, 1)
                fill.Parent = bar
                corner(fill, 3)

                local dragging = false

                local function paint()
                    local alpha = maxValue > minValue and (value - minValue) / (maxValue - minValue) or 0
                    fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
                    valueL.Text = tostring(math.floor(value * 100) / 100) .. (suffix or "")
                end

                local function apply(input)
                    local x = math.clamp(
                        input.Position.X - bar.AbsolutePosition.X,
                        0,
                        bar.AbsoluteSize.X
                    )
                    local alpha = bar.AbsoluteSize.X > 0 and x / bar.AbsoluteSize.X or 0
                    value = minValue + (maxValue - minValue) * alpha
                    paint()
                    if callback then callback(value) end
                end

                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        apply(input)
                    end
                end)

                UIS.InputChanged:Connect(function(input)
                    if dragging and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        apply(input)
                    end
                end)

                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                local control = {}
                function control:Set(v, silent)
                    value = math.clamp(tonumber(v) or minValue, minValue, maxValue)
                    paint()
                    if callback and not silent then callback(value) end
                end
                function control:Get() return value end

                paint()
                table.insert(sec.Controls, control)
                return control
            end

            function sec:AddDropdown(text, values, default, callback)
                values = values or {}
                local current = default or values[1]

                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, 38)
                row.Parent = frame

                local titleL = label(row, text or "Dropdown", 12, Library.Theme.Text, Enum.Font.GothamMedium)
                titleL.Size = UDim2.new(1, -150, 1, 0)

                local b = button(row, tostring(current or "Select"), UDim2.fromOffset(142, 30))
                b.AnchorPoint = Vector2.new(1, 0.5)
                b.Position = UDim2.new(1, 0, 0.5, 0)
                b.TextXAlignment = Enum.TextXAlignment.Center
                addHover(b)

                local menu = Instance.new("Frame")
                menu.Visible = false
                menu.ZIndex = 50
                menu.BackgroundColor3 = Library.Theme.Base
                menu.BorderSizePixel = 0
                menu.Position = UDim2.new(0, 0, 1, 4)
                menu.Size = UDim2.new(1, 0, 0, math.min(#values * 28 + 8, 170))
                menu.Parent = b
                corner(menu, 7)
                stroke(menu, Library.Theme.Line, 0.1, 1)

                local ml = Instance.new("UIListLayout")
                ml.Padding = UDim.new(0, 2)
                ml.Parent = menu

                local mp = Instance.new("UIPadding")
                mp.PaddingTop = UDim.new(0, 4)
                mp.PaddingBottom = UDim.new(0, 4)
                mp.PaddingLeft = UDim.new(0, 4)
                mp.PaddingRight = UDim.new(0, 4)
                mp.Parent = menu

                local control = {}

                local function rebuild()
                    for _, child in ipairs(menu:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end

                    for _, v in ipairs(values) do
                        local item = button(menu, tostring(v), UDim2.new(1, 0, 0, 26))
                        item.ZIndex = 51
                        item.TextSize = 11
                        addHover(item, Library.Theme.Base, Library.Theme.Hover)
                        item.Activated:Connect(function()
                            current = v
                            b.Text = tostring(v)
                            menu.Visible = false
                            if callback then callback(v) end
                        end)
                    end
                end

                b.Activated:Connect(function()
                    menu.Visible = not menu.Visible
                    if menu.Visible then rebuild() end
                end)

                function control:Set(v, silent)
                    current = v
                    b.Text = tostring(v)
                    menu.Visible = false
                    if callback and not silent then callback(v) end
                end
                function control:Get() return current end

                table.insert(sec.Controls, control)
                return control
            end

            function sec:AddKeybind(text, defaultKey, callback)
                local current = defaultKey
                local listening = false

                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, 38)
                row.Parent = frame

                local titleL = label(row, text or "Keybind", 12, Library.Theme.Text, Enum.Font.GothamMedium)
                titleL.Size = UDim2.new(1, -112, 1, 0)

                local b = button(row, tostring(current or "None"), UDim2.fromOffset(104, 30))
                b.AnchorPoint = Vector2.new(1, 0.5)
                b.Position = UDim2.new(1, 0, 0.5, 0)
                addHover(b)

                b.Activated:Connect(function()
                    listening = true
                    b.Text = "Press key..."
                end)

                local conn = UIS.InputBegan:Connect(function(input, processed)
                    if not listening or processed then return end
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    current = input.KeyCode.Name
                    listening = false
                    b.Text = current
                    if callback then callback(current) end
                end)
                table.insert(selfWindow._connections, conn)

                local control = {}
                function control:Set(v, silent)
                    current = v
                    b.Text = tostring(v or "None")
                    listening = false
                    if callback and not silent then callback(v) end
                end
                function control:Get() return current end

                table.insert(sec.Controls, control)
                return control
            end

            return sec
        end

        return tab
    end

    return selfWindow
end

function Library:Notify(title, message, duration)
    if not self.Gui then return end

    local holder = self.Gui:FindFirstChild("Notifications")
    if not holder then
        holder = Instance.new("Frame")
        holder.Name = "Notifications"
        holder.AnchorPoint = Vector2.new(1, 1)
        holder.Position = UDim2.new(1, -18, 1, -18)
        holder.Size = UDim2.fromOffset(300, 300)
        holder.BackgroundTransparency = 1
        holder.Parent = self.Gui

        local layout = Instance.new("UIListLayout")
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.Padding = UDim.new(0, 7)
        layout.Parent = holder
    end

    local card = Instance.new("Frame")
    card.BackgroundColor3 = Library.Theme.Base
    card.BackgroundTransparency = 0.02
    card.BorderSizePixel = 0
    card.Size = UDim2.fromOffset(280, 62)
    card.Parent = holder
    corner(card, 9)
    stroke(card, Library.Theme.Line, 0.25, 1)

    local accent = Instance.new("Frame")
    accent.BackgroundColor3 = Library.Theme.Accent
    accent.BorderSizePixel = 0
    accent.Size = UDim2.fromOffset(3, 38)
    accent.Position = UDim2.fromOffset(9, 12)
    accent.Parent = card
    corner(accent, 2)

    local h = label(card, title or "Notification", 12, Library.Theme.Text, Enum.Font.GothamBold)
    h.Position = UDim2.fromOffset(21, 9)
    h.Size = UDim2.new(1, -30, 0, 18)

    local b = label(card, message or "", 10, Library.Theme.Mute)
    b.Position = UDim2.fromOffset(21, 28)
    b.Size = UDim2.new(1, -30, 0, 25)
    b.TextWrapped = true

    task.delay(duration or 3, function()
        if card.Parent then
            tween(card, {BackgroundTransparency = 1}, 0.18)
            task.wait(0.2)
            card:Destroy()
        end
    end)
end

function Library:SetMobileScale(scale)
    self._mobileScale = math.clamp(tonumber(scale) or 0.86, 0.65, 1.2)
    if self.Rescale then self.Rescale() end
end

function Library:SetTheme(theme)
    for k, v in pairs(theme or {}) do
        if Library.Theme[k] ~= nil then
            Library.Theme[k] = v
        end
    end
end

function Library:Destroy()
    if self._destroyed then return end
    self._destroyed = true

    for _, conn in ipairs(self._connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(self._connections)

    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end
end

Library.Create = Library.new

return Library
