    -- Rolling digits counter (for stats pages)
    function UI.counter(parent, role, color, decimals, suffix)
        role = role or "digits"
        decimals = decimals or 0
        local digitW = 0
        for d = 0, 9 do digitW = math.max(digitW, math.ceil(T.measure(tostring(d), role).X)) end
        local lineH = math.ceil(T.measure("0", role).Y)
        local box = new("Frame", {
            BackgroundTransparency = 1, Size = UDim2.fromOffset(digitW, lineH),
            ZIndex = parent.ZIndex + 1,
        }, parent)
        local cells = {}
        local suffixLbl
        if suffix then
            suffixLbl = text(box, suffix, role == "digits" and "label" or "small", {
                TextColor3 = T.dim, AnchorPoint = Vector2.new(0, 1),
                Size = UDim2.fromOffset(40, lineH), ZIndex = parent.ZIndex + 2,
            })
        end
        local function cell(i)
            local c = cells[i]
            if c then return c end
            local clip = new("Frame", {
                BackgroundTransparency = 1, ClipsDescendants = true,
                Size = UDim2.fromOffset(digitW, lineH), ZIndex = parent.ZIndex + 1,
            }, box)
            local a = text(clip, "0", role, {
                Size = UDim2.fromOffset(digitW, lineH), TextXAlignment = Enum.TextXAlignment.Center,
                TextColor3 = color or T.text, ZIndex = parent.ZIndex + 2,
            })
            local b = a:Clone()
            b.Parent = clip
            c = { clip = clip, a = a, b = b }
            cells[i] = c
            return c
        end
        local scaleMul = 10 ^ decimals
        local function draw(v)
            local n = math.max(0, v * scaleMul)
            local digits = math.max(#tostring(math.floor(n + 1e-6)), decimals + 1)
            local totalW = digits * digitW + (decimals > 0 and math.floor(digitW * 0.45) or 0)
            box.Size = UDim2.fromOffset(totalW + (suffixLbl and 4 or 0), lineH)
            for i = 1, math.max(digits, #cells) do
                local c = cell(i)
                if i > digits then
                    c.clip.Visible = false
                else
                    c.clip.Visible = true
                    local place = 10 ^ (digits - i)
                    local base = math.floor(n / place) % 10
                    local roll
                    if place == 1 then roll = n % 1
                    else roll = math.max(0, (n % place) - (place - 1)) end
                    local x = (i - 1) * digitW
                    if decimals > 0 and i > digits - decimals then x = x + math.floor(digitW * 0.45) end
                    c.clip.Position = UDim2.fromOffset(x, 0)
                    c.a.Text = tostring(base)
                    c.b.Text = tostring((base + 1) % 10)
                    c.a.Position = UDim2.fromOffset(0, -roll * lineH)
                    c.b.Position = UDim2.fromOffset(0, (1 - roll) * lineH)
                    c.a.TextTransparency = roll * 0.9
                    c.b.TextTransparency = (1 - roll) * 0.9
                end
            end
            if suffixLbl then suffixLbl.Position = UDim2.new(0, totalW + 3, 1, 0) end
        end
        local spring = Anim.value(0, "digits", draw)
        draw(0)
        local api = { box = box, lineH = lineH }
        function api.set(v, instant)
            if instant then spring.snap(v) else spring.to(v, "digits") end
        end
        function api.setColor(col)
            for _, cc in pairs(cells) do cc.a.TextColor3 = col cc.b.TextColor3 = col end
        end
        return api
    end
end

------------------------------------------------------------------------
-- Toast: notification deck on the right edge. Kinds: info | warn | kill | head.
------------------------------------------------------------------------
local function buildToast(L)
    local T, Anim, UI = L.T, L.Anim, L.UI
    local new, text = UI.new, UI.text
    local CARD_W = 272; local EDGE = 24; local TOP = 72; local GAP = 8; local MAX = 4
    local LIFE = 4; local SLIDE = 40; local RADIUS = 10; local PAD_Y = 11
    local STRIP_X = 8; local STRIP_W = 3; local TEXT_X = 24; local TEXT_W = CARD_W - TEXT_X - 16
    local LINE_GAP = 2; local MIN_H = 40; local CARD_REST = 0.04; local GONE_AFTER = 0.5
    local KINDS = { kill = true, head = true, info = true, warn = true }
    local GLOW_REST = { kill = 0.74, head = 0.76, warn = 0.8 }
    local function kindColor(kind)
        if kind == "kill" then return T.accent end
        if kind == "head" then return T.warn end
        if kind == "warn" then return T.bad end
        return T.dim
    end
    local live = {}
    local leaving = {}
    local deck = new("Frame", {
        Name = "Toasts", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1,
    }, UI.toastScreen)
    local function slotPos(y) return UDim2.new(1, -EDGE, 0, y) end
    local function restack(token)
        local y = TOP
        for _, t in ipairs(live) do
            local pos = slotPos(y)
            if t.placed then Anim.to(t.holder, "Position", pos, token or "select")
            else Anim.set(t.holder, "Position", pos) t.placed = true end
            y = y + t.h + GAP
        end
    end
    local function fadeTo(t, shown, token)
        Anim.to(t.card, "BackgroundTransparency", shown and CARD_REST or 1, token)
        Anim.to(t.strip, "BackgroundTransparency", shown and 0 or 1, token)
        Anim.to(t.title, "TextTransparency", shown and 0 or 1, token)
        if t.body then Anim.to(t.body, "TextTransparency", shown and 0 or 1, token) end
        if t.shadow then Anim.to(t.shadow, "ImageTransparency", shown and t.shadowRest or 1, token) end
        if t.glow and not shown then Anim.to(t.glow, "ImageTransparency", 1, token) end
    end
    local function dismiss(t)
        if t.leaving then return end
        t.leaving = true
        t.goneAt = os.clock() + GONE_AFTER
        local i = table.find(live, t)
        if i then table.remove(live, i) end
        leaving[#leaving + 1] = t
        t.holder.ZIndex = 5
        Anim.to(t.slider, "Position", UDim2.fromOffset(SLIDE, 0), "toast")
        fadeTo(t, false, "fade")
        restack("select")
    end
    local function pulse(t)
        t.age = 0
        Anim.set(t.card, "BackgroundColor3", T.track)
        Anim.to(t.card, "BackgroundColor3", t.hover and T.raised or T.surface, "light")
        if t.glow then
            Anim.set(t.glow, "ImageTransparency", 0.4)
            Anim.to(t.glow, "ImageTransparency", t.glowRest, "light")
        end
    end
    local function build(req)
        local kind = req.kind
        local titleH = math.max(math.ceil(T.measure(req.title, "label", TEXT_W).Y), 14)
        local bodyH = req.body and math.max(math.ceil(T.measure(req.body, "body", TEXT_W).Y), 12) or 0
        local blockH = titleH + (req.body and (LINE_GAP + bodyH) or 0)
        local h = math.max(PAD_Y * 2 + blockH, MIN_H)
        local y0 = math.floor((h - blockH) / 2)
        local color = kindColor(kind)
        local holder = new("Frame", {
            Name = "Toast", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
            Position = slotPos(TOP), Size = UDim2.fromOffset(CARD_W, h), ZIndex = 10,
        }, deck)
        local slider = new("Frame", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(SLIDE, 0),
            Size = UDim2.fromScale(1, 1), ZIndex = 1,
        }, holder)
        local shadow = UI.shadow(slider, true, false, 1)
        local shadowRest = 0.45
        if shadow then shadowRest = shadow.ImageTransparency shadow.ImageTransparency = 1 end
        local card = new("Frame", {
            Name = "Card", BackgroundColor3 = T.surface, BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 2,
        }, slider)
        UI.corner(card, RADIUS)
        local glowRest = GLOW_REST[kind]
        local glow
        if glowRest and L.sprite.glow then
            glow = new("ImageLabel", {
                BackgroundTransparency = 1, Image = L.sprite.glow, ImageColor3 = color,
                ImageTransparency = 0.4, AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromOffset(STRIP_X + STRIP_W / 2, h / 2),
                Size = UDim2.fromOffset(STRIP_W + 30, h - 20 + 30), ZIndex = 1,
            }, card)
        end
        local strip = new("Frame", {
            BackgroundColor3 = color, BackgroundTransparency = 1,
            Position = UDim2.fromOffset(STRIP_X, 10), Size = UDim2.fromOffset(STRIP_W, h - 20), ZIndex = 2,
        }, card)
        UI.corner(strip, 2)
        local titleLbl = text(card, req.title, "label", {
            Position = UDim2.fromOffset(TEXT_X, y0), Size = UDim2.fromOffset(TEXT_W, titleH),
            TextColor3 = T.text, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
            TextTransparency = 1, ZIndex = 3,
        })
        local bodyLbl
        if req.body then
            bodyLbl = text(card, req.body, "body", {
                Position = UDim2.fromOffset(TEXT_X, y0 + titleH + LINE_GAP), Size = UDim2.fromOffset(TEXT_W, bodyH),
                TextColor3 = T.dim, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
                TextTransparency = 1, ZIndex = 3,
            })
        end
        local t = {
            kind = kind, titleText = req.title, bodyText = req.body,
            holder = holder, slider = slider, card = card, strip = strip,
            title = titleLbl, body = bodyLbl, shadow = shadow, shadowRest = shadowRest,
            glow = glow, glowRest = glowRest,
            h = h, age = 0, hover = false, placed = false, leaving = false,
        }
        UI.hoverable(card, {
            enter = function() t.hover = true if not t.leaving then Anim.to(card, "BackgroundColor3", T.raised, "hover") end end,
            leave = function() t.hover = false Anim.to(card, "BackgroundColor3", T.surface, "hover") end,
        })
        table.insert(live, 1, t)
        restack("select")
        Anim.to(slider, "Position", UDim2.fromOffset(0, 0), "toast")
        fadeTo(t, true, "toast")
        if glow then Anim.to(glow, "ImageTransparency", glowRest, "light") end
        while #live > MAX do dismiss(live[#live]) end
    end
    local queue, working = {}, false
    local function drain()
        while L.alive and #queue > 0 do
            local req = table.remove(queue, 1)
            L.try("toast build", build, req)
        end
        working = false
    end
    local function sameCard(t, title, body, kind)
        return t ~= nil and t.kind == kind and t.titleText == title and t.bodyText == body
    end
    local function sameRequest(r, title, body, kind)
        return r ~= nil and r.kind == kind and r.title == title and r.body == body
    end
    function L.toast(title, body, kind)
        if not L.alive then return end
        title = string.sub(tostring(title or ""), 1, 120)
        if title == "" then return end
        if body ~= nil then
            body = string.sub(tostring(body), 1, 240)
            if body == "" then body = nil end
        end
        if not KINDS[kind] then kind = "info" end
        local newest = live[1]
        if newest and not newest.leaving and #queue == 0 and sameCard(newest, title, body, kind) then
            pulse(newest); return
        end
        if sameRequest(queue[#queue], title, body, kind) then return end
        queue[#queue + 1] = { title = title, body = body, kind = kind }
        if not working then working = true task.spawn(drain) end
    end
    function L.notify(msg) L.toast(msg, nil, "info") end
    local function anyHover()
        for _, t in ipairs(live) do if t.hover then return true end end
        return false
    end
    local function step(dt)
        if #live == 0 and #leaving == 0 then return end
        dt = math.min(type(dt) == "number" and dt or 0, 0.1)
        if not anyHover() then for _, t in ipairs(live) do t.age = t.age + dt end end
        for i = #live, 1, -1 do
            local t = live[i]
            if t and t.age >= LIFE then dismiss(t) end
        end
        local now = os.clock()
        for i = #leaving, 1, -1 do
            local t = leaving[i]
            if now >= t.goneAt then table.remove(leaving, i) t.holder:Destroy() end
        end
    end
    L.connect(L.RunService.Heartbeat, function(dt)
        local ok, err = pcall(step, dt)
        if not ok then L.fault("toast step", err) end
    end)
    L.connect(L.UIS.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not UI.clickable then return end
        local ok, err = pcall(function()
            local m = UI.mouse()
            for _, t in ipairs(live) do
                if UI.inside(t.card, m) then dismiss(t) return end
            end
        end)
        if not ok then L.fault("toast click", err) end
    end)
    L.on("accent", function(color)
        local c = typeof(color) == "Color3" and color or T.accent
        for _, list in ipairs({ live, leaving }) do
            for _, t in ipairs(list) do
                if t.kind == "kill" then
                    Anim.to(t.strip, "BackgroundColor3", c, "fade")
                    if t.glow then Anim.to(t.glow, "ImageColor3", c, "fade") end
                end
            end
        end
    end)
end

------------------------------------------------------------------------
-- Pill: panel visibility, the minimised pill, and the toggle key.
------------------------------------------------------------------------
local function buildPill(L)
    local T, Anim, UI = L.T, L.Anim, L.UI
    local UIS = L.UIS
    local new, text = UI.new, UI.text
    local holder, scaleObj = UI.holder, UI.scaleObj
    local opts = L.opts
    local NUDGE = 12; local SETTLE = 0.6; local HIDE_AFTER = 0.22
    local function restingScale()
        local cam = workspace.CurrentCamera
        local vy = cam and cam.ViewportSize.Y or 1080
        local touchMul = (UIS.TouchEnabled and 0.95 or 1)
        return math.clamp(vy / 1080, 0.6, 1.4) * math.clamp(opts.Scale or 1, 0.5, 1.4) * touchMul
    end
    local function lowered(p)
        return UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + NUDGE)
    end
    local isOpen = UI.panelOpen ~= false
    UI.panelOpen = isOpen
    local restPos = nil
    local settleUntil = 0
    local openGen = 0
    local function restSpot()
        if restPos and (not isOpen or os.clock() < settleUntil) then return restPos end
        return holder.Position
    end
    local function showWindow()
        if isOpen then return end
        if UI.cancelDrag then UI.cancelDrag() end
        local rest = restSpot()
        restPos = rest
        isOpen = true
        UI.panelOpen = true
        openGen = openGen + 1
        settleUntil = os.clock() + SETTLE
        local s = restingScale()
        if not holder.Visible then
            Anim.set(scaleObj, "Scale", s * 0.94)
            Anim.set(holder, "Position", lowered(rest))
            holder.Visible = true
        end
        Anim.to(scaleObj, "Scale", s, "panel")
        Anim.to(holder, "Position", rest, "panel")
        UI.syncInteract()
    end
    local function hideWindow(quiet, instant)
        if not isOpen then return end
        if UI.cancelDrag then UI.cancelDrag() end
        restPos = restSpot()
        isOpen = false
        UI.panelOpen = false
        settleUntil = 0
        openGen = openGen + 1
        local s = restingScale() * 0.94
        if instant then
            Anim.set(scaleObj, "Scale", s)
            Anim.set(holder, "Position", lowered(restPos))
            holder.Visible = false
        else
            local gen = openGen
            Anim.to(scaleObj, "Scale", s, "collapse")
            Anim.to(holder, "Position", lowered(restPos), "collapse")
            task.delay(HIDE_AFTER, function()
                if L.alive and gen == openGen and not isOpen then holder.Visible = false end
            end)
        end
    end
    UI.setOpen = function(v) if v then showWindow() else hideWindow() end end
    UI.toggleOpen = function() if isOpen then hideWindow() else showWindow() end end

    -- minimised pill
    local pill
    local minimised = false
    local function buildPill()
        if pill then return end
        local pw = math.max(120, T.measure(opts.Title or "UI", "small").X + 56)
        pill = new("Frame", {
            Name = "Pill", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0),
            Position = UDim2.fromOffset(24, 24), Size = UDim2.fromOffset(pw, 34),
            Visible = false, ZIndex = 10,
        }, UI.panelScreen)
        UI.shadow(pill, true, false, 9)
        local card = new("Frame", {
            BackgroundColor3 = T.base, Size = UDim2.fromScale(1, 1), ZIndex = 10,
        }, pill)
        UI.corner(card, T.radius.pill)
        UI.rim(card, 11, 0.2)
        local dot = new("Frame", {
            BackgroundColor3 = T.accent, Size = UDim2.fromOffset(8, 8),
            Position = UDim2.fromOffset(14, 13), Rotation = 45, ZIndex = 12,
        }, card)
        UI.corner(dot, 2)
        UI.accent(dot, "BackgroundColor3")
        text(card, opts.Title or "UI", "small", {
            Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -44, 1, 0),
            TextColor3 = T.text, ZIndex = 12,
        })
        local btn = new("TextButton", {
            BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
            Size = UDim2.fromScale(1, 1), ZIndex = 13,
        }, card)
        UI.hoverable(btn, {
            enter = function() Anim.to(card, "BackgroundColor3", T.surface, "hover") end,
            leave = function() Anim.to(card, "BackgroundColor3", T.base, "hover") end,
        })
        btn.Activated:Connect(function()
            if UI.clickable then UI.setMinimised(false) end
        end)
        -- pill drag
        local pdrag
        btn.InputBegan:Connect(function(input)
            local iut = input.UserInputType
            if (iut ~= Enum.UserInputType.MouseButton1 and iut ~= Enum.UserInputType.Touch) or not UI.clickable then return end
            pdrag = { start = UI.mouse(), origin = pill.Position }
        end)
        L.connect(UIS.InputChanged, function(input)
            if not pdrag then return end
            local iut = input.UserInputType
            if iut ~= Enum.UserInputType.MouseMovement and iut ~= Enum.UserInputType.Touch then return end
            local d = UI.mouse() - pdrag.start
            local o = pdrag.origin
            Anim.to(pill, "Position", UDim2.new(o.X.Scale, o.X.Offset + d.X, o.Y.Scale, o.Y.Offset + d.Y), "follow")
        end)
        L.connect(UIS.InputEnded, function(input)
            local iut = input.UserInputType
            if pdrag and (iut == Enum.UserInputType.MouseButton1 or iut == Enum.UserInputType.Touch) then pdrag = nil end
        end)
    end
    function UI.setMinimised(v)
        minimised = v == true
        if v then
            buildPill()
            hideWindow(false, false)
            if pill then
                pill.Visible = true
                Anim.set(pill, "BackgroundTransparency", 1)
                Anim.to(pill, "Position", UDim2.fromOffset(24, 24), "panel")
            end
        else
            if pill then pill.Visible = false end
            showWindow()
        end
    end

    -- toggle key
    local toggleKey = opts.ToggleKey
    if toggleKey and toggleKey ~= "None" and toggleKey ~= "" then
        local ok, keyCode = pcall(function() return Enum.KeyCode[toggleKey] end)
        if ok and keyCode then
            L.connect(UIS.InputBegan, function(input, gpe)
                if input.KeyCode == keyCode and not gpe then
                    if minimised then UI.setMinimised(false) else UI.toggleOpen() end
                end
            end)
        end
    end

    L.onUnload(function() hideWindow(true, true) end)
end

------------------------------------------------------------------------
-- Config persistence (optional). Saves every control's value by id.
------------------------------------------------------------------------
local function buildConfig(L)
    local X = L.X
    local opts = L.opts
    local file = opts.ConfigFile
    if not file or not (X.writefile and X.readfile and X.isfile and L.HttpService) then
        L.SaveConfig = function() end; L.LoadConfig = function() end; L._attachAutosave = function() end
        return
    end
    local function serialize()
        local out = {}
        for _, c in ipairs(L.UI.controls) do
            if c.id ~= nil and c.value ~= nil then
                out[tostring(c.id)] = c.value
            end
        end
        return L.HttpService:JSONEncode(out)
    end
    function L.SaveConfig()
        L.try("save config", function() X.writefile(file, serialize()) end)
    end
    function L.LoadConfig()
        local ok, exists = pcall(X.isfile, file)
        if not (ok and exists) then return end
        local ok2, txt = pcall(X.readfile, file)
        if not ok2 or type(txt) ~= "string" or #txt == 0 then return end
        local ok3, data = pcall(function() return L.HttpService:JSONDecode(txt) end)
        if not ok3 or type(data) ~= "table" then return end
        for _, c in ipairs(L.UI.controls) do
            local v = data[tostring(c.id)]
            if v ~= nil and type(v) == type(c.value) and type(c.Set) == "function" then
                pcall(function() c:Set(v) end)
            end
        end
    end
    -- debounced autosave: attached after the caller finishes building controls
    function L._attachAutosave()
        if opts.AutoSave == false then return end
        local pending = false
        for _, c in ipairs(L.UI.controls) do
            c:OnChange(function()
                if pending then return end
                pending = true
                task.delay(1, function()
                    pending = false
                    if L.alive then L.SaveConfig() end
                end)
            end)
        end
    end
end

------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------
function EntrenchedUI.new(opts)
    opts = opts or {}
    local L = newState(opts)
    buildTheme(L)
    buildMotion(L)
    buildSprites(L)
    local UI = buildCore(L)
    buildControls(L)
    buildToast(L)
    buildPill(L)

    local T = L.T
    local self = setmetatable({}, EntrenchedUI)
    self._L = L
    self.Accents = T.ACCENTS  -- list of {name, color} for Swatches

    -- Tab API
    function self:Tab(name, iconName)
        local tab = UI.addTab(name, iconName)
        local tabApi = {}
        function tabApi:Section(title, subtitle)
            local secId = (tab.name or "tab") .. "." .. title
            local sec = UI.section(tab.page, title, subtitle, secId)
            local secApi = { _sec = sec, _secId = secId }
            local function cid(label) return secId .. "." .. label end
            function secApi:Toggle(label, default, callback, desc)
                return UI.toggle(sec, label, cid(label), default, desc, callback)
            end
            function secApi:Slider(label, min, max, default, step, suffix, callback, desc)
                return UI.slider(sec, label, cid(label), min, max, default, step, suffix, desc, callback)
            end
            function secApi:Dropdown(label, options, default, callback, desc)
                return UI.segmented(sec, label, cid(label), options, default, desc, callback)
            end
            function secApi:Swatches(label, list, default, callback, desc)
                return UI.swatches(sec, label, cid(label), list, default, desc, callback)
            end
            function secApi:Keybind(label, default, callback, desc)
                return UI.keybind(sec, label, cid(label), default, desc, callback)
            end
            function secApi:Button(label, caption, onClick, desc, danger)
                return UI.button(sec, label, caption, onClick, desc, danger)
            end
            function secApi:Note(str)
                return UI.note(sec, str)
            end
            return secApi
        end
        return tabApi
    end

    function self:Toast(title, body, kind) L.toast(title, body, kind) end
    function self:Notify(msg) L.notify(msg) end
    function self:SetAccent(nameOrColor) UI.setAccent(nameOrColor) end
    function self:Show() UI.setOpen(true) end
    function self:Hide() UI.setOpen(false) end
    function self:Toggle() UI.toggleOpen() end
    function self:Minimize() UI.setMinimised(true) end
    function self:Restore() UI.setMinimised(false) end
    function self:SetScale(s) opts.Scale = math.clamp(tonumber(s) or 1, 0.5, 1.4) UI.rescale() end
    function self:SetFontScale(s) UI.setFontScale(s) end
    function self:SaveConfig() L.SaveConfig() end
    function self:LoadConfig() L.LoadConfig() end
    function self:Destroy() L.unload("destroy") end
    function self:SelectTab(name) UI.select(name) end

    -- finish: place window. First-tab select, autosave hooks and config load
    -- run deferred: the caller adds all tabs/controls synchronously right after
    -- this constructor returns, so a deferred frame sees the complete UI.
    UI.placeInitial()
    buildConfig(L)
    task.defer(function()
        if not L.alive then return end
        if #UI.tabs > 0 and not UI.current then UI.select(UI.tabs[1].name, true) end
        if L._attachAutosave then L._attachAutosave() end
        L.LoadConfig()
    end)
    task.delay(0.7, function()
        if L.alive and L.toast then
            local key = opts.ToggleKey
            local keyText = (not key or key == "None" or key == "") and "" or ("  " .. tostring(key) .. " shows or hides the panel.")
            local altText = opts.AltCursor ~= false and "When the cursor is locked, hold Left Alt to click." or ""
            L.toast((opts.Title or "UI") .. " is ready", altText .. keyText, "info")
        end
    end)
    return self
end

return EntrenchedUI
