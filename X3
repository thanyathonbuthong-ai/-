-- Scale the complete UI down automatically on phones.
local uiScale = Instance.new("UIScale")
uiScale.Scale = 1
uiScale.Parent = frame

local function updateUIScale()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    -- Leave a small margin around the window.
    local scaleX = (viewport.X - 24) / fullWidth
    local scaleY = (viewport.Y - 24) / fullHeight
    local targetScale = math.min(1, scaleX, scaleY)

    -- Avoid making the controls unusably tiny on unusual resolutions.
    targetScale = math.max(0.62, targetScale)
    uiScale.Scale = targetScale
end

updateUIScale()

local camera = workspace.CurrentCamera
if camera then
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateUIScale)
end

