​local Visibility = {}
Visibility.__index = Visibility
function Visibility.new(guiObj)
local bindable = Instance.new("BindableEvent")
local self = setmetatable({
GuiObject = guiObj, Visible = nil, Changed = bindable.Event,
_path = {}, _conn = {}, _root = nil, _visibleChanged = bindable
}, Visibility)
local function check()
local visible = (self._root and self._root.Enabled or false)
if visible then
for _, obj in ipairs(self._path) do
if not obj.Visible then visible = false break end
end
end
if visible ~= self.Visible then
self.Visible = visible
bindable:Fire(visible)
end
end
local function buildPath()
for _, c in ipairs(self._conn) do c:Disconnect() end
local path, conns, root = {}, {}, nil
local cur = guiObj
while cur and (cur:IsA("GuiObject") or cur:IsA("Folder")) do
if cur:IsA("GuiObject") then
table.insert(conns, cur:GetPropertyChangedSignal("Visible"):Connect(check))
table.insert(path, cur)
end
cur = cur.Parent
end
if cur and cur:IsA("LayerCollector") then
table.insert(conns, cur:GetPropertyChangedSignal("Enabled"):Connect(check))
root = cur
end
self._path, self._conn, self._root = path, conns, root
check()
end
self._ancestry = guiObj.AncestryChanged:Connect(buildPath)
buildPath()
return self
end
function Visibility.Destroy(self)
self._visibleChanged:Fire(false)
self._visibleChanged:Destroy()
self._ancestry:Disconnect()
for _, c in ipairs(self._conn) do c:Disconnect() end
end
