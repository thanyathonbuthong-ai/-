​local function scoreMatch(text, query)
text = text:lower()
local score = 0
if text == query then return 100 end
local words = {}
for w in query:gmatch("%S+") do table.insert(words, w) end
if #words > 1 then
for _, w in ipairs(words) do
if not text:find(w, 1, true) then return 0 end
score += 1
end
if text:find(query, 1, true) then score += 3 end
score -= #text / 20
return score
end
local pos = text:find(query, 1, true)
if not pos then return 0 end
score += 1
if pos == 1 then score += 4 end
for word in text:gmatch("%S+") do
if word:sub(1, #query) == query then score += 3 break end
if word == query then score += 5 break end
end
score -= #text / 20
return score
end
​local function search(query)
query = query:lower()
local bestScore, bestIdx = 0, nil
for idx, tab in pairs(Tabs) do
local tabScore = 0
for _, feature in pairs(tab.Features) do
tabScore += scoreMatch(feature, query)
end
tab.Frame.Visible = tabScore > 0
if tabScore > bestScore then
bestScore = tabScore
bestIdx = idx
end
end
if bestIdx then WindowAPI:SelectTab(bestIdx) end
end
