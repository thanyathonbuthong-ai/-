​local API = {}
function API.Enable(frame, sens, frict, inverted, axis)
if not UIS.MouseEnabled or UIS.TouchEnabled then return end
if typeof(frame) ~= "Instance" or frame.ClassName ~= "ScrollingFrame" then return end
if not scrollData[frame] then
frame.ScrollingEnabled = false
local actives, conns = {}, {}
for _, desc in ipairs(frame:GetDescendants()) do
if desc:IsA("GuiObject") then
actives[desc] = desc.Active
desc.Active = false
table.insert(conns, desc:GetPropertyChangedSignal("Active"):Connect(function() desc.Active = false end))
end
end
local cur = frame
while cur and (cur:IsA("GuiObject") or cur:IsA("Folder")) do
if cur:IsA("GuiObject") then
actives[cur] = cur.Active
cur.Active = false
table.insert(conns, cur:GetPropertyChangedSignal("Active"):Connect(function() cur.Active = false end))
end
cur = cur.Parent
end
table.insert(conns, frame.DescendantAdded:Connect(function(desc)
if desc:IsA("GuiObject") then
scrollData[frame].Actives[desc] = desc.Active
desc.Active = false
table.insert(scrollData[frame].Connections, desc:GetPropertyChangedSignal("Active"):Connect(function() desc.Active = false end))
end
end))
if not (axis == "X" or axis == "Y") then
axis = (frame.CanvasSize.Y.Offset > 0 or frame.CanvasSize.Y.Scale > 0) and "Y" or "X"
if frame.CanvasSize.Y.Offset == 0 and frame.CanvasSize.Y.Scale == 0 and frame.CanvasSize.X.Offset == 0 and frame.CanvasSize.X.Scale == 0 then axis = "Y" end
end
scrollData[frame] = {
Connections = conns, Actives = actives, Velocity = 0, LastPos = 0,
Visibility = Visibility.new(frame),
Inverted = inverted, Axis = axis,
Frict = math.clamp(type(frict) == "number" and frict or 0.78, 0.2, 0.99),
Sens = math.clamp(type(sens) == "number" and sens or (mouse.ViewSizeY / 27), 0.01, 1e16)
}
CreateBar(frame, "X")
CreateBar(frame, "Y")
else
scrollData[frame].Sens = math.clamp(type(sens) == "number" and sens or (mouse.ViewSizeY / 27), 0.01, 1e16)
scrollData[frame].Frict = math.clamp(type(frict) == "number" and frict or 0.78, 0.2, 0.99)
scrollData[frame].Inverted = inverted
end
end
function API.Disable(frame)
if scrollData[frame] then
frame.ScrollingEnabled = true
for _, c in ipairs(scrollData[frame].Connections) do c:Disconnect() end
scrollData[frame].Visibility:Destroy()
for obj, active in pairs(scrollData[frame].Actives) do obj.Active = active end
scrollData[frame] = nil
end
end
return API
end)()
