function Library:Notification(opts)
    opts = opts or {}
    local text     = opts.Text or "Notification"
    local duration = opts.Duration or 5

    local bounds = TextService:GetTextSize(
        text,
        Library.Config.FontSize,
        UI_FONT,
        Vector2.new(500, 100)
    )
    local padLeft  = 12
    local padRight = 12
    local accentW  = 2
    local width  = math.clamp(math.ceil(bounds.X) + padLeft + padRight + accentW + 8, 80, 320)
    local height = 22

    local Row = Instance.new("Frame")
    Row.Name = "NotifRow"
    Row.Size = UDim2.new(1, 0, 0, height)
    Row.BackgroundTransparency = 1
    Row.ZIndex = 1000
    Row.Parent = NotifHolder

    local Holder = Instance.new("Frame")
    Holder.Name = "Notif"
    Holder.AnchorPoint = Vector2.new(1, 0)
    Holder.Position = UDim2.new(1, width + 24, 0, 0)
    Holder.Size = UDim2.fromOffset(width, height)
    Holder.BackgroundColor3 = Library.Theme.DarkBackground
    Holder.BorderSizePixel = 0
    Holder.ClipsDescendants = false
    Holder.ZIndex = 1000
    Holder.Parent = Row

    AddOutline(Holder)
    AddInlineOutline(Holder)

    local Accent = Instance.new("Frame")
    Accent.Size = UDim2.new(0, accentW, 1, 0)
    Accent.BackgroundColor3 = Library.Theme.Accent
    Accent.BorderSizePixel = 0
    Accent.ZIndex = 1002
    Accent.Parent = Holder

    local TLabel = Instance.new("TextLabel")
    TLabel.Text = text
    TLabel.Size = UDim2.new(1, -(accentW + padLeft + padRight), 1, 0)
    TLabel.Position = UDim2.new(0, accentW + padLeft, 0, 0)
    TLabel.BackgroundTransparency = 1
    TLabel.Font = UI_FONT
    TLabel.TextColor3 = Library.Theme.Text
    TLabel.TextSize = Library.Config.FontSize
    TLabel.TextXAlignment = Enum.TextXAlignment.Left
    TLabel.TextYAlignment = Enum.TextYAlignment.Center
    TLabel.TextStrokeTransparency = 0
    TLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TLabel.ZIndex = 1003
    TLabel.Parent = Holder

    TweenService:Create(
        Holder,
        TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Position = UDim2.new(1, 0, 0, 0) }
    ):Play()

    task.delay(duration, function()
        if not Row or not Row.Parent then return end
        local outTween = TweenService:Create(
            Holder,
            TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            { Position = UDim2.new(1, width + 24, 0, 0) }
        )
        outTween:Play()
        outTween.Completed:Connect(function()
            if Row and Row.Parent then Row:Destroy() end
        end)
    end)
end

local function Create(class, props, children)
    local inst = Instance.new(class)
    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        inst.Font = UI_FONT
        inst.TextSize = Library.Config.FontSize
    end
    for k, v in pairs(props or {}) do
        if k == "Parent" then
        else inst[k] = v end
    end
    if props and props.Parent then inst.Parent = props.Parent end
    for _, c in pairs(children or {}) do c.Parent = inst end
    return inst
end

