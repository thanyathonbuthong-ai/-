                    end
                    return list
                end

                local function FormatDisplay()
                    local list = GetSelectedList()
                    if #list == 0 then return "None" end
                    if #list <= 2 then return table.concat(list, ", ") end
                    return list[1] .. ", " .. list[2] .. " (+" .. (#list - 2) .. ")"
