function Library:SetConfigFolder(name)
    name = tostring(name or "lunex")
    name = name:gsub("[^%w_%-%. ]", ""):gsub("%s+", "_")
    name = name:gsub("[/\\]+$", "")
    if name == "" then name = "lunex" end
    self.Config.ConfigFolder = name
    pcall(function()
        if not isfolder(name) then makefolder(name) end
    end)
end

function Library:GetConfigFolder()
    return self.Config.ConfigFolder or "lunex"
end

function Library:GetConfigPath()
    local folder = self:GetConfigFolder():gsub("[/\\]+$", "")
    return folder .. "/"
end

local function SerializeValue(v)
    local t = typeof(v)
    if t == "boolean" then
        return "b:" .. tostring(v)
    elseif t == "number" then
        return "n:" .. tostring(v)
    elseif t == "string" then
        return "s:" .. v
    elseif t == "Color3" then
        return string.format("c:%d,%d,%d",
            math.floor(v.R * 255 + 0.5),
            math.floor(v.G * 255 + 0.5),
            math.floor(v.B * 255 + 0.5))
    elseif t == "table" then
        local parts = {}
        for _, item in ipairs(v) do parts[#parts + 1] = tostring(item) end
        return "t:" .. table.concat(parts, "|")
    end
    return "s:" .. tostring(v)
end

local function DeserializeValue(s)
    if type(s) ~= "string" then return nil end
    local prefix = s:sub(1, 2)
    local body = s:sub(3)
    if prefix == "b:" then
        return body == "true"
    elseif prefix == "n:" then
        return tonumber(body) or 0
    elseif prefix == "s:" then
        return body
    elseif prefix == "c:" then
        local r, g, b = body:match("(%d+),(%d+),(%d+)")
        if r and g and b then
            return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
        end
        return Color3.new()
    elseif prefix == "t:" then
        local list = {}
        for part in body:gmatch("([^|]*)") do
            if part ~= "" then list[#list + 1] = part end
        end
        return list
    end
    return s
end

function Library:WriteConfigFile(name, data)
    local path = self:GetConfigPath() .. tostring(name) .. ".cfg"
    local lines = {}
    lines[#lines + 1] = "# Lunex configuration"
    lines[#lines + 1] = "# Name: " .. tostring(name)
    lines[#lines + 1] = "# Saved: " .. os.date("%Y-%m-%d %H:%M:%S")
    lines[#lines + 1] = ""
    lines[#lines + 1] = "[Theme]"
    for k, v in pairs(data.Theme or {}) do
        lines[#lines + 1] = k .. " = " .. SerializeValue(v)
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "[Flags]"
    for k, v in pairs(data.Flags or {}) do
        if v ~= nil then
            lines[#lines + 1] = k .. " = " .. SerializeValue(v)
        end
    end
    local ok, err = pcall(function()
        writefile(path, table.concat(lines, "\n"))
    end)
    if not ok then warn("[Lunex] WriteConfigFile failed: " .. tostring(err)) end
    return ok
end

function Library:ReadConfigFile(name)
    local path = self:GetConfigPath() .. tostring(name) .. ".cfg"
    local content
    local ok, err = pcall(function() content = readfile(path) end)
    if not ok or not content then
        warn("[Lunex] ReadConfigFile failed: " .. tostring(err))
        return nil
    end

    local data = { Theme = {}, Flags = {} }
    local section = nil
    for line in content:gmatch("[^\r\n]+") do
        local trimmed = line:match("^%s*(.-)%s*$")
        if trimmed ~= "" and not trimmed:match("^#") then
            local secName = trimmed:match("^%[(.+)%]$")
            if secName then
                section = secName
            else
                local key, val = trimmed:match("^(.-)%s*=%s*(.*)$")
                if key and val and section and (section == "Theme" or section == "Flags") then
                    data[section][key] = DeserializeValue(val)
                end
            end
        end
    end
    return data
end

function Library:RegisterPopup(fn)  table.insert(self.OpenPopups, fn) end
function Library:CloseAllPopups()
    local snap = {}
    for i, fn in ipairs(self.OpenPopups) do snap[i] = fn end
    for _, fn in ipairs(snap) do pcall(fn) end
end

Library.CurrentDropdown = nil

function Library:SetCurrentDropdown(closer)
    if self.CurrentDropdown and self.CurrentDropdown ~= closer then
        local prev = self.CurrentDropdown
        self.CurrentDropdown = nil
        pcall(prev)
    end
    self.CurrentDropdown = closer
end

function Library:ClearCurrentDropdown(closer)
    if not closer or self.CurrentDropdown == closer then
        self.CurrentDropdown = nil
    end
end

function Library:UpdateTheme()
    for _, win in pairs(Library.Elements.Windows) do
        win.Main.BackgroundColor3     = Library.Theme.DarkBackground
        win.TitleBar.BackgroundColor3 = Library.Theme.Background
        win.Content.BackgroundColor3  = Library.Theme.Background
        win.AccentLine.BackgroundColor3 = Library.Theme.Accent
        if win.BottomBar then
            win.BottomBar.BackgroundColor3 = Library.Theme.Background
        end
    end
    for _, sec in pairs(Library.Elements.Sections) do
        sec.Frame.BackgroundColor3 = Library.Theme.DarkBackground
        sec.Header.TextColor3      = Library.Theme.Text
    end
    for _, hdr in pairs(Library.Elements.SectionHeaders) do hdr.BackgroundColor3 = Library.Theme.HeaderBar end
    for _, acc in pairs(Library.Elements.SectionAccents) do acc.BackgroundColor3 = Library.Theme.Accent end
    for _, tog in pairs(Library.Elements.Toggles) do
        tog.Box.BackgroundColor3 = tog.GetState() and Library.Theme.Accent or Library.Theme.SectionBackground
        tog.Label.TextColor3     = tog.GetState() and Library.Theme.Text or Library.Theme.InactiveText
    end
    for _, sli in pairs(Library.Elements.Sliders) do
        sli.Fill.BackgroundColor3 = Library.Theme.Accent
        sli.Label.TextColor3 = Library.Theme.Text
        sli.Value.TextColor3 = Library.Theme.Text
        if sli.Back then sli.Back.BackgroundColor3 = Library.Theme.SectionBackground end
    end
    for _, drop in pairs(Library.Elements.Dropdowns) do
        if drop.Container then drop.Container.BackgroundColor3 = Library.Theme.DarkBackground end
        if drop.Box then drop.Box.BackgroundColor3 = Library.Theme.SectionBackground end
        if drop.ValueLabel then drop.ValueLabel.TextColor3 = Library.Theme.Text end
        if drop.Arrow then drop.Arrow.TextColor3 = Library.Theme.Text end
    end
    for _, md in pairs(Library.Elements.MultiDropdowns) do
        if md.Container and md.Container.Parent then md.Container.BackgroundColor3 = Library.Theme.DarkBackground end
        if md.Box and md.Box.Parent then md.Box.BackgroundColor3 = Library.Theme.SectionBackground end
        if md.ValueLabel and md.ValueLabel.Parent then md.ValueLabel.TextColor3 = Library.Theme.Text end
        if md.Arrow and md.Arrow.Parent then md.Arrow.TextColor3 = Library.Theme.Text end
    end
    for _, cp in pairs(Library.Elements.ColorPickers) do
        cp.Frame.BackgroundColor3 = Library.Theme.SectionBackground
        if cp.Picker then cp.Picker.BackgroundColor3 = Library.Theme.DarkBackground end
    end
    for _, tab in pairs(Library.Elements.Tabs) do
        tab.Accent.BackgroundColor3 = Library.Theme.Accent
        Tween(tab.Button, {TextColor3 = tab.IsActive() and Library.Theme.Text or Library.Theme.InactiveText})
    end
    for _, lab in pairs(Library.Elements.Labels) do lab.TextColor3 = Library.Theme.Text end
    for _, btn in pairs(Library.Elements.Buttons) do btn.BackgroundColor3 = Library.Theme.SectionBackground end
    for _, txt in pairs(Library.Elements.TextBoxes) do
        txt.Box.BackgroundColor3 = Library.Theme.SectionBackground
        txt.Input.TextColor3     = Library.Theme.Text
    end
    for _, out in pairs(Library.Elements.Outlines) do out.Color = Library.Theme.Outline end
    for _, inl in pairs(Library.Elements.Inlines)  do inl.Color = Library.Theme.Inline  end
    for _, div in pairs(Library.Elements.Dividers) do
        if div.Parent then div.BackgroundColor3 = Library.Theme.Inline end
    end

    for _, scroll in pairs(Library.Elements.TabScrolls) do
        if scroll and scroll.Parent then
            scroll.ScrollBarImageColor3 = Library.Theme.Accent
        end
    end

    for _, btn in pairs(Library.Elements.ToggleBtns) do
        if btn.Parent then btn.BackgroundColor3 = Library.Theme.Background end
    end
    for _, stripe in pairs(Library.Elements.ToggleBtnStripes) do
        if stripe.Parent then stripe.BackgroundColor3 = Library.Theme.Accent end
    end
    for _, lbl in pairs(Library.Elements.ToggleBtnLabels) do
        if lbl.Parent then lbl.TextColor3 = Library.Theme.Text end
    end

    for _, kb in pairs(Library.Elements.KeybindBoxes) do
        if kb.Outer and kb.Outer.Parent then
            kb.Outer.BackgroundColor3 = Library.Theme.Outline
        end
        if kb.Inner and kb.Inner.Parent then
            kb.Inner.BackgroundColor3 = Library.Theme.DarkBackground
        end
        if kb.Stroke and kb.Stroke.Parent then
            kb.Stroke.Color = Library.Theme.Inline
        end
    end

    for _, wm in pairs(Library.Elements.Watermarks) do
        if wm.Parent then wm.BackgroundColor3 = Library.Theme.Background end
    end
    for _, acc in pairs(Library.Elements.WatermarkAccents) do
        if acc.Parent then acc.BackgroundColor3 = Library.Theme.Accent end
    end
    for _, lbl in pairs(Library.Elements.WatermarkLabels) do
        if lbl.Parent then lbl.TextColor3 = Library.Theme.Text end
    end

    local accentHex = ColorToHex(Library.Theme.Accent)
    local playerName = (Players.LocalPlayer and Players.LocalPlayer.Name) or "Player"
    for _, lbl in pairs(Library.Elements.BottomBarWelcomes) do
        if lbl.Parent then
            lbl.TextColor3 = Library.Theme.Text
            lbl.Text = string.format('Welcome <font color="%s">%s</font>', accentHex, playerName)
        end
    end
    for _, lbl in pairs(Library.Elements.BottomBarGames) do
        if lbl.Parent then
            lbl.TextColor3 = Library.Theme.Accent
        end
    end

    for _, ps  in pairs(Library.Elements.PlayerListScrolls)    do ps.ScrollBarImageColor3 = Library.Theme.Accent end
    for _, pd  in pairs(Library.Elements.PlayerListDetails)    do pd.BackgroundColor3     = Library.Theme.Background end
    for _, pt  in pairs(Library.Elements.PlayerListThumbs)     do pt.BackgroundColor3     = Library.Theme.SectionBackground end
    for _, pdv in pairs(Library.Elements.PlayerListDividers)   do pdv.BackgroundColor3    = Library.Theme.Inline end
    for _, pil in pairs(Library.Elements.PlayerListInfoLabels) do pil.TextColor3          = Library.Theme.Text end
    for _, pr in pairs(Library.Elements.PlayerListRows) do
        if pr.IsLocal then
            pr.Name.TextColor3   = Library.Theme.Text
            pr.Status.TextColor3 = Library.Theme.Accent
        else
            pr.Name.TextColor3   = Library.Theme.Text
            pr.Status.TextColor3 = Library.Theme.InactiveText
        end
    end
    for _, pb in pairs(Library.Elements.PlayerListActionBtns) do
        pb.Btn.BackgroundColor3 = pb.IsActive() and Library.Theme.Accent or Library.Theme.SectionBackground
    end
end

