                local pickerConn
                local function UpdatePos() local pos = CPHolder.AbsolutePosition; Picker.Position = UDim2.new(0, pos.X + 25, 0, pos.Y) end
                local function ClosePicker()
                    Picker.Visible = false
                    if pickerConn then pickerConn:Disconnect(); pickerConn = nil end
                end
                Library:RegisterPopup(ClosePicker)
                CPBtn.MouseButton1Click:Connect(function()
                    if Picker.Visible then ClosePicker() else
                        UpdatePos()
                        Picker.Visible = true
                        pickerConn = UIS.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                if not IsWithin(Picker, input) and not IsWithin(CPHolder, input) then ClosePicker() end
                            end
                        end)
                    end
                end)

                local function tweenMarker(marker, targetPos)
                    Tween(marker, { Position = targetPos }, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                end

                local function Set(col)
                    h, s, v = col:ToHSV()
                    Tween(CPHolder, { BackgroundColor3 = col }, 0.15)
                    Tween(SVBox, { BackgroundColor3 = Color3.fromHSV(h, 1, 1) }, 0.15)
                    tweenMarker(Marker, UDim2.new(s, -2, 1 - v, -2))
                    tweenMarker(HueMarker, UDim2.new(0, -2, h, 0))
                    if copts.Callback then copts.Callback(col) end
                end
                local CPObj = { Set = Set, Get = function() return Color3.fromHSV(h, s, v) end }
                Library.Flags[copts.Flag or copts.Name] = CPObj
                local function IsPointerInput(t) return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch end
                local function IsPointerMove(t)  return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch end
                SVBtn.InputBegan:Connect(function(i) if IsPointerInput(i.UserInputType) then sS = true end end)
                HueBtn.InputBegan:Connect(function(i) if IsPointerInput(i.UserInputType) then sH = true end end)
                UIS.InputEnded:Connect(function(i) if IsPointerInput(i.UserInputType) then sS = false; sH = false end end)
                UIS.InputChanged:Connect(function(i)
                    if IsPointerMove(i.UserInputType) then
                        if sS then
                            local relX = math.clamp((i.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
                            local relY = math.clamp((i.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
                            s, v = relX, 1 - relY
                            tweenMarker(Marker, UDim2.new(s, -2, 1 - v, -2))
                            CPHolder.BackgroundColor3 = Color3.fromHSV(h, s, v)
