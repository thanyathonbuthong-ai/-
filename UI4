                    ZIndex = 8, Parent = Box,
                    TextStrokeTransparency = 0,
                    TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                })
                table.insert(Library.Elements.Labels, ValueLabel)

                local Arrow = Create("TextLabel", {
                    Text = "v", Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -20, 0, -1),
                    BackgroundTransparency = 1, Font = UI_FONT,
                    TextSize = Library.Config.FontSize,
                    TextColor3 = Library.Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextYAlignment = Enum.TextYAlignment.Center,
                    ZIndex = 8, Parent = Box,
                    TextStrokeTransparency = 0,
                    TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                })
                table.insert(Library.Elements.Labels, Arrow)

                local Button = Create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1, Text = "",
                    ZIndex = 9, Parent = Box,
                })

                local LIST_ITEM_H = 18
                local MAX_VISIBLE = 8

                local DropOuter = Create("Frame", {
                    Name = "MultiDropContainer", BackgroundTransparency = 1,
                    Visible = false, ClipsDescendants = true,
                    ZIndex = 5000, Parent = ScreenGui,
                })
                local DropInner = Create("Frame", {
                    Name = "DropInner",
                    BackgroundColor3 = Library.Theme.DarkBackground,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0, 0, 0, 0),
                    ZIndex = 5001, Parent = DropOuter,
                })
                ApplyLunexStyle(DropInner)

                table.insert(Library.Elements.MultiDropdowns, {
                    Box = Box, Label = Label, ValueLabel = ValueLabel,
                    Arrow = Arrow, Container = DropInner,
                })

                local OptionHolder = Create("ScrollingFrame", {
                    Name = "Options", Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1, BorderSizePixel = 0,
                    ZIndex = 5002, Parent = DropInner,
                    ScrollBarThickness = 2,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                })
                Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = OptionHolder })

                local currentListHeight = 0
                local dropOpen = false
                local openTween, closeTween
                local trackConn

                local function StartTrack()
                    if trackConn then trackConn:Disconnect() end
                    trackConn = RunService.RenderStepped:Connect(function()
                        if not dropOpen or not Box.Parent then return end
                        local absPos = Box.AbsolutePosition
                        local absSz  = Box.AbsoluteSize
                        DropOuter.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSz.Y + 2)
                        DropOuter.Size = UDim2.new(0, absSz.X, 0, currentListHeight)
                    end)
                end
                local function StopTrack()
                    if trackConn then trackConn:Disconnect(); trackConn = nil end
                end

                local function finishClose()
                    if dropOpen then return end
                    StopTrack()
                    Library:ClearCurrentDropdown(closeDropdown)
                    DropOuter.Visible = false
                    Arrow.Text = "v"
                    Arrow.Position = UDim2.new(1, -20, 0, -1)
                end

                Library:RegisterPopup(function()
                    if openTween then openTween:Cancel() end
                    if closeTween then closeTween:Cancel() end
                    DropInner.Position = UDim2.new(0, 0, 0, 0)
                    dropOpen = false
                    Library:ClearCurrentDropdown(closeDropdown)
                    finishClose()
                end)

                local function FireCallback()
                    ValueLabel.Text = FormatDisplay()
                    if mopts.Callback then mopts.Callback(GetSelectedList()) end
                end

                local function UpdateList(new)
                    if new then options = new; mopts.Options = new end
                    OptionHolder:ClearAllChildren()
                    Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = OptionHolder })

                    if #options == 0 then
                        Create("TextLabel", {
                            Text = "No options",
                            Size = UDim2.new(1, 0, 0, LIST_ITEM_H),
                            BackgroundTransparency = 1, Font = UI_FONT,
                            TextSize = Library.Config.FontSize,
                            TextColor3 = Library.Theme.InactiveText,
                            ZIndex = 5005, Parent = OptionHolder,
                            TextXAlignment = Enum.TextXAlignment.Center,
                        })
                    else
                        for _, option in ipairs(options) do
                            local optBtn = Create("TextButton", {
                                Text = tostring(option),
                                Size = UDim2.new(1, 0, 0, LIST_ITEM_H),
                                BackgroundTransparency = 1, Font = UI_FONT,
                                TextSize = Library.Config.FontSize,
                                TextColor3 = selectedSet[option]
                                    and Library.Theme.Accent
                                    or  Library.Theme.Text,
                                BorderSizePixel = 0, ZIndex = 5005,
                                Parent = OptionHolder,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                TextStrokeTransparency = 0,
                                TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                            })
                            Create("UIPadding", { PaddingLeft = UDim.new(0, 6), Parent = optBtn })

                            optBtn.MouseButton1Click:Connect(function()
                                selectedSet[option] = not selectedSet[option]
                                Tween(optBtn, {
                                    TextColor3 = selectedSet[option]
                                        and Library.Theme.Accent
                                        or  Library.Theme.Text,
                                }, 0.12)
                                FireCallback()
                            end)
                        end
                    end

                    local h = math.clamp(#options * LIST_ITEM_H, LIST_ITEM_H, MAX_VISIBLE * LIST_ITEM_H)
                    if #options == 0 then h = LIST_ITEM_H end
                    currentListHeight = h
                    DropOuter.Size = UDim2.new(0, Box.AbsoluteSize.X, 0, h)
                end

                local function openDropdown()
                    Library:SetCurrentDropdown(closeDropdown)
                    if mopts.OnOpen then mopts.OnOpen() end
                    task.defer(function()
                        UpdateList()
                        local absPos = Box.AbsolutePosition
                        local absSz  = Box.AbsoluteSize
                        DropOuter.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSz.Y + 2)
                        DropOuter.Size = UDim2.new(0, absSz.X, 0, currentListHeight)

                        DropInner.Position = UDim2.new(0, 0, 0, -currentListHeight)
                        DropOuter.Visible = true
                        dropOpen = true

                        if openTween then openTween:Cancel() end
                        if closeTween then closeTween:Cancel() end

                        openTween = TweenService:Create(
                            DropInner,
                            TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                            { Position = UDim2.new(0, 0, 0, 0) }
                        )
                        openTween:Play()

                        Arrow.Text = "^"
                        Arrow.Position = UDim2.new(1, -20, 0, 2)

                        StartTrack()
                    end)
                end

                local function closeDropdown()
                    if not dropOpen then return end
                    if openTween then openTween:Cancel() end
                    if closeTween then closeTween:Cancel() end
                    dropOpen = false

                    closeTween = TweenService:Create(
                        DropInner,
                        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                        { Position = UDim2.new(0, 0, 0, -currentListHeight) }
                    )
                    closeTween.Completed:Connect(finishClose)
                    closeTween:Play()

                    Arrow.Text = "v"
                    Arrow.Position = UDim2.new(1, -20, 0, -1)
                end

                Button.MouseButton1Click:Connect(function()
                    if dropOpen then closeDropdown() else openDropdown() end
                end)

                UIS.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 and dropOpen then
                        if not IsWithin(DropOuter, input) and not IsWithin(Box, input) then
                            closeDropdown()
                        end
                    end
                end)

                local Obj = {
                    Get = function() return GetSelectedList() end,
                    Set = function(list)
                        selectedSet = {}
                        for _, v in ipairs(list) do selectedSet[v] = true end
                        ValueLabel.Text = FormatDisplay()
                        if dropOpen then UpdateList() end
                    end,
                    Refresh = function(new) UpdateList(new) end,
                    IsSelected = function(opt) return selectedSet[opt] == true end,
                    Toggle = function(opt)
                        selectedSet[opt] = not selectedSet[opt]
                        FireCallback()
                        if dropOpen then UpdateList() end
                    end,
                }
                Library.Flags[mopts.Flag or mopts.Name] = Obj
                return Obj
            end

