        function Tab:Configs(side, folderName)
            local ConfigSection = Tab:Section("Configuration", side or "Left")

            local FolderName = tostring(folderName or Library:GetConfigFolder())
            FolderName = FolderName:gsub("[^%w_%-%. ]", ""):gsub("%s+", "_"):gsub("[/\\]+$", "")
            if FolderName == "" then FolderName = "lunex" end

            if not isfolder(FolderName) then
                local ok = pcall(function() makefolder(FolderName) end)
                if not ok then warn("[Lunex] Could not create config folder: " .. FolderName) end
            end

            local ConfigPath = FolderName .. "/"

            local ConfigName = ""
            local NameBox = ConfigSection:TextBox({ Name = "Config Name", Placeholder = "...", Callback = function(v) ConfigName = v end })
            local ConfigList = ConfigSection:Dropdown({ Name = "Saved Configs", Options = {} })

            local function Refresh()
                local names = {}
                local ok, err = pcall(function()
                    local files = listfiles(FolderName) or {}
                    for _, file in ipairs(files) do
                        local name = file:match("([^/\\]+)$") or file
                        if name:lower():sub(-4) == ".cfg" then
                            name = name:sub(1, -5)
                            names[#names + 1] = name
                        end
                    end
                end)
                if not ok then
                    warn("[Lunex] listfiles failed: " .. tostring(err))
                end
                ConfigList:Refresh(names)
            end

            ConfigList.OnOpen = Refresh
            Refresh()

            ConfigSection:Button({ Name = "Save Config", Callback = function()
                local nameToSave = NameBox.GetText()
                if nameToSave == nil or nameToSave == "" then return end

                nameToSave = tostring(nameToSave):gsub("[^%w_%-%. ]", ""):gsub("%s+", "_")
                if nameToSave == "" then
                    Library:Notification({ Text = "Invalid config name", Duration = 2 })
                    return
                end

                local data = { Theme = {}, Flags = {} }
                for k, v in pairs(Library.Theme) do
                    if typeof(v) == "Color3" then data.Theme[k] = v end
                end
                for k, v in pairs(Library.Flags) do
                    local val = (v.Get and v.Get())
                        or (v.GetState and v.GetState())
                        or (v.GetText and v.GetText())
                    if val ~= nil then data.Flags[k] = val end
                end
                local ok = Library:WriteConfigFile(nameToSave, data)
                if ok then
                    Library:Notification({ Text = "Saved: " .. nameToSave, Duration = 2 })
                else
                    Library:Notification({ Text = "Save failed (writefile error)", Duration = 3 })
                end

                task.wait(0.15)
                Refresh()
            end })

            ConfigSection:Button({ Name = "Load Config", Callback = function()
                local selected = ConfigList:Get()
                if not selected or selected == "" then return end
                local data = Library:ReadConfigFile(selected)
                if not data then
                    Library:Notification({ Text = "Failed to read config", Duration = 2 })
                    return
                end
                for k, v in pairs(data.Theme or {}) do
                    if Library.Theme[k] ~= nil then Library.Theme[k] = v end
                end
                Library:UpdateTheme()
                for k, v in pairs(data.Flags or {}) do
                    if Library.Flags[k] and Library.Flags[k].Set then
                        Library.Flags[k].Set(v)
                    end
                end
                Library:Notification({ Text = "Loaded: " .. selected, Duration = 3 })
            end })

            ConfigSection:Button({ Name = "Delete Config", Callback = function()
                local selected = ConfigList:Get()
                if not selected or selected == "" then return end
                local ok = pcall(function() delfile(ConfigPath .. selected .. ".cfg") end)
                if ok then
                    Library:Notification({ Text = "Deleted: " .. selected, Duration = 2 })
                else
                    Library:Notification({ Text = "Delete failed", Duration = 2 })
                end
                task.wait(0.15)
                Refresh()
            end })

            task.spawn(function()
                Refresh()
                task.wait(0.5)
                Refresh()
            end)

            return ConfigSection
        end

        return Tab
    end

    task.delay(0.2, function() Library:UpdateTheme() end)

