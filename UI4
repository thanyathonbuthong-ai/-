                    local function tweenMarker(marker, targetPos)
                        Tween(marker, { Position = targetPos }, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    end

                    local sS, sH = false, false
                    local function Update()
                        color = Color3.fromHSV(h, s, v)
                        Tween(CPHolder, { BackgroundColor3 = color }, 0.15)
                        Tween(SVBox, { BackgroundColor3 = Color3.fromHSV(h, 1, 1) }, 0.15)
                        if copts.Callback then copts.Callback(color) end
                    end
                    local function IsPointerInput2(t) return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch end
                    local function IsPointerMove2(t)  return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch end
                    SVBox.InputBegan:Connect(function(i) if IsPointerInput2(i.UserInputType) then sS = true end end)
                    HueSlider.InputBegan:Connect(function(i) if IsPointerInput2(i.UserInputType) then sH = true end end)
                    UIS.InputEnded:Connect(function(i) if IsPointerInput2(i.UserInputType) then sS = false; sH = false end end)
                    UIS.InputChanged:Connect(function(i)
                        if IsPointerMove2(i.UserInputType) then
                            if sS then
                                local relX = math.clamp((i.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
                                local relY = math.clamp((i.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
                                s, v = relX, 1 - relY
                                tweenMarker(Marker, UDim2.new(s, -2, 1 - v, -2))
                                Update()
                            elseif sH then
                                h = math.clamp((i.Position.Y - HueSlider.AbsolutePosition.Y) / HueSlider.AbsoluteSize.Y, 0, 1)
                                tweenMarker(HueMarker, UDim2.new(0, -2, h, 0))
                                Update()
                            end
                        end
                    end)
                    return ToggleObj
                end
                return ToggleObj
            end

            function Section:Slider(sopts)
                local min, max = sopts.Min, sopts.Max
                local val = sopts.Default or min
                local sliding = false

                local Holder = Create("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, ZIndex = 6, Parent = ElementList })

                local Value = Create("TextBox", {
                    Text = tostring(val),
                    Size = UDim2.new(0, 60, 0, 14),
                    Position = UDim2.new(1, -60, 0, 0),
                    BackgroundTransparency = 1,
                    Font = UI_FONT,
                    TextSize = Library.Config.FontSize,
                    TextColor3 = Library.Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ClearTextOnFocus = false,
                    ZIndex = 7, Parent = Holder,
                    TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                })
                table.insert(Library.Elements.Labels, Value)

                local Label = Create("TextLabel", {
                    Text = sopts.Name or "Slider",
                    Size = UDim2.new(1, -64, 0, 14),
                    Position = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1, Font = UI_FONT,
                    TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7,
                    Parent = Holder,
                    TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                })
                table.insert(Library.Elements.Labels, Label)

                local SliderBack = Create("Frame", {
                    Name = "SliderBack", Size = UDim2.new(1, 0, 0, 8),
                    Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = Library.Theme.SectionBackground,
                    BorderSizePixel = 0, ZIndex = 7, Parent = Holder,
                })
                ApplyLunexStyle(SliderBack)

                local SliderFill = Create("Frame", {
                    Name = "Fill",
                    Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Library.Theme.Accent,
                    BorderSizePixel = 0, ZIndex = 8, Parent = SliderBack,
                })
                table.insert(Library.Elements.Sliders, { Fill = SliderFill, Label = Label, Value = Value, Back = SliderBack })

                local btn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1, Text = "", TextTransparency = 1,
                    ZIndex = 10, Parent = SliderBack,
                })

                local function tweenFill(pct)
                    Tween(SliderFill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                end

                local function applyValue(newVal, fireCallback)
                    val = math.floor(newVal)
                    local pct = (val - min) / (max - min)
                    tweenFill(pct)
                    Value.Text = tostring(val)
                    if fireCallback ~= false and sopts.Callback then sopts.Callback(val) end
                end

                local function Set(v, fireCallback) applyValue(v, fireCallback) end

                local function update(input)
                    local pct = math.clamp((input.Position.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X, 0, 1)
                    applyValue(min + (max - min) * pct, true)
                end

                btn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        update(input)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                UIS.WindowFocusReleased:Connect(function() sliding = false end)

                Value.FocusLost:Connect(function()
                    local parsed = tonumber(Value.Text)
                    if parsed and parsed >= min and parsed <= max then
                        applyValue(parsed, true)
                    else
                        Value.Text = tostring(val)
                    end
                end)

                local Obj = { Get = function() return val end, Set = Set }
                Library.Flags[sopts.Flag or sopts.Name] = Obj
                return Obj
            end

            function Section:Dropdown(dopts)
                local selected = dopts.Default or (dopts.Options and dopts.Options[1]) or "None"
                local Holder = Create("Frame", { Name = "DropdownHolder", Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, ZIndex = 6, Parent = ElementList })
                local Label = Create("TextLabel", { Text = dopts.Name, Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Font = UI_FONT, TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = Holder, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0) })
                table.insert(Library.Elements.Labels, Label)
                local Box = Create("Frame", { Name = "DropdownBox", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 15), BackgroundColor3 = Library.Theme.SectionBackground, BorderSizePixel = 0, ZIndex = 7, Parent = Holder })
                ApplyLunexStyle(Box)
                local ValueLabel = Create("TextLabel", { Text = selected, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 6, 0, 0), BackgroundTransparency = 1, Font = UI_FONT, TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 8, Parent = Box, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0) })
                table.insert(Library.Elements.Labels, ValueLabel)
                local Arrow = Create("TextLabel", { Text = "v", Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -20, 0, -1), BackgroundTransparency = 1, Font = UI_FONT, TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 8, Parent = Box, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0) })
                table.insert(Library.Elements.Labels, Arrow)
                local Button = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 9, Parent = Box })

                local LIST_ITEM_H = 18
                local MAX_VISIBLE = 8

                local DropOuter = Create("Frame", {
                    Name = "DropContainer",
                    BackgroundTransparency = 1,
                    Visible = false, ClipsDescendants = true,
                    ZIndex = 5000, Parent = ScreenGui,
                })
                local DropInner = Create("Frame", {
                    Name = "DropInner",
                    BackgroundColor3 = Library.Theme.DarkBackground,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0, 0, 0, 0),
                    ZIndex = 5001, Parent = DropOuter,
                })
                ApplyLunexStyle(DropInner)
                table.insert(Library.Elements.Dropdowns, {
                    Box = Box, Label = Label, ValueLabel = ValueLabel,
                    Arrow = Arrow, Container = DropInner, Buttons = {}
                })

                local OptionHolder = Create("ScrollingFrame", {
                    Name = "Options",
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1, BorderSizePixel = 0,
                    ZIndex = 5002, Parent = DropInner,
                    ScrollBarThickness = 2,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                })
                Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = OptionHolder })

                local currentListHeight = 0
                local dropOpen = false
                local openTween, closeTween
                local trackConn

                local function StartTrack()
                    if trackConn then trackConn:Disconnect() end
                    trackConn = RunService.RenderStepped:Connect(function()
                        if not dropOpen or not Box.Parent then return end
                        local absPos = Box.AbsolutePosition
                        local absSz  = Box.AbsoluteSize
                        DropOuter.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSz.Y + 2)
                        DropOuter.Size = UDim2.new(0, absSz.X, 0, currentListHeight)
                    end)
                end
                local function StopTrack()
                    if trackConn then trackConn:Disconnect(); trackConn = nil end
                end

                local function finishClose()
                    if dropOpen then return end
                    StopTrack()
                    Library:ClearCurrentDropdown(closeDropdown)
                    DropOuter.Visible = false
                    Arrow.Text = "v"
                    Arrow.Position = UDim2.new(1, -20, 0, -1)
                end

                Library:RegisterPopup(function()
                    if openTween then openTween:Cancel() end
                    if closeTween then closeTween:Cancel() end
                    DropInner.Position = UDim2.new(0, 0, 0, 0)
                    dropOpen = false
                    Library:ClearCurrentDropdown(closeDropdown)
                    finishClose()
                end)

                local function UpdateList(new)
                    if new then dopts.Options = new end
                    local options = dopts.Options or {}
                    OptionHolder:ClearAllChildren()
                    Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = OptionHolder })

                    if #options == 0 then
                        Create("TextLabel", {
                            Text = "No Configs Found",
                            Size = UDim2.new(1, 0, 0, LIST_ITEM_H),
                            BackgroundTransparency = 1, Font = UI_FONT,
                            TextSize = Library.Config.FontSize,
                            TextColor3 = Library.Theme.InactiveText,
                            ZIndex = 5005, Parent = OptionHolder,
                            TextXAlignment = Enum.TextXAlignment.Center,
                        })
                    else
                        for _, option in ipairs(options) do
                            local optBtn = Create("TextButton", {
                                Text = tostring(option),
                                Size = UDim2.new(1, 0, 0, LIST_ITEM_H),
                                BackgroundTransparency = 1, Font = UI_FONT,
                                TextSize = Library.Config.FontSize,
                                TextColor3 = (tostring(option) == tostring(selected))
                                    and Library.Theme.Accent or Library.Theme.Text,
                                BorderSizePixel = 0, ZIndex = 5005,
                                Parent = OptionHolder,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                TextStrokeTransparency = 0,
                                TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                            })
                            Create("UIPadding", { PaddingLeft = UDim.new(0, 6), Parent = optBtn })
                            optBtn.MouseButton1Click:Connect(function()
                                selected = option
                                ValueLabel.Text = tostring(option)
                                if dopts.Callback then dopts.Callback(option) end
                                if dropOpen then
                                    if openTween then openTween:Cancel() end
                                    if closeTween then closeTween:Cancel() end
                                    dropOpen = false
                                    local h = currentListHeight
                                    closeTween = TweenService:Create(
                                        DropInner,
                                        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                                        { Position = UDim2.new(0, 0, 0, -h) }
                                    )
                                    closeTween.Completed:Connect(finishClose)
                                    closeTween:Play()
                                    Arrow.Text = "v"
                                    Arrow.Position = UDim2.new(1, -20, 0, -1)
                                else
                                    finishClose()
                                end
                                UpdateList()
                            end)
                        end
                    end

                    local h = math.clamp(#options * LIST_ITEM_H, LIST_ITEM_H, MAX_VISIBLE * LIST_ITEM_H)
                    if #options == 0 then h = LIST_ITEM_H end
                    currentListHeight = h
                    DropOuter.Size = UDim2.new(0, Box.AbsoluteSize.X, 0, h)
                end

                local function openDropdown()
                    Library:SetCurrentDropdown(closeDropdown)
                    if dopts.OnOpen then dopts.OnOpen() end
                    task.defer(function()
                        UpdateList()
                        local absPos = Box.AbsolutePosition
                        local absSz  = Box.AbsoluteSize
                        DropOuter.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSz.Y + 2)
                        DropOuter.Size = UDim2.new(0, absSz.X, 0, currentListHeight)

                        DropInner.Position = UDim2.new(0, 0, 0, -currentListHeight)
                        DropOuter.Visible = true
                        dropOpen = true

                        if openTween then openTween:Cancel() end
                        if closeTween then closeTween:Cancel() end

                        openTween = TweenService:Create(
                            DropInner,
                            TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                            { Position = UDim2.new(0, 0, 0, 0) }
                        )
                        openTween:Play()

                        Arrow.Text = "^"
                        Arrow.Position = UDim2.new(1, -20, 0, 2)

                        StartTrack()
                    end)
                end

                local function closeDropdown()
                    if not dropOpen then return end
                    if openTween then openTween:Cancel() end
                    if closeTween then closeTween:Cancel() end
                    dropOpen = false

                    closeTween = TweenService:Create(
                        DropInner,
                        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                        { Position = UDim2.new(0, 0, 0, -currentListHeight) }
                    )
                    closeTween.Completed:Connect(finishClose)
                    closeTween:Play()

                    Arrow.Text = "v"
