local function Tween(obj, props, time, style, dir)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function ColorToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function IsWithin(obj, input)
    local pos  = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    local mPos = input.Position
    return mPos.X >= pos.X and mPos.X <= pos.X + size.X and mPos.Y >= pos.Y and mPos.Y <= pos.Y + size.Y
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging = false

    -- Mobile safe-area: when a draggable UI leaves the screen,
    -- snap it back inside the visible viewport automatically.
    local function KeepInsideScreen()
        if not frame or not frame.Parent then return end
        local camera = workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        local size = frame.AbsoluteSize
        local pos = frame.AbsolutePosition
        local margin = 6

        local minX = margin
        local minY = margin
        local maxX = math.max(minX, viewport.X - size.X - margin)
        local maxY = math.max(minY, viewport.Y - size.Y - margin)

        local newX = math.clamp(pos.X, minX, maxX)
        local newY = math.clamp(pos.Y, minY, maxY)

        if math.abs(newX - pos.X) > 0.5 or math.abs(newY - pos.Y) > 0.5 then
            local current = frame.Position
            frame.Position = UDim2.new(0, newX, 0, newY)
        end
    end
    local dragStart, startPos
    local inputBeganConn = handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            local changedConn
            changedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    KeepInsideScreen()
                    if changedConn then changedConn:Disconnect() end
                end
            end)
        end
    end)
    local inputChangedConn = UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    local inputEndedConn = UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Keep draggable UI fully inside the mobile screen.
    -- If the UI is dragged outside the screen, it smoothly returns to the nearest valid position.
    local viewportConn = RunService.RenderStepped:Connect(function()
        if not frame or not frame.Parent then return end
        if dragging then return end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local view = camera.ViewportSize
        local pos = frame.AbsolutePosition
        local size = frame.AbsoluteSize
        local margin = 4

        local minX = margin
        local minY = margin
        local maxX = math.max(minX, view.X - size.X - margin)
        local maxY = math.max(minY, view.Y - size.Y - margin)

        local targetX = math.clamp(pos.X, minX, maxX)
        local targetY = math.clamp(pos.Y, minY, maxY)

        if math.abs(targetX - pos.X) > 0.5 or math.abs(targetY - pos.Y) > 0.5 then
            local current = frame.Position
            frame.Position = UDim2.new(
                current.X.Scale, current.X.Offset + (targetX - pos.X),
                current.Y.Scale, current.Y.Offset + (targetY - pos.Y)
            )
        end
    end)
    local focusConn = UIS.WindowFocused:Connect(function() end)
    local focusLostConn = UIS.WindowFocusReleased:Connect(function()
        dragging = false
        KeepInsideScreen()
    end)
    local viewportConn = workspace.CurrentCamera and workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(KeepInsideScreen)
    task.defer(KeepInsideScreen)

    return function()
        if inputBeganConn then inputBeganConn:Disconnect() end
        if inputChangedConn then inputChangedConn:Disconnect() end
        if inputEndedConn then inputEndedConn:Disconnect() end
        if focusConn then focusConn:Disconnect() end
        if focusLostConn then focusLostConn:Disconnect() end
        if viewportConn then viewportConn:Disconnect() end
    end
end

