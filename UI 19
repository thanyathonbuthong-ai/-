--[[
	Nebula UI Library
	Reusable Roblox UI library extracted & refactored from the Young0x / FG100 hub UI.
	Preserves the original look: dark navy + cyan theme, animated RGB border,
	draggable / resizable / minimizable window, scrollable tab bar, and a full set of controls.

	API:
		local Library = loadstring(game:HttpGet("<raw-url>"))()
		local Window = Library:CreateWindow({
			Title = "My Hub",
			Subtitle = "subtitle text",
			BackgroundAsset = "rbxassetid://0",   -- optional
			Width = 548, Height = 360,             -- optional, desktop defaults
			Theme = "Galaxia",                     -- or "Cyber" / "Sunset" / "Mono" / custom Color3 table
			MinimizeKey = Enum.KeyCode.RightShift, -- optional toggle key
		})
		local Tab = Window:CreateTab("Main", 62)    -- name, width(px)
		Tab:AddSection("Farming")
		Tab:AddLabel("Status: ready")
		local info = Tab:AddInfoRow("Strength", "0", Color3.fromRGB(126,224,175))
		Tab:AddButton("Click me", function() end)
		local tog = Tab:AddToggle("Auto Farm", function(state) end, false)
		tog:Set(true) ; tog:Get()
		local slid = Tab:AddSlider("Speed", 1, 100, 50, function(v) end)
		slid:Set(25) ; slid:Get()
		local drop = Tab:AddDropdown("Select", {"A","B","C"}, function(v) end)
		drop:Set("B") ; drop:Refresh({"X","Y"})
		local inp = Tab:AddInput("Name", "type here...", function(text) end)
		Window:Notify("Hello!", 3)
		Window:Minimize() / Window:Restore() / Window:Destroy()
]]

