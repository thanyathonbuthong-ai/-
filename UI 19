function Library:CreateWindow(options)
	options = options or {}
	local self = setmetatable({}, Library)
	self.Destroyed = false
	self.Tabs = {}
	self.ThemeName = typeof(options.Theme) == "string" and options.Theme or "Galaxia"
	self.C = {}
	local preset = THEMES[self.ThemeName] or THEMES.Galaxia
	for k, v in pairs(preset) do self.C[k] = v end
	if typeof(options.Theme) == "table" then
		for k, v in pairs(options.Theme) do self.C[k] = v end
	end
	local C = self.C

	local isMobile = viewportSize().X < 760 or (UserInputService.TouchEnabled and viewportSize().X < 1100)
	local hubWidth = isMobile and clamp(viewportSize().X * 0.9, 276, 470) or (options.Width or 548)
	local hubHeight = isMobile and clamp(viewportSize().Y * 0.58, 220, 310) or (options.Height or 360)
	local MIN_W = isMobile and 132 or 168
	local MIN_H = isMobile and 64 or 68
	local HEADER_H = 54
	local TAB_H = 40

	local connections = {}
	local function track(conn)
		if conn then table.insert(connections, conn) end
		return conn
	end
	self._track = track

