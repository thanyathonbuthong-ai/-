	-- RGB sweep
	local sweep = Instance.new("Frame")
	sweep.Name = "BorderSweep"
	sweep.Size = UDim2.fromOffset(120, 2)
	sweep.BackgroundColor3 = C.white
	sweep.BackgroundTransparency = 0.2
	sweep.BorderSizePixel = 0
	sweep.ZIndex = 3
	sweep.Parent = Border
	Instance.new("UICorner", sweep).CornerRadius = UDim.new(1, 0)
	local sweepGrad = Instance.new("UIGradient")
	sweepGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	sweepGrad.Parent = sweep

	-- animate stroke gradient rotation + sweep travel
	track(RunService.RenderStepped:Connect(function(dt)
		if not strokeGrad.Parent then return end
		strokeGrad.Rotation = (strokeGrad.Rotation + dt * 40) % 360
		-- travel sweep around border perimeter
		local w, h = Border.AbsoluteSize.X, Border.AbsoluteSize.Y
		if w <= 0 then return end
		local peri = 2 * (w + h)
		local t = (tick() * 60) % peri / peri
		local d = t * peri
		if d < w then
			sweep.Position = UDim2.new(0, d, 0, -1)
			sweep.Rotation = 0
		elseif d < w + h then
			sweep.Position = UDim2.new(1, -1, 0, d - w)
			sweep.Rotation = 90
		elseif d < 2 * w + h then
			sweep.Position = UDim2.new(1, (d - w - h) - w, 1, 1)
			sweep.Rotation = 0
		else
			sweep.Position = UDim2.new(0, -1, 1, (d - 2 * w - h) - h)
			sweep.Rotation = 90
		end
	end))

