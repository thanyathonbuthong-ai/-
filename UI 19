	local MiniDrag = Instance.new("TextButton")
	MiniDrag.Size = UDim2.fromScale(1, 1)
	MiniDrag.BackgroundTransparency = 1
	MiniDrag.Text = ""
	MiniDrag.AutoButtonColor = false
