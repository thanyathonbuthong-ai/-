	-- Mini bubble (shown when minimized)
	local MiniBubble = Instance.new("Frame")
	MiniBubble.Name = "MiniBubble"
	MiniBubble.Size = UDim2.fromOffset(150, 46)
	MiniBubble.Position = UDim2.new(0, 20, 1, -76)
	MiniBubble.BackgroundColor3 = C.panel
	MiniBubble.BackgroundTransparency = 0.05
	MiniBubble.BorderSizePixel = 0
	MiniBubble.Visible = false
	MiniBubble.ZIndex = 50
	MiniBubble.Parent = ScreenGui
	Instance.new("UICorner", MiniBubble).CornerRadius = UDim.new(0, 14)
	local miniStroke = Instance.new("UIStroke")
	miniStroke.Thickness = 1.2
	miniStroke.Color = C.accent
	miniStroke.Transparency = 0.3
	miniStroke.Parent = MiniBubble
	local miniIcon = Instance.new("TextLabel")
	miniIcon.Size = UDim2.fromOffset(30, 30)
	miniIcon.Position = UDim2.fromOffset(8, 8)
	miniIcon.BackgroundColor3 = C.tabOn
	miniIcon.BackgroundTransparency = 0.15
	miniIcon.BorderSizePixel = 0
	miniIcon.Text = "✦"
	miniIcon.TextColor3 = C.accent
	miniIcon.Font = FONT_BOLD
	miniIcon.TextSize = 16
	miniIcon.ZIndex = 51
	miniIcon.Parent = MiniBubble
	Instance.new("UICorner", miniIcon).CornerRadius = UDim.new(0, 8)
	local miniLabel = Instance.new("TextLabel")
