	ToggleBall.ZIndex = 4
	ToggleBall.BorderSizePixel = 0

	local UICorner_Ball = Instance.new("UICorner")
	UICorner_Ball.CornerRadius = UDim.new(1, 0)
	UICorner_Ball.Parent = ToggleBall

	local toggleGrad = Instance.new("UIGradient")
	toggleGrad.Name = "ActiveToggleGrad"
	toggleGrad.Color = getGradientSequence(window.titleLeft, window.titleRight)
	toggleGrad.Parent = ToggleBg
	table.insert(window.activeToggleGradients, toggleGrad)

	local state = { Value = (opts.Default == true) }

	local function updateView(animate)
		toggleGrad.Enabled = state.Value
		local targetPos = state.Value and UDim2.new(1, -15, 0, 3) or UDim2.new(0, 3, 0, 3)
		local targetBallColor = state.Value and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(100, 100, 105)
		local targetBgColor = state.Value and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(220, 220, 225)
		if animate then
			TS:Create(ToggleBall, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = targetPos, BackgroundColor3 = targetBallColor }):Play()
			if not state.Value then
				TS:Create(ToggleBg, TweenInfo.new(0.18), { BackgroundColor3 = targetBgColor }):Play()
			end
		else
			ToggleBall.Position = targetPos
			ToggleBall.BackgroundColor3 = targetBallColor
			if not state.Value then ToggleBg.BackgroundColor3 = targetBgColor end
		end
	end

	ToggleBg.MouseButton1Click:Connect(function()
		state.Value = not state.Value
		updateView(true)
		if opts.Callback then pcall(opts.Callback, state.Value) end
	end)

	updateView(false)

	return {
		SetValue = function(_, v, fire)
			state.Value = (v == true)
			updateView(true)
			if fire and opts.Callback then pcall(opts.Callback, state.Value) end
		end,
		GetValue = function() return state.Value end,
	}
end

function Tab:CreateSlider(opts)
	opts = opts or {}
	local targetFrame = self.Frame
	local window = self.Window
	local min = opts.Min or 0
	local max = opts.Max or 100
	local suffix = opts.Suffix or ""
	local float = opts.Float == true
	local state = { Value = opts.Default or min }

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1, -14, 0, 38)
	Frame.BackgroundTransparency = 1
	Frame.Parent = targetFrame

	local Label = Instance.new("TextLabel")
	Label.Parent = Frame
	Label.BackgroundTransparency = 1
	Label.Size = UDim2.new(0.6, 0, 0, 14)
	Label.Font = Enum.Font.GothamSemibold
	Label.Text = opts.Name or "Slider"
	Label.TextSize = 11
	Label.TextXAlignment = Enum.TextXAlignment.Left
	window:registerTextLabel(Label)

	local SliderValue = Instance.new("TextLabel")
	SliderValue.Name = "SliderValue"
	SliderValue.Parent = Frame
	SliderValue.BackgroundTransparency = 1
	SliderValue.Position = UDim2.new(0.6, 0, 0, 0)
	SliderValue.Size = UDim2.new(0, 120, 0, 14)
	SliderValue.Font = Enum.Font.Code
	SliderValue.TextXAlignment = Enum.TextXAlignment.Right
	SliderValue.TextSize = 10
	window:registerTextLabel(SliderValue)

	local SliderBtn = Instance.new("TextButton")
	SliderBtn.Parent = Frame
	SliderBtn.BackgroundColor3 = Color3.fromRGB(220, 220, 225)
	SliderBtn.Position = UDim2.new(0, 0, 0, 20)
	SliderBtn.Size = UDim2.new(1, 0, 0, 12)
	SliderBtn.Text = ""
	SliderBtn.BorderSizePixel = 0
	SliderBtn.AutoButtonColor = false

	local UICorner_Track = Instance.new("UICorner")
	UICorner_Track.CornerRadius = UDim.new(1, 0)
	UICorner_Track.Parent = SliderBtn

	local SliderFill = Instance.new("Frame")
	SliderFill.Parent = SliderBtn
	SliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	SliderFill.BorderSizePixel = 0

	local UICorner_Fill = Instance.new("UICorner")
	UICorner_Fill.CornerRadius = UDim.new(1, 0)
	UICorner_Fill.Parent = SliderFill
	window:applyThemeGradient(SliderFill)

	local function displayText(v)
		if float then
			return string.format("%.2f", v) .. suffix
		else
			return tostring(math.floor(v + 0.5)) .. suffix
		end
	end

	local function setFromRatio(posX)
		posX = math.clamp(posX, 0, 1)
		SliderFill.Size = UDim2.new(posX, 0, 1, 0)
		local val = min + (max - min) * posX
		if not float then val = math.floor(val + 0.5) end
		state.Value = val
		SliderValue.Text = displayText(val)
		if opts.Callback then pcall(opts.Callback, val) end
	end

	-- initial
	local initRatio = math.clamp((state.Value - min) / ((max - min) ~= 0 and (max - min) or 1), 0, 1)
	SliderFill.Size = UDim2.new(initRatio, 0, 1, 0)
	SliderValue.Text = displayText(state.Value)

	local dragging = false
	SliderBtn.MouseButton1Down:Connect(function() dragging = true end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			if SliderBtn.AbsoluteSize.X == 0 then return end
			setFromRatio((input.Position.X - SliderBtn.AbsolutePosition.X) / SliderBtn.AbsoluteSize.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return {
		SetValue = function(_, v)
			v = math.clamp(v, min, max)
			if not float then v = math.floor(v + 0.5) end
			state.Value = v
			setFromRatio((v - min) / ((max - min) ~= 0 and (max - min) or 1))
		end,
		GetValue = function() return state.Value end,
	}
end

