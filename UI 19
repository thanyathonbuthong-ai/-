	local function nextOrder(page)
		page._order = (page._order or 0) + 1
		return page._order
	end

	local function refreshTabs(activeName)
		for _, child in ipairs(TabBar:GetChildren()) do
			if child:IsA("TextButton") then
				local isActive = child.Name == activeName
				tween(child, 0.2, { BackgroundColor3 = isActive and C.tabOn or C.tab })
				local lbl = child:FindFirstChildOfClass("TextLabel")
				if lbl then tween(lbl, 0.2, { TextColor3 = isActive and C.accent or C.dim }) end
				local ind = child:FindFirstChild("ActiveIndicator")
				if ind then tween(ind, 0.25, { BackgroundTransparency = isActive and 0 or 1 }) end
			end
		end
	end
	self._refreshTabs = refreshTabs

