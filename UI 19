function Tab:CreateDropdown(opts)
	opts = opts or {}
	local targetFrame = self.Frame
	local window = self.Window
	local options = opts.Options or {}
	local state = { Value = opts.Default or options[1] }

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1, -14, 0, 38)
	Frame.BackgroundTransparency = 1
	Frame.Parent = targetFrame

	local Label = Instance.new("TextLabel")
	Label.Parent = Frame
	Label.BackgroundTransparency = 1
	Label.Size = UDim2.new(0.6, 0, 0, 14)
	Label.Font = Enum.Font.GothamSemibold
	Label.Text = opts.Name or "Dropdown"
	Label.TextSize = 11
	Label.TextXAlignment = Enum.TextXAlignment.Left
	window:registerTextLabel(Label)

	local DropdownBtn = Instance.new("TextButton")
	DropdownBtn.Parent = Frame
	DropdownBtn.BackgroundColor3 = Color3.fromRGB(220, 220, 225)
	DropdownBtn.Position = UDim2.new(0, 0, 0, 20)
	DropdownBtn.Size = UDim2.new(1, 0, 0, 16)
	DropdownBtn.Text = state.Value or "Select"
	DropdownBtn.TextColor3 = Color3.fromRGB(40, 40, 50)
	DropdownBtn.TextSize = 11
	DropdownBtn.BorderSizePixel = 0
	Instance.new("UICorner", DropdownBtn).CornerRadius = UDim.new(0, 4)

	local DropdownList = Instance.new("Frame")
	DropdownList.Parent = Frame
	DropdownList.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
	DropdownList.Position = UDim2.new(0, 0, 0, 38)
	DropdownList.Size = UDim2.new(1, 0, 0, 0)
	DropdownList.ClipsDescendants = true
	DropdownList.BorderSizePixel = 0
	Instance.new("UICorner", DropdownList).CornerRadius = UDim.new(0, 4)

	local listLayout = Instance.new("UIListLayout", DropdownList)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 1)

	local isOpen = false

	local function rebuildOptions()
		for _, child in pairs(DropdownList:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for _, opt in ipairs(options) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 20)
			btn.BackgroundColor3 = Color3.fromRGB(245, 245, 250)
			btn.BackgroundTransparency = 0.2
			btn.Text = opt
			btn.TextColor3 = Color3.fromRGB(20, 20, 30)
			btn.TextSize = 10
			btn.BorderSizePixel = 0
			btn.Parent = DropdownList
			btn.MouseButton1Click:Connect(function()
				state.Value = opt
				DropdownBtn.Text = opt
				if opts.Callback then pcall(opts.Callback, opt) end
				isOpen = false
				TS:Create(DropdownList, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, 0) }):Play()
			end)
		end
	end

	DropdownBtn.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		if isOpen then
			rebuildOptions()
			local totalHeight = listLayout.AbsoluteContentSize.Y
			TS:Create(DropdownList, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, math.clamp(totalHeight, 0, 80)) }):Play()
		else
			TS:Create(DropdownList, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, 0) }):Play()
		end
	end)

	return {
		Set = function(_, v)
			state.Value = v
			DropdownBtn.Text = v
			if opts.Callback then pcall(opts.Callback, v) end
		end,
		Refresh = function(_, newOptions)
			options = newOptions or {}
			if not table.find(options, state.Value) then
				state.Value = options[1]
				DropdownBtn.Text = state.Value or "Select"
			end
		end,
		GetValue = function() return state.Value end,
	}
end

function Tab:CreateColorPicker(opts)
	opts = opts or {}
	local targetFrame = self.Frame
	local window = self.Window
	local default = opts.Default or Color3.fromRGB(255, 0, 0)
	local currentH, currentS, currentV = default:ToHSV()

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -14, 0, 90)
	container.BackgroundTransparency = 1
	container.Parent = targetFrame

	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Size = UDim2.new(1, 0, 0, 14)
	titleLbl.Font = Enum.Font.GothamSemibold
	titleLbl.Text = opts.Name or "Color"
	titleLbl.TextSize = 11
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = container
	window:registerTextLabel(titleLbl)

	local canvas = Instance.new("TextButton")
	canvas.Size = UDim2.new(1, 0, 0, 45)
	canvas.Position = UDim2.fromOffset(0, 18)
	canvas.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
	canvas.Text = ""
	canvas.AutoButtonColor = false
	canvas.Parent = container
	canvas.BorderSizePixel = 0
	Instance.new("UICorner", canvas).CornerRadius = UDim.new(0, 4)

	local satGrad = Instance.new("UIGradient")
	satGrad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0))
	satGrad.Rotation = 90
	satGrad.Parent = canvas

	local valueOverlay = Instance.new("Frame")
	valueOverlay.Size = UDim2.new(1, 0, 1, 0)
	valueOverlay.BackgroundTransparency = 0
	valueOverlay.Parent = canvas
	valueOverlay.BorderSizePixel = 0

	local valGrad = Instance.new("UIGradient")
	valGrad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0))
	valGrad.Transparency = NumberSequence.new(0, 1)
	valGrad.Parent = valueOverlay

	local pointer = Instance.new("Frame")
	pointer.Size = UDim2.fromOffset(5, 5)
	pointer.Position = UDim2.new(currentS, -2.5, 1 - currentV, -2.5)
	pointer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	pointer.Parent = canvas
	pointer.BorderSizePixel = 0

	local hueTrack = Instance.new("TextButton")
	hueTrack.Size = UDim2.new(1, 0, 0, 8)
	hueTrack.Position = UDim2.fromOffset(0, 70)
	hueTrack.Text = ""
	hueTrack.AutoButtonColor = false
	hueTrack.Parent = container
	hueTrack.BorderSizePixel = 0
	Instance.new("UICorner", hueTrack).CornerRadius = UDim.new(0, 3)

	local hueGrad = Instance.new("UIGradient")
	hueGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0,     Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.5,   Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0, 0, 255)),
		ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
		ColorSequenceKeypoint.new(1,     Color3.fromRGB(255, 0, 0)),
	})
	hueGrad.Parent = hueTrack

	local function updatePicker()
		local selectedColor = Color3.fromHSV(currentH, currentS, currentV)
		canvas.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
		if opts.Callback then pcall(opts.Callback, selectedColor) end
	end

	local isSlidingCanvas = false
	canvas.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isSlidingCanvas = true
			if canvas.AbsoluteSize.X == 0 then return end
			local x = math.clamp((input.Position.X - canvas.AbsolutePosition.X) / canvas.AbsoluteSize.X, 0, 1)
			local y = math.clamp((input.Position.Y - canvas.AbsolutePosition.Y) / canvas.AbsoluteSize.Y, 0, 1)
			pointer.Position = UDim2.new(x, -2.5, y, -2.5)
			currentS = x currentV = 1 - y updatePicker()
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if isSlidingCanvas and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			if canvas.AbsoluteSize.X == 0 then return end
			local x = math.clamp((input.Position.X - canvas.AbsolutePosition.X) / canvas.AbsoluteSize.X, 0, 1)
			local y = math.clamp((input.Position.Y - canvas.AbsolutePosition.Y) / canvas.AbsoluteSize.Y, 0, 1)
			pointer.Position = UDim2.new(x, -2.5, y, -2.5)
			currentS = x currentV = 1 - y updatePicker()
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isSlidingCanvas = false
		end
	end)

	local isSlidingHue = false
	hueTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isSlidingHue = true
			if hueTrack.AbsoluteSize.X == 0 then return end
			local x = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 0.999)
			currentH = x updatePicker()
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if isSlidingHue and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			if hueTrack.AbsoluteSize.X == 0 then return end
			local x = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 0.999)
			currentH = x updatePicker()
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isSlidingHue = false
		end
	end)

	return {
		SetColor = function(_, c)
			currentH, currentS, currentV = c:ToHSV()
			pointer.Position = UDim2.new(currentS, -2.5, 1 - currentV, -2.5)
			updatePicker()
		end,
		GetColor = function() return Color3.fromHSV(currentH, currentS, currentV) end,
	}
end

return ThunderUI
