	local hubHeight = isMobile and math.clamp(viewportSize().Y * 0.58, 220, 310) or desktopH
	local MIN_W = isMobile and 132 or 168
	local MIN_H = isMobile and 64 or 68
	local HEADER_H = 54
	local TAB_H = 40

