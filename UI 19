	MiniDrag.Parent = MiniBubble
	self.MiniBubble = MiniBubble

	-- Drag helper (window + bubble) — returns moved-distance getter for click vs drag
	local function makeDraggable(button, frame)
		local dragging, dragStart, startPos, movedDist
		track(button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				movedDist = 0
				dragStart = Vector2.new(input.Position.X, input.Position.Y)
				startPos = frame.Position
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local cur = Vector2.new(input.Position.X, input.Position.Y)
				movedDist = (cur - dragStart).Magnitude
				local delta = cur - dragStart
				frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
		return function() return movedDist or 0 end
	end
	makeDraggable(DragHandle, AnimationRoot)
	local bubbleMovedDist = makeDraggable(MiniDrag, MiniBubble)

	-- Resize
	track(ResizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local startSize = AnimationRoot.Size
		local startInput = Vector2.new(input.Position.X, input.Position.Y)
		local conn, endConn
		conn = UserInputService.InputChanged:Connect(function(inc)
			if inc.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			local dx = inc.Position.X - startInput.X
			local dy = inc.Position.Y - startInput.Y
			local newW = clamp(startSize.X.Offset + dx, MIN_W, 1200)
			local newH = clamp(startSize.Y.Offset + dy, MIN_H, 900)
			AnimationRoot.Size = UDim2.fromOffset(newW, newH)
			Shadow.Size = UDim2.fromOffset(newW, newH)
			MainFrame.Size = UDim2.fromOffset(newW - 2, newH - 2)
			Border.Size = UDim2.fromOffset(newW + 2, newH + 2)
		end)
		endConn = UserInputService.InputEnded:Connect(function(ine)
			if ine.UserInputType == Enum.UserInputType.MouseButton1 then
				conn:Disconnect(); endConn:Disconnect()
			end
		end)
	end))

	-- Minimize / Restore (robust — idempotent, no race)
	local minimized = false
	local function setMinimized(v)
		if minimized == v then return end
		minimized = v
		if v then
			tween(MotionScale, 0.22, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.18, function()
				if minimized and AnimationRoot.Parent then
					AnimationRoot.Visible = false
				end
			end)
			MiniBubble.Visible = true
		else
			AnimationRoot.Visible = true
			MiniBubble.Visible = false
			tween(MotionScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end
	self.Minimize = function() setMinimized(true) end
	self.Restore = function() setMinimized(false) end
	self.Toggle = function() setMinimized(not minimized) end

	MiniIcon.MouseButton1Click:Connect(function() setMinimized(true) end)

	-- Click bubble to restore (distinguish tap from drag via movement distance)
	MiniDrag.MouseButton1Click:Connect(function()
		if bubbleMovedDist() < 6 then
			setMinimized(false)
		end
	end)

	-- Toggle key (always responds — does NOT check gpe, so it can never get "stuck" minimized)
	if options.MinimizeKey then
		track(UserInputService.InputBegan:Connect(function(input)
			if input.KeyCode == options.MinimizeKey then
