	-- Resize logic
	track(ResizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local startSize = AnimationRoot.Size
		local startInput = input.Position
		local conn
		conn = UserInputService.InputChanged:Connect(function(inc)
			if inc.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			local dx = inc.Position.X - startInput.X
			local dy = inc.Position.Y - startInput.Y
			local newW = math.max(MIN_W, startSize.X.Offset + dx)
			local newH = math.max(MIN_H, startSize.Y.Offset + dy)
			AnimationRoot.Size = UDim2.fromOffset(newW, newH)
			Shadow.Size = UDim2.fromOffset(newW, newH)
			MainFrame.Size = UDim2.fromOffset(newW - 2, newH - 2)
			Border.Size = UDim2.fromOffset(newW + 2, newH + 2)
		end)
		local endConn
		endConn = UserInputService.InputEnded:Connect(function(ine)
			if ine.UserInputType == Enum.UserInputType.MouseButton1 then
				conn:Disconnect()
				endConn:Disconnect()
			end
		end)
	end))

	-- Minimize / restore
	local minimized = false
	local function setMinimized(v)
		minimized = v
		if v then
			tween(scale, 0.25, { Scale = 0.6, }, Enum.EasingStyle.Quad)
			task.delay(0.2, function() if minimized then AnimationRoot.Visible = false end end)
			MiniBubble.Visible = true
			tween(MiniBubble, 0.3, { BackgroundTransparency = 0.1 })
		else
			AnimationRoot.Visible = true
			MiniBubble.Visible = false
			tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	self.Minimize = function() setMinimized(true) end
	self.Restore = function() setMinimized(false) end
	self.Toggle = function() setMinimized(not minimized) end
	MiniIcon.MouseButton1Click:Connect(self.Minimize)
	-- click bubble (short tap, not drag) to restore
	local bubbleClickStart
	MiniDrag.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			bubbleClickStart = tick()
		end
	end)
	MiniDrag.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and bubbleClickStart and (tick() - bubbleClickStart) < 0.25 then
			setMinimized(false)
		end
	end)

	-- toggle key
	if options.MinimizeKey then
		track(UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.KeyCode == options.MinimizeKey then self.Toggle() end
		end))
	end

