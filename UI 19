function ThunderUI:CreateWindow(opts)
	opts = opts or {}
	local self = setmetatable({}, ThunderUI)

	self.Name         = opts.Name or "ThunderUI"
	self.Logo1        = opts.Logo1 or DEFAULT_LOGO_1
	self.Logo2        = opts.Logo2 or DEFAULT_LOGO_2
	self.themeLeft    = opts.ThemeLeft  or Color3.fromRGB(255, 255, 255)
	self.themeRight   = opts.ThemeRight or Color3.fromRGB(255, 255, 255)
	self.titleLeft    = opts.TitleLeft  or Color3.fromRGB(0, 0, 0)
	self.titleRight   = opts.TitleRight or Color3.fromRGB(0, 0, 0)
	self.Transparency = opts.Transparency
	if self.Transparency == nil then self.Transparency = 0.2 end

	self.trackingGradients      = {}
	self.trackingTextLabels     = {}
	self.activeToggleGradients  = {}
	self.TabContainers = {}
	self.TabButtons    = {}
	self._tabs         = {}
	self.CurrentTab    = nil
	self.IsMinimized   = false
	self.IsTransitioning = false
	self.PreMinimizeSize = nil
	self.PreMinimizeChildren = {}
	self._connections = {}

	-- pick parent (CoreGui if available)
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	local targetGui = (ok and core) or Players.LocalPlayer:WaitForChild("PlayerGui", 5) or Players.LocalPlayer:WaitForChild("PlayerGui")
	if targetGui:FindFirstChild("ThunderUI_" .. self.Name) then
		pcall(function() targetGui["ThunderUI_" .. self.Name]:Destroy() end)
	end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "ThunderUI_" .. self.Name
	ScreenGui.Parent = targetGui
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.ScreenGui = ScreenGui

	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.Parent = ScreenGui
	MainFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	MainFrame.BackgroundTransparency = self.Transparency
	MainFrame.Position = UDim2.new(0.5, -240, 0.5, -160)
	MainFrame.Size = UDim2.new(0, 480, 0, 320)
	MainFrame.Active = true
	MainFrame.BorderSizePixel = 0
	self.MainFrame = MainFrame

	local UICorner_Main = Instance.new("UICorner")
	UICorner_Main.CornerRadius = UDim.new(0, 10)
	UICorner_Main.Parent = MainFrame

	self.BackgroundGradient = self:applyThemeGradient(MainFrame)

	-- Left menu
	local LeftMenu = Instance.new("Frame")
	LeftMenu.Name = "LeftMenu"
	LeftMenu.Parent = MainFrame
	LeftMenu.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	LeftMenu.BackgroundTransparency = 0.95
	LeftMenu.Position = UDim2.new(0, 6, 0, 6)
	LeftMenu.Size = UDim2.new(0, 130, 0, 308)
	LeftMenu.ZIndex = 2
	LeftMenu.BorderSizePixel = 0
	self.LeftMenu = LeftMenu

	local UICorner_Left = Instance.new("UICorner")
	UICorner_Left.CornerRadius = UDim.new(0, 8)
	UICorner_Left.Parent = LeftMenu

	local UIListLayout_Menu = Instance.new("UIListLayout")
	UIListLayout_Menu.Parent = LeftMenu
	UIListLayout_Menu.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout_Menu.Padding = UDim.new(0, 4)

	-- Title header (drag handle + minimize on click)
	local TitleHeader = Instance.new("TextButton")
	TitleHeader.Name = "TitleHeader"
	TitleHeader.Parent = LeftMenu
	TitleHeader.BackgroundTransparency = 1
	TitleHeader.Size = UDim2.new(1, 0, 0, 44)
	TitleHeader.Text = ""
	TitleHeader.AutoButtonColor = false
	self.TitleHeader = TitleHeader

	local AnimatedImage = Instance.new("ImageLabel")
	AnimatedImage.Parent = TitleHeader
	AnimatedImage.BackgroundTransparency = 1
	AnimatedImage.Position = UDim2.new(0, 8, 0, 10)
	AnimatedImage.Size = UDim2.new(0, 24, 0, 24)
	AnimatedImage.Image = self.Logo1
	self.AnimatedImage = AnimatedImage

	self.LogoGradient = Instance.new("UIGradient")
	self.LogoGradient.Name = "LogoTextGradient"
	self.LogoGradient.Parent = AnimatedImage

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Name = "NameLabel"
	NameLabel.Parent = TitleHeader
	NameLabel.BackgroundTransparency = 1
	NameLabel.Position = UDim2.new(0, 38, 0, 0)
	NameLabel.Size = UDim2.new(1, -38, 1, 0)
	NameLabel.Font = Enum.Font.GothamBold
	NameLabel.Text = self.Name:upper()
	NameLabel.TextSize = 13
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	self:registerTextLabel(NameLabel)
	self.NameLabel = NameLabel

	self.NameLabelGrad = Instance.new("UIGradient")
	self.NameLabelGrad.Name = "TitleTextGradient"
	self.NameLabelGrad.Parent = NameLabel

	-- animate logo between two images
	task.spawn(function()
		while task.wait(0.15) do
			if ScreenGui and ScreenGui.Parent and AnimatedImage and AnimatedImage.Parent then
				AnimatedImage.Image = (AnimatedImage.Image == self.Logo1) and self.Logo2 or self.Logo1
			else
				break
			end
		end
	end)

	-- dragging + minimize
	self:ConnectDraggingAndMinimize(MainFrame, TitleHeader)

	self:UpdateGlobalTheme()
	return self
end

function ThunderUI:applyThemeGradient(parent)
	local uiGradient = Instance.new("UIGradient")
	uiGradient.Color = getGradientSequence(self.themeLeft, self.themeRight)
	uiGradient.Parent = parent
	table.insert(self.trackingGradients, uiGradient)
	return uiGradient
end

function ThunderUI:registerTextLabel(label)
	table.insert(self.trackingTextLabels, label)
end

function ThunderUI:UpdateGlobalTheme()
	local sequence = getGradientSequence(self.themeLeft, self.themeRight)
	local adaptedColor = getAdaptiveTextColor(self.themeLeft, self.themeRight)

	for _, grad in ipairs(self.trackingGradients) do
		if grad and grad.Parent
			and grad.Name ~= "TitleTextGradient"
			and grad.Name ~= "LogoTextGradient"
			and grad.Name ~= "ActiveToggleGrad" then
			pcall(function() grad.Color = sequence end)
		end
	end

	local titleSeq = getGradientSequence(self.titleLeft, self.titleRight)
	if self.NameLabelGrad then pcall(function() self.NameLabelGrad.Color = titleSeq end) end
	if self.LogoGradient  then pcall(function() self.LogoGradient.Color  = titleSeq end) end

	for _, tGrad in ipairs(self.activeToggleGradients) do
		if tGrad and tGrad.Parent then pcall(function() tGrad.Color = titleSeq end) end
	end

	for _, lbl in ipairs(self.trackingTextLabels) do
		if lbl and lbl.Parent then
			if lbl.Name == "SecLabel" then
				lbl.TextColor3 = (adaptedColor.R < 0.5) and Color3.fromRGB(80, 75, 90) or Color3.fromRGB(120, 120, 130)
			elseif lbl.Name == "SliderValue" then
				lbl.TextColor3 = (adaptedColor.R < 0.5) and Color3.fromRGB(70, 70, 80) or Color3.fromRGB(100, 100, 110)
			elseif lbl.Name == "NameLabel" then
				lbl.TextColor3 = self.titleLeft
			else
				lbl.TextColor3 = adaptedColor
			end
		end
	end
end

function ThunderUI:SetTheme(left, right)
	self.themeLeft  = left  or self.themeLeft
	self.themeRight = right or self.themeRight
	self:UpdateGlobalTheme()
end

function ThunderUI:SetTitleColor(left, right)
	self.titleLeft  = left  or self.titleLeft
	self.titleRight = right or self.titleRight
	self:UpdateGlobalTheme()
end

function ThunderUI:SetTransparency(v)
	self.Transparency = math.clamp(v, 0, 1)
	if self.MainFrame then self.MainFrame.BackgroundTransparency = self.Transparency end
end

function ThunderUI:ConnectDraggingAndMinimize(frame, dragButton)
	local activeInput = nil
	local dragStart, startPos
	local touchStartTime, touchStartPos
	local isDragging = false

	dragButton.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeInput then
			activeInput = input
			dragStart = input.Position
			startPos = frame.Position
			touchStartTime = os.clock()
			touchStartPos = input.Position
			isDragging = false
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if input == activeInput and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 5 then
				isDragging = true
				frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input == activeInput then
			local timeDelta = os.clock() - touchStartTime
			local distanceDelta = (input.Position - touchStartPos).Magnitude
			activeInput = nil
			if not isDragging and distanceDelta < 7 and timeDelta < 0.35 then
				self:ToggleMinimize()
			end
		end
	end)
end

function ThunderUI:ToggleMinimize()
	if self.IsTransitioning then return end
	if self.IsMinimized then self:Restore() else self:Minimize() end
end

function ThunderUI:Minimize()
	if self.IsTransitioning or self.IsMinimized then return end
	self.IsTransitioning = true
	self.IsMinimized = true
	local frame, LeftMenu, TitleHeader, AnimatedImage, NameLabel = self.MainFrame, self.LeftMenu, self.TitleHeader, self.AnimatedImage, self.NameLabel

	self.PreMinimizeSize = frame.Size
	for _, child in pairs(frame:GetChildren()) do
		if child ~= LeftMenu and child:IsA("GuiObject") then
			self.PreMinimizeChildren[child] = child.Visible
			child.Visible = false
		end
	end
	for _, child in pairs(LeftMenu:GetChildren()) do
		if child ~= TitleHeader and child:IsA("GuiObject") then
			self.PreMinimizeChildren[child] = child.Visible
			child.Visible = false
		end
	end

	TitleHeader.Size = UDim2.new(1, 0, 0, 24)
	AnimatedImage.Position = UDim2.new(0, 6, 0, 4)
	AnimatedImage.Size = UDim2.new(0, 16, 0, 16)
	NameLabel.Position = UDim2.new(0, 28, 0, 0)
	NameLabel.Size = UDim2.new(1, -28, 1, 0)
	NameLabel.TextSize = 11
	LeftMenu.BackgroundTransparency = 1

	local closeTween = TS:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 110, 0, 36) })
	closeTween:Play()
	closeTween.Completed:Connect(function()
		LeftMenu.Size = UDim2.new(0, 98, 0, 24)
		self.IsTransitioning = false
	end)
end

function ThunderUI:Restore()
	if self.IsTransitioning or not self.IsMinimized then return end
	self.IsTransitioning = true
	self.IsMinimized = false
	local frame, LeftMenu, TitleHeader, AnimatedImage, NameLabel = self.MainFrame, self.LeftMenu, self.TitleHeader, self.AnimatedImage, self.NameLabel

	TitleHeader.Size = UDim2.new(1, 0, 0, 44)
	AnimatedImage.Position = UDim2.new(0, 8, 0, 10)
	AnimatedImage.Size = UDim2.new(0, 24, 0, 24)
	NameLabel.Position = UDim2.new(0, 38, 0, 0)
	NameLabel.Size = UDim2.new(1, -38, 1, 0)
	NameLabel.TextSize = 13
	LeftMenu.BackgroundTransparency = 0.88
	LeftMenu.Size = UDim2.new(0, 130, 0, 308)

	local openTween = TS:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = self.PreMinimizeSize or UDim2.new(0, 480, 0, 320) })
	openTween:Play()
	openTween.Completed:Connect(function()
		for child, wasVisible in pairs(self.PreMinimizeChildren) do
			if child and child.Parent then child.Visible = wasVisible end
		end
		self.PreMinimizeChildren = {}
		for name, frameItem in pairs(self.TabContainers) do
			frameItem.Visible = (name == self.CurrentTab)
		end
		self.IsTransitioning = false
	end)
end

function ThunderUI:Destroy()
	pcall(function() if self.ScreenGui then self.ScreenGui:Destroy() end end)
end

--------------------------------------------------------------------------------
-- Tab content frame
--------------------------------------------------------------------------------
function ThunderUI:_CreateTabFrame(tabName)
	local ContentFrame = Instance.new("ScrollingFrame")
	ContentFrame.Name = tabName .. "_Content"
	ContentFrame.Parent = self.MainFrame
	ContentFrame.BackgroundTransparency = 1
	ContentFrame.Position = UDim2.new(0, 142, 0, 6)
	ContentFrame.Size = UDim2.new(0, 332, 0, 308)
	ContentFrame.ZIndex = 2
	ContentFrame.Visible = (tabName == self.CurrentTab)
	ContentFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	ContentFrame.ScrollBarThickness = 2
	ContentFrame.ScrollBarImageColor3 = self.titleLeft
	ContentFrame.BorderSizePixel = 0

	local UIListLayout_Content = Instance.new("UIListLayout")
	UIListLayout_Content.Parent = ContentFrame
	UIListLayout_Content.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout_Content.Padding = UDim.new(0, 6)

	UIListLayout_Content:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if ContentFrame and UIListLayout_Content then
			ContentFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout_Content.AbsoluteContentSize.Y + 15)
		end
	end)

	self.TabContainers[tabName] = ContentFrame
	return ContentFrame
end

--------------------------------------------------------------------------------
-- Tab object
--------------------------------------------------------------------------------
local Tab = {}
Tab.__index = Tab

function ThunderUI:CreateTab(name)
	if self._tabs[name] then return self._tabs[name] end
	if not self.CurrentTab then self.CurrentTab = name end
	self:_CreateTabFrame(name)

	local TabBtn = Instance.new("TextButton")
	local UICorner_Tab = Instance.new("UICorner")
	TabBtn.Parent = self.LeftMenu
	TabBtn.Size = UDim2.new(1, -12, 0, 28)
	TabBtn.Font = Enum.Font.GothamSemibold
	TabBtn.Text = "   " .. name
	TabBtn.TextXAlignment = Enum.TextXAlignment.Left
	TabBtn.TextSize = 11
	TabBtn.ZIndex = 2
	TabBtn.BorderSizePixel = 0
	UICorner_Tab.CornerRadius = UDim.new(0, 4)
	UICorner_Tab.Parent = TabBtn

	local window = self
	local function renderTabState()
		if not TabBtn then return end
		if window.CurrentTab == name then
			TabBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			TabBtn.BackgroundTransparency = 0.9
			TabBtn.TextColor3 = window.titleLeft
		else
			TabBtn.BackgroundTransparency = 1
			TabBtn.TextColor3 = Color3.fromRGB(120, 120, 130)
		end
	end

	TabBtn.MouseButton1Click:Connect(function()
		window.CurrentTab = name
		for tName, frame in pairs(window.TabContainers) do
			if frame then frame.Visible = (tName == window.CurrentTab) end
		end
		for _, btnUpdate in pairs(window.TabButtons) do pcall(btnUpdate) end
	end)

	table.insert(self.TabButtons, renderTabState)
	renderTabState()

	local t = setmetatable({ Window = self, Name = name, Frame = self.TabContainers[name] }, Tab)
	self._tabs[name] = t
	return t
end

