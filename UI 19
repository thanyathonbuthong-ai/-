--[[
	Nebula UI Library v1.1 (fixed)
	Standalone Roblox UI library — extracted & refactored from the Young0x / FG100 hub UI.
	Preserves the original look: dark navy + cyan, animated RGB border, draggable / resizable /
	minimizable window, scrollable tab bar, full control set.

	API:
		local Library = loadstring(game:HttpGet("<raw-url>"))()
		local Window = Library:CreateWindow({ Title="...", Subtitle="...", Theme="Galaxia",
			BackgroundAsset="rbxassetid://...", MinimizeKey=Enum.KeyCode.RightShift })
		local Tab = Window:CreateTab("Main", 62)
		Tab:AddSection / AddLabel / AddInfoRow / AddButton / AddToggle / AddSlider /
		    AddDropdown / AddInput / AddKeybind  (each returns a controller with :Set/:Get)
		Window:Notify(text, sec) | Window:Minimize() | Window:Restore() | Window:Toggle()
		Window:SetTheme("Cyber") | Window:Destroy()
]]

local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

local FONT = Enum.Font.FredokaOne
local FONT_BOLD = Enum.Font.FredokaOne

local function clamp(v, mn, mx) return math.min(mx, math.max(mn, v)) end

local function tween(obj, time, props, style, dir)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

