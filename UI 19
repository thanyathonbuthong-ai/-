--[[
================================================================================
  ThunderUI  Library  (refactored from the original script's embedded UI)
================================================================================
  A reusable Roblox UI library preserving the original look & feel:
    - White gradient window, rounded corners, adaptive text color
    - Left sidebar with animated logo + title gradient
    - Tabs, scrolling content area with auto canvas sizing
    - Components: Section, Toggle, Slider, Button, Dropdown, ColorPicker
    - Draggable window + click title to minimize / restore
    - Live theme (gradient) recoloring of every tracked element
    - Top-right toast notifications

  Usage:
    local ThunderUI = loadstring(game:HttpGet("<RAW_URL>"))()

    local Window = ThunderUI:CreateWindow({
        Name         = "My Hub",
        Logo1        = "rbxassetid://114689234510484", -- optional
        Logo2        = "rbxassetid://90198312672402",  -- optional (animated swap)
        ThemeLeft    = Color3.fromRGB(255, 255, 255),
        ThemeRight   = Color3.fromRGB(255, 255, 255),
        TitleLeft    = Color3.fromRGB(0, 0, 0),
        TitleRight   = Color3.fromRGB(0, 0, 0),
        Transparency = 0.2,
    })

    local Tab = Window:CreateTab("Main")
    Tab:CreateSection("Hello World")
    Tab:CreateToggle({ Name = "Auto Parry", Default = false, Callback = function(v) print(v) end })
    Tab:CreateSlider({ Name = "Accuracy", Min = 0, Max = 100, Default = 100, Suffix = "%", Callback = function(v) print(v) end })
    Tab:CreateButton({ Name = "Click Me", Callback = function() print("clicked") end })
    Tab:CreateDropdown({ Name = "Curve", Options = {"A","B","C"}, Default = "A", Callback = function(v) print(v) end })
    Tab:CreateColorPicker({ Name = "Accent", Default = Color3.fromRGB(255,0,0), Callback = function(c) print(c) end })

    ThunderUI:Notify({ Title = "Loaded", Text = "Welcome", Duration = 3 })

  Window methods:
    Window:CreateTab(name) -> Tab
    Window:SetTheme(leftColor3, rightColor3)
    Window:SetTitleColor(leftColor3, rightColor3)
    Window:SetTransparency(number 0..1)
    Window:Minimize() / Window:Restore() / Window:ToggleMinimize()
    Window:Destroy()

  Component return values (all have :SetValue / :GetValue where applicable):
    Toggle   : { SetValue(bool), GetValue() }
    Slider   : { SetValue(n),    GetValue() }
    Dropdown : { Set(v), Refresh(options), GetValue() }
    Button   : { }
    ColorPicker : { SetColor(c), GetColor() }
================================================================================
]]

local ThunderUI = {}
ThunderUI.__index = ThunderUI

local UIS     = game:GetService("UserInputService")
local TS      = game:GetService("TweenService")
local Players = game:GetService("Players")

local DEFAULT_LOGO_1 = "rbxassetid://114689234510484"
local DEFAULT_LOGO_2 = "rbxassetid://90198312672402"

--------------------------------------------------------------------------------
-- Color / gradient helpers
--------------------------------------------------------------------------------
local function clamp255(n) return math.clamp(n, 0, 255) end

local function getGradientSequence(left, right)
	left  = left  or Color3.fromRGB(255, 255, 255)
	right = right or Color3.fromRGB(255, 255, 255)
	local midColor = Color3.fromRGB(
		clamp255((left.R  + right.R)  * 0.5 * 255),
		clamp255((left.G  + right.G)  * 0.5 * 255),
		clamp255((left.B  + right.B)  * 0.5 * 255)
	)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0,   left),
		ColorSequenceKeypoint.new(0.5, midColor),
		ColorSequenceKeypoint.new(1,   right),
	})
end

local function getAdaptiveTextColor(bgLeft, bgRight)
	bgLeft  = bgLeft  or Color3.fromRGB(255, 255, 255)
	bgRight = bgRight or Color3.fromRGB(255, 255, 255)
	local avgLuminance = ((bgLeft.R + bgLeft.G + bgLeft.B) / 3 + (bgRight.R + bgRight.G + bgRight.B) / 3) / 2
	if avgLuminance > 0.6 then
		return Color3.fromRGB(20, 20, 25)
	else
		return Color3.fromRGB(255, 255, 255)
	end
end

--------------------------------------------------------------------------------
-- Notification system (top-right toasts)
--------------------------------------------------------------------------------
local NotifGui = nil
local function ensureNotifGui()
	if NotifGui and NotifGui.Parent then return NotifGui end
	local target
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	target = (ok and core) or Players.LocalPlayer:WaitForChild("PlayerGui")

	NotifGui = Instance.new("ScreenGui")
	NotifGui.Name = "ThunderUI_Notifications"
	NotifGui.ResetOnSpawn = false
	NotifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	NotifGui.Parent = target

	local layout = Instance.new("UIListLayout")
	layout.Parent = NotifGui
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder

	local pad = Instance.new("UIPadding")
	pad.Parent = NotifGui
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)

	return NotifGui
end

function ThunderUI:Notify(opts)
	-- support both :Notify(opts) colon-call and .SendNotification(opts) dot-call
	if opts == nil and type(self) == "table"
		and (self.title or self.Title or self.text or self.Text or self.duration or self.Duration) then
		opts = self
	end
	opts = opts or {}
	local title    = opts.Title    or opts.title    or "Notification"
	local text     = opts.Text     or opts.text     or ""
	local duration = opts.Duration or opts.duration or 3

	local gui = ensureNotifGui()

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 240, 0, 0)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	frame.BackgroundTransparency = 0.1
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Parent = frame

	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Position = UDim2.new(0, 10, 0, 6)
	titleLbl.Size = UDim2.new(1, -20, 0, 14)
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.Text = title
	titleLbl.TextColor3 = Color3.fromRGB(0, 0, 0)
	titleLbl.TextSize = 12
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = frame

	local textLbl = Instance.new("TextLabel")
	textLbl.BackgroundTransparency = 1
	textLbl.Position = UDim2.new(0, 10, 0, 22)
	textLbl.Size = UDim2.new(1, -20, 0, 14)
	textLbl.Font = Enum.Font.Gotham
	textLbl.Text = text
	textLbl.TextColor3 = Color3.fromRGB(40, 40, 50)
	textLbl.TextSize = 11
	textLbl.TextWrapped = true
	textLbl.TextXAlignment = Enum.TextXAlignment.Left
	textLbl.Parent = frame

	local height = textLbl.TextBounds.Y > 14 and 52 or 44
	TS:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 240, 0, height) }):Play()

	task.delay(duration, function()
		local out = TS:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 240, 0, 0), BackgroundTransparency = 1 })
		out:Play()
		out.Completed:Connect(function() frame:Destroy() end)
	end)
end
-- alias used by the original script
ThunderUI.SendNotification = ThunderUI.Notify

