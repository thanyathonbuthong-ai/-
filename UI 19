	-- RGB stroke helper — one shared animation loop (no per-row RenderStepped leaks)
	local rgbGradients = {}
	track(RunService.RenderStepped:Connect(function()
		for i = #rgbGradients, 1, -1 do
			local g = rgbGradients[i]
			if g and g.Parent then
				g.Rotation = (g.Rotation + 0.6) % 360
			else
				table.remove(rgbGradients, i)
			end
		end
	end))
	local function addRgbStroke(target, thickness, transparency)
		local s = Instance.new("UIStroke")
		s.Thickness = thickness or 1
		s.Transparency = transparency or 0.5
		s.Color = C.accent
		s.Parent = target
		local g = Instance.new("UIGradient")
		g.Rotation = 45
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.accent),
			ColorSequenceKeypoint.new(0.5, C.accent2),
			ColorSequenceKeypoint.new(1, C.accent),
		})
		g.Parent = s
		table.insert(rgbGradients, g)
		return s
	end

