					ib.MouseEnter:Connect(function() tween(ib, 0.12, { BackgroundColor3 = C.rowHover }) end)
					ib.MouseLeave:Connect(function() tween(ib, 0.12, { BackgroundColor3 = C.row }) end)
					ib.MouseButton1Click:Connect(function()
						selected = v
						label.Text = titleText .. ": " .. tostring(v)
						closeList()
						for _, b2 in ipairs(itemButtons) do
							local l2 = b2:FindFirstChildOfClass("TextLabel")
							if l2 then l2.TextColor3 = (l2.Text == tostring(v)) and C.accent or C.soft end
						end
						pcall(callback, v)
					end)
					table.insert(itemButtons, ib)
					h = h + 26 + 2
				end
				list.Size = UDim2.fromOffset(math.max(140, row.AbsoluteSize.X), clamp(h, 0, 220))
			end
			buildItems()

			local function openList()
				if openDropdown and openDropdown ~= list and openDropdown.Visible then
					openDropdown.Visible = false
				end
				open = true
				openDropdown = list
				local ap = row.AbsolutePosition
				local asz = row.AbsoluteSize
				local vp = viewportSize()
				buildItems()
				local listH = list.Size.Y.Offset
				local belowY = ap.Y + asz.Y + 4
				if belowY + listH > vp.Y - 10 then
					list.Position = UDim2.fromOffset(ap.X, math.max(4, ap.Y - listH - 4))
				else
					list.Position = UDim2.fromOffset(ap.X, belowY)
				end
				list.Visible = true
				tween(arrow, 0.15, { Rotation = 180 })
			end

			local hit = Instance.new("TextButton")
			hit.Size = UDim2.fromScale(1, 1)
			hit.BackgroundTransparency = 1
			hit.Text = ""
			hit.AutoButtonColor = false
			hit.ZIndex = 16
			hit.Parent = row
			hit.MouseButton1Click:Connect(function()
				if open then closeList() else openList() end
			end)
			-- click anywhere outside closes the list
			track(UserInputService.InputBegan:Connect(function(input)
				if not open then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					task.defer(function()
						if open and list.Visible then closeList() end
					end)
				end
			end))

			local ctrl = { Row = row, List = list }
			function ctrl:Set(v)
				selected = v
				label.Text = titleText .. ": " .. tostring(v)
				buildItems()
				pcall(callback, v)
			end
			function ctrl:Get() return selected end
			function ctrl:Refresh(newValues)
				values = newValues or {}
				buildItems()
			end
			return ctrl
		end

		function tab:AddInput(titleText, placeholder, callback)
			local row = Instance.new("Frame")
			row.LayoutOrder = nextOrder(page)
			row.Parent = page
			styleRow(row, 40)
			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -16, 0, 14)
			label.Position = UDim2.fromOffset(10, 3)
			label.BackgroundTransparency = 1
			label.Text = titleText
			label.TextColor3 = C.dim
			label.Font = FONT
			label.TextSize = 11
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.ZIndex = 12
			label.Parent = row
			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, -20, 0, 20)
			box.Position = UDim2.fromOffset(10, 17)
			box.BackgroundColor3 = C.base
			box.BackgroundTransparency = 0.3
			box.BorderSizePixel = 0
			box.Text = ""
			box.PlaceholderText = placeholder or ""
			box.PlaceholderColor3 = C.dim
			box.TextColor3 = C.white
			box.Font = FONT
			box.TextSize = 12
			box.ClearTextOnFocus = false
			box.TextXAlignment = Enum.TextXAlignment.Left
			box.ZIndex = 13
			box.Parent = row
			Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)
			addRgbStroke(box, 1, 0.5)
			box.FocusLost:Connect(function(enterPressed)
				if enterPressed then pcall(callback, box.Text) end
			end)
			local ctrl = { Box = box }
			function ctrl:Set(t) box.Text = tostring(t) end
			function ctrl:Get() return box.Text end
			return ctrl
		end

		function tab:AddKeybind(text, defaultKey, callback)
			local key = defaultKey
			local row = Instance.new("Frame")
			row.LayoutOrder = nextOrder(page)
			row.Parent = page
			styleRow(row, 36)
			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -80, 1, 0)
			label.Position = UDim2.fromOffset(12, 0)
			label.BackgroundTransparency = 1
			label.Text = text
			label.TextColor3 = C.soft
			label.Font = FONT
			label.TextSize = 12
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.ZIndex = 12
			label.Parent = row
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.fromOffset(60, 24)
			btn.Position = UDim2.new(1, -70, 0.5, -12)
			btn.BackgroundColor3 = C.base
			btn.BackgroundTransparency = 0.3
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = false
			btn.Text = key and key.Name or "None"
			btn.TextColor3 = C.accent
			btn.Font = FONT_BOLD
			btn.TextSize = 11
			btn.ZIndex = 13
			btn.Parent = row
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
			local listening = false
			btn.MouseButton1Click:Connect(function()
				listening = true
				btn.Text = "..."
			end)
			track(UserInputService.InputBegan:Connect(function(input)
				if not listening then return end
				if input.UserInputType == Enum.UserInputType.Keyboard then
					key = input.KeyCode
					btn.Text = key.Name
					listening = false
					pcall(callback, key)
				end
			end))
			local ctrl = {}
			function ctrl:Get() return key end
			return ctrl
		end

		return tab
	end

	function self:SetTheme(nameOrTable)
		local preset
		if typeof(nameOrTable) == "string" then
			preset = THEMES[nameOrTable]
			self.ThemeName = nameOrTable
		elseif typeof(nameOrTable) == "table" then
			preset = nameOrTable
		end
		if not preset then return end
		for k, v in pairs(preset) do self.C[k] = v end
		self:Notify("Theme: " .. (typeof(nameOrTable) == "string" and nameOrTable or "Custom"))
	end

	function self:Destroy()
		self.Destroyed = true
		for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
		pcall(function() ScreenGui:Destroy() end)
	end

	return self
end

return Library
