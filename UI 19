        arrow.TextSize = 12
        arrow.TextColor3 = theme.text
        arrow.Text = "v"
        arrow.Parent = row
        addCorner(arrow, 4)

        local listFrame = Instance.new("Frame")
        listFrame.BackgroundColor3 = theme.panelBg2
        listFrame.BorderSizePixel = 0
        listFrame.Size = UDim2.new(1, 0, 0, 0)
        listFrame.AutomaticSize = Enum.AutomaticSize.Y
        listFrame.Visible = false
        listFrame.Parent = self.Instance
        addCorner(listFrame, 6)
        addStroke(listFrame, theme.panelBorder, 1)
        addListLayout(listFrame, 2)
        addPadding(listFrame, 4, 4, 4, 4)

        local selected
        if multi then
            selected = {}
            if typeof(opts.Default) == "table" then
                for _, v in ipairs(opts.Default) do selected[v] = true end
            end
            if opts.Id then
                Window._state[opts.Id] = {}
                for v in pairs(selected) do table.insert(Window._state[opts.Id], v) end
            end
        else
            selected = opts.Default or (opts.Options and opts.Options[1])
            if opts.Id then Window._state[opts.Id] = selected end
        end

        local function refreshLabel()
            if multi then
                local arr = {}
                for k in pairs(selected) do if selected[k] then table.insert(arr, k) end end
                table.sort(arr)
                if #arr == 0 then valueLabel.Text = "All"
                elseif #arr <= 2 then valueLabel.Text = table.concat(arr, ", ")
                else valueLabel.Text = string.format("%s +%d", arr[1], #arr - 1) end
            else
                valueLabel.Text = tostring(selected or "")
            end
        end
        refreshLabel()

        local optionButtons = {}
        for _, opt in ipairs(opts.Options or {}) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, 0, 0, 24)
            ob.BackgroundColor3 = theme.sectionBg
            ob.BackgroundTransparency = 0.6
            ob.BorderSizePixel = 0
            ob.AutoButtonColor = false
            ob.Font = Enum.Font.Gotham
            ob.TextSize = 12
            ob.TextColor3 = theme.text
            ob.TextXAlignment = Enum.TextXAlignment.Left
            ob.Text = "  " .. tostring(opt)
            ob.Parent = listFrame
            addCorner(ob, 4)
            optionButtons[opt] = ob

            local function recolor()
                local isSel
                if multi then isSel = (selected[opt] == true)
                else isSel = (selected == opt) end
                ob.TextColor3 = isSel and theme.accentHi or theme.text
            end
            recolor()

            track(ob.MouseEnter:Connect(function()
                TweenService:Create(ob, TweenInfo.new(0.12), { BackgroundTransparency = 0.3 }):Play()
            end))
            track(ob.MouseLeave:Connect(function()
                TweenService:Create(ob, TweenInfo.new(0.12), { BackgroundTransparency = 0.6 }):Play()
                recolor()
            end))
            track(ob.MouseButton1Click:Connect(function()
                if multi then
                    selected[opt] = not selected[opt]
                    local arr = {}
                    for k, v in pairs(selected) do if v then table.insert(arr, k) end end
                    if opts.Id then Window:SetState(opts.Id, arr, true) end
                else
                    selected = opt
                    if opts.Id then Window:SetState(opts.Id, selected, true) end
                end
                for name, b in pairs(optionButtons) do
                    local isSel = (multi and selected[name] == true) or (not multi and selected == name)
                    b.TextColor3 = isSel and theme.accentHi or theme.text
                end
                refreshLabel()
                if opts.Callback then pcall(opts.Callback, Window._state[opts.Id]) end
                if not multi then
                    listFrame.Visible = false
                    arrow.Text = "v"
                end
            end))
        end

        track(arrow.MouseButton1Click:Connect(function()
            listFrame.Visible = not listFrame.Visible
            arrow.Text = listFrame.Visible and "^" or "v"
        end))

        return {
            Instance = arrow,
            Set = function(_, v)
                if multi and typeof(v) == "table" then
                    selected = {}
                    for _, item in ipairs(v) do selected[item] = true end
                else
                    selected = v
                end
                if opts.Id then
                    if multi then
                        local arr = {}
                        for k in pairs(selected) do if selected[k] then table.insert(arr, k) end end
                        Window:SetState(opts.Id, arr, true)
                    else
                        Window:SetState(opts.Id, selected, true)
                    end
                end
                for name, b in pairs(optionButtons) do
                    local isSel = (multi and selected[name] == true) or (not multi and selected == name)
                    b.TextColor3 = isSel and theme.accentHi or theme.text
                end
                refreshLabel()
            end,
            Get = function()
                if multi then
                    local arr = {}
                    for k in pairs(selected) do if selected[k] then table.insert(arr, k) end end
                    return arr
                end
                return selected
            end,
        }
    end

