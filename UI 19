        local valueLabel = Instance.new("TextLabel")
        valueLabel.BackgroundTransparency = 1
        valueLabel.Position = UDim2.new(1, -80, 0, 0)
        valueLabel.Size = UDim2.fromOffset(80, 20)
        valueLabel.Font = Enum.Font.GothamBold
        valueLabel.TextSize = 12
        valueLabel.TextColor3 = theme.accentHi
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Parent = row

        local track = Instance.new("Frame")
        track.Position = UDim2.fromOffset(0, 26)
        track.Size = UDim2.new(1, 0, 0, 6)
        track.BackgroundColor3 = theme.toggleOff
        track.BorderSizePixel = 0
        track.Parent = row
        addCorner(track, 3)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.BackgroundColor3 = theme.accent
        fill.BorderSizePixel = 0
        fill.Parent = track
        addCorner(fill, 3)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Position = UDim2.new(0, 0, 0.5, 0)
        knob.BackgroundColor3 = theme.text
        knob.BorderSizePixel = 0
        knob.Parent = track
        addCorner(knob, 7)

        local minV, maxV, step = opts.Min or 0, opts.Max or 100, opts.Step or 1
        local suffix = opts.Suffix or ""
        local value = tonumber(opts.Default) or minV
        if opts.Id then Window._state[opts.Id] = value end

        local function render()
            local pct = (value - minV) / math.max(0.0001, (maxV - minV))
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valueLabel.Text = tostring(value) .. suffix
        end
        render()

        local dragging = false
        local function apply(xPos)
            local absX = track.AbsolutePosition.X
            local absW = track.AbsoluteSize.X
            local pct = math.clamp((xPos - absX) / math.max(1, absW), 0, 1)
            local raw = minV + pct * (maxV - minV)
            local snapped = math.floor((raw - minV) / step + 0.5) * step + minV
            snapped = math.clamp(snapped, minV, maxV)
            if snapped ~= value then
                value = snapped
                if opts.Id then Window:SetState(opts.Id, value, true) end
                render()
                if opts.Callback then pcall(opts.Callback, value) end
            end
        end

        track(track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                apply(input.Position.X)
            end
        end))
        track(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                apply(input.Position.X)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))

        return {
            Instance = track,
            Set = function(_, v)
                value = math.clamp(tonumber(v) or minV, minV, maxV)
                if opts.Id then Window:SetState(opts.Id, value, true) end
                render()
            end,
            Get = function() return value end,
        }
    end

    -- ---------- Dropdown (single / multi) ----------
    function SectionMethods.CreateDropdown(self, opts)
        opts = opts or {}
        local multi = (opts.Multi == true)
        local row = createRow(self.Instance, 34)

        local title = Instance.new("TextLabel")
