	-- refresh tab visuals (active highlight)
	local function refreshTabs(activeName)
		for _, tabBtn in ipairs(TabBar:GetChildren()) do
			if tabBtn:IsA("TextButton") then
				local isActive = tabBtn.Name == activeName
				tween(tabBtn, 0.2, { BackgroundColor3 = isActive and C.tabOn or C.tab })
				local lbl = tabBtn:FindFirstChildOfClass("TextLabel")
				if lbl then tween(lbl, 0.2, { TextColor3 = isActive and C.accent or C.dim }) end
				local ind = tabBtn:FindFirstChild("ActiveIndicator")
				if ind then tween(ind, 0.2, { BackgroundTransparency = isActive and 0 or 1 }) end
			end
		end
	end
	self._refreshTabs = refreshTabs

