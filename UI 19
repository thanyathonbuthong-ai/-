function Library:CreateWindow(options)
	options = options or {}
	local self = setmetatable({}, Library)
	self.Destroyed = false
	self.Tabs = {}
	self.ThemeName = typeof(options.Theme) == "string" and options.Theme or "Galaxia"
	self.C = {}
	-- merge theme
	local preset = THEMES[self.ThemeName] or THEMES.Galaxia
	for k, v in pairs(preset) do self.C[k] = v end
