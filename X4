function UIModule:CreateSlider(
    txt,
    min,
    max,
    default,
    cb,
    parentFrame
)

    local targetParent =
        parentFrame or self.Content

    min = min or 0
    max = max or 100

    default =
        math.clamp(
            default or min,
            min,
            max
        )

    --------------------------------------------------

    local frame =
        Instance.new("Frame")

    frame.Name = "Slider"

    frame.Size =
        UDim2.new(0.96, 0, 0, 54)

    frame.BackgroundColor3 =
        THEME.ContainerBg

    frame.BackgroundTransparency = 0.08

    frame.BorderSizePixel = 0

    frame.Parent =
        targetParent

    addCorner(frame, 9)

    --------------------------------------------------

    local stroke =
        addStroke(
            frame,
            1,
            0.55
        )

    addGradient(
        stroke,
        THEME.AccentCyan,
        THEME.AccentPurple
    )

    --------------------------------------------------
    -- LABEL
    --------------------------------------------------

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.new(1, -20, 0, 20)

    label.Position =
        UDim2.new(0, 10, 0, 5)

    label.BackgroundTransparency = 1

    label.Text =
        tostring(txt or "Value")
        .. ": "
        .. tostring(default)

    label.TextColor3 =
        THEME.TextPrimary

    label.Font =
        THEME.FontBody

    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Parent =
        frame

    applyTextSettings(
        label,
        8,
        13
    )

    --------------------------------------------------
    -- TRACK
    --------------------------------------------------

    local track =
        Instance.new("Frame")

    track.Name = "Track"

    track.Size =
        UDim2.new(1, -24, 0, 6)

    track.Position =
        UDim2.new(0, 12, 0, 36)

    track.BackgroundColor3 =
        THEME.SwitchOff

    track.BorderSizePixel = 0

    track.Parent =
        frame

    addCorner(track, 10)

    --------------------------------------------------

    local initialPos = 0

    if max ~= min then

        initialPos =
            (default - min)
            /
            (max - min)

    end

    --------------------------------------------------
    -- FILL
    --------------------------------------------------

    local fill =
        Instance.new("Frame")

    fill.Name = "Fill"

    fill.Size =
        UDim2.new(
            initialPos,
            0,
            1,
            0
        )

    fill.BackgroundColor3 =
        THEME.AccentCyan

    fill.BorderSizePixel = 0

    fill.Parent =
        track

    addCorner(fill, 10)

    addGradient(
        fill,
        THEME.AccentCyan,
        THEME.AccentPurple,
        0
    )

    --------------------------------------------------
    -- KNOB
    --------------------------------------------------

    local knob =
        Instance.new("Frame")

    knob.Name = "Knob"

    knob.Size =
        UDim2.new(0, 16, 0, 16)

    knob.AnchorPoint =
        Vector2.new(0.5, 0.5)

    knob.Position =
        UDim2.new(
            initialPos,
            0,
            0.5,
            0
        )

    knob.BackgroundColor3 =
        THEME.TextPrimary

    knob.BorderSizePixel = 0

    knob.Parent =
        track

    addCorner(knob, 20)

    local knobStroke =
        addStroke(
            knob,
            1.5,
            0
        )

    knobStroke.Color =
        THEME.AccentCyan

    --------------------------------------------------
    -- DRAGGING
    --------------------------------------------------

    local dragging = false

    local function updateVal(input)

        local absoluteSizeX =
            track.AbsoluteSize.X

        if absoluteSizeX <= 0 then
            return
        end

        local pos =
            math.clamp(
                (
                    input.Position.X
                    -
                    track.AbsolutePosition.X
                )
                /
                absoluteSizeX,
                0,
                1
            )

        local val =
            math.floor(
                min
                +
                (
                    max - min
                )
                *
                pos
            )

        fill.Size =
            UDim2.new(
                pos,
                0,
                1,
                0
            )

        knob.Position =
            UDim2.new(
                pos,
                0,
                0.5,
                0
            )

        label.Text =
            tostring(txt or "Value")
            .. ": "
            .. tostring(val)

        if cb then
            cb(val)
        end

    end

    --------------------------------------------------

    track.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            input.UserInputType ==
            Enum.UserInputType.Touch then

            dragging = true

            updateVal(input)

        end

    end)

    --------------------------------------------------

    table.insert(
        self.Connections,

        UIS.InputEnded:Connect(function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or
                input.UserInputType ==
                Enum.UserInputType.Touch then

                dragging = false

            end

        end)
    )

    --------------------------------------------------

    table.insert(
        self.Connections,

        UIS.InputChanged:Connect(function(input)

            if dragging
                and
                (
                    input.UserInputType ==
                        Enum.UserInputType.MouseMovement
                    or
                    input.UserInputType ==
                        Enum.UserInputType.Touch
                ) then

                updateVal(input)

            end

        end)
    )

    return frame
end

