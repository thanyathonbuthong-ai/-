function TrackAnimations(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local anim = hum:WaitForChild('Animator', 5)
    if not anim then return end

    anim.AnimationPlayed:Connect(function(track)
        if isUnloaded then return end
        if table.find(GameData.AttackAnimations, track.Animation.AnimationId) then
            if Window.Flags.AutoBlockToggle.CurrentValue and HasAbilityReady("Block") and not IsKiller() then
                Block()
                WindUI:Notify({ Title = "Auto Block", Content = "บล็อกการโจมตีสำเร็จ!", Duration = 3, Icon = "shield-check" })
            end
        end
    end)
end

