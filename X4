function cfgmanager()
    if not isfile("AmberCoreautoload.txt") then writefile("AmberCoreautoload.txt", activeConfigFile) end
    local allConfigs
    local function refreshcfgs() allConfigs = HttpService:JSONDecode(readfile("AmberCoreconfigs.json")) end
    refreshcfgs()
    ConfigsTab:CreateSection('Configurations')
    local currentConfig = readfile("AmberCoreautoload.txt")
    local newConfigName = "NewConfig"
    local dropdown = ConfigsTab:CreateDropdown{
        Name='Selected Config',
        Options=(function() local t={} for k in pairs(allConfigs) do table.insert(t,k) end return t end)(),
        CurrentOption={currentConfig},
        Flag='currentcfgselect',
        Callback=function(v) currentConfig = v[1] end
    }
    ConfigsTab:CreateButton{Name='Overwrite Selected', Callback=function()
        Window.Flags.currentcfgname = {CurrentValue=""}
        Window.Flags.currentcfgselect = {CurrentOption={currentConfig}}
        local copy = deepcopy(HttpService:JSONDecode(readfile('AmberCoreconfigs.json')))
        copy[currentConfig] = deepcopy(Window.Flags)
        writefile("AmberCoreconfigs.json", HttpService:JSONEncode(copy))
        UILibrary:Notify{Title='Done', Content='Config saved.', Duration=15, Image='scroll'}
    end}
    ConfigsTab:CreateInput{Name="Config Name", CurrentValue=newConfigName, PlaceholderText="Text", Flag="currentcfgname", Callback=function(v) newConfigName = v .. '.json' end}
    ConfigsTab:CreateButton{Name='Save Config', Callback=function()
        local copy = deepcopy(HttpService:JSONDecode(readfile('AmberCoreconfigs.json')))
        if copy[newConfigName] then return UILibrary:Notify{Title='Fail', Content='Config already exists. Refresh list, then overwrite it.', Duration=15, Image='scroll'} end
        Window.Flags.currentcfgname = {CurrentValue=""}
        Window.Flags.currentcfgselect = {CurrentOption={newConfigName}}
        copy[newConfigName] = deepcopy(Window.Flags)
        writefile("AmberCoreconfigs.json", HttpService:JSONEncode(copy))
        UILibrary:Notify{Title='Done', Content='Config saved.', Duration=15, Image='scroll'}
    end}
    ConfigsTab:CreateButton{Name='Delete Selected', Callback=function()
        if currentConfig == ("AmberCore-default-" .. LocalPlayer.Name .. ".json") then return UILibrary:Notify{Title='Error', Content='You cannot delete the default config for an account.', Duration=15, Image='scroll'} end
        local copy = deepcopy(HttpService:JSONDecode(readfile('AmberCoreconfigs.json')))
        copy[currentConfig] = nil
        writefile("AmberCoreconfigs.json", HttpService:JSONEncode(copy))
        UILibrary:Notify{Title='Done', Content='Config deleted.', Duration=15, Image='scroll'}
    end}
    ConfigsTab:CreateButton{Name='Load Selected', Callback=function()
        writefile("AmberCoreautoload.txt", currentConfig)
        Unload()
        loadstring(game:HttpGet('https://raw.githubusercontent.com/aibabylaugh/catsaken-real-script-not-assets/refs/heads/main/obfuscated-1448974601077002340.lua'))()
    end}
    ConfigsTab:CreateButton{Name='Refresh List', Callback=function()
        refreshcfgs()
        dropdown.Refresh((function() local t={} for k in pairs(allConfigs) do table.insert(t,k) end return t end)())
    end}
    ConfigsTab:CreateLabel("To put Auto-Load on a configuration, simply select that configuration and load it, and then it will become your Auto-Load.")
end

