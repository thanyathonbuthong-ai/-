    textBox.BackgroundColor3 =
        THEME.InputBg

    textBox.BackgroundTransparency = 0

    textBox.BorderSizePixel = 0

    textBox.Text = ""

    textBox.PlaceholderText =
        placeholder or "Enter..."

    textBox.PlaceholderColor3 =
        THEME.TextMuted

    textBox.TextColor3 =
        THEME.AccentCyan

    textBox.Font =
        THEME.FontBody

    textBox.ClearTextOnFocus = false

    textBox.Parent =
        frame

    addCorner(
        textBox,
        7
    )

    --------------------------------------------------

    local boxStroke =
        addStroke(
            textBox,
            1,
            0.65
        )

    boxStroke.Color =
        THEME.AccentCyan

    --------------------------------------------------

    applyTextSettings(
        textBox,
        8,
        13
    )

    --------------------------------------------------

    textBox.Focused:Connect(
        function()

            tween(
                boxStroke,
                TweenInfo.new(0.2),
                {
                    Transparency = 0
                }
            )

        end
    )

    --------------------------------------------------

    textBox.FocusLost:Connect(
        function(enterPressed)

            tween(
                boxStroke,
                TweenInfo.new(0.2),
                {
                    Transparency = 0.65
                }
            )

            if cb then
                cb(
                    textBox.Text,
                    enterPressed
                )
            end

        end
    )

    return frame
end

--------------------------------------------------
-- KEYBIND
--------------------------------------------------

function UIModule:CreateKeybind(
    txt,
    defaultKey,
    cb,
    parentFrame
)

    local targetParent =
        parentFrame or self.Content

    local currentKey =
        defaultKey
        or
        Enum.KeyCode.E

    local listening = false

    --------------------------------------------------

    local btn =
        Instance.new("TextButton")

    btn.Name = "Keybind"

    btn.Size =
        UDim2.new(
            0.96,
            0,
            0,
            42
        )

    btn.BackgroundColor3 =
        THEME.ContainerBg

    btn.BackgroundTransparency = 0.08

    btn.BorderSizePixel = 0

    btn.Text = ""

    btn.AutoButtonColor = false

    btn.Parent =
        targetParent

    addCorner(
        btn,
        9
    )

    --------------------------------------------------

    local stroke =
        addStroke(
            btn,
            1,
            0.55
        )

    addGradient(
        stroke,
        THEME.AccentCyan,
        THEME.AccentPurple
    )

    --------------------------------------------------
    -- LABEL
    --------------------------------------------------

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.new(
            0.6,
            0,
            1,
            0
        )

    label.Position =
        UDim2.new(
            0,
            12,
            0,
            0
        )

    label.BackgroundTransparency = 1

    label.Text =
        txt or "Keybind"

    label.TextColor3 =
        THEME.TextPrimary

    label.Font =
        THEME.FontBody

    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Parent =
        btn

    applyTextSettings(
        label,
        8,
        13
    )

    --------------------------------------------------
    -- KEY BOX
    --------------------------------------------------

    local keyBox =
        Instance.new("TextLabel")

    keyBox.Name =
        "Key"

    keyBox.Size =
        UDim2.new(
            0.35,
            -8,
            0,
            28
        )

    keyBox.Position =
        UDim2.new(
            0.65,
            0,
            0.5,
            -14
        )

    keyBox.BackgroundColor3 =
        THEME.InputBg

    keyBox.Text =
        currentKey.Name

    keyBox.TextColor3 =
        THEME.AccentCyan

    keyBox.Font =
        THEME.FontBody

    keyBox.Parent =
        btn

    addCorner(
        keyBox,
        7
    )

    --------------------------------------------------

    local keyStroke =
        addStroke(
            keyBox,
            1,
            0.65
        )

    keyStroke.Color =
        THEME.AccentCyan

    --------------------------------------------------

    applyTextSettings(
        keyBox,
        8,
        12
    )

    --------------------------------------------------
    -- CLICK TO LISTEN
    --------------------------------------------------

    btn.MouseButton1Click:Connect(
        function()

            listening = true

            keyBox.Text = "..."

            keyBox.TextColor3 =
                THEME.AccentPurple

        end
    )

    --------------------------------------------------
    -- INPUT
    --------------------------------------------------

    table.insert(
        self.Connections,

        UIS.InputBegan:Connect(
            function(input, gpe)

                if listening and not gpe then

                    if input.UserInputType ==
                        Enum.UserInputType.Keyboard then

                        currentKey =
                            input.KeyCode

                        keyBox.Text =
                            currentKey.Name

                        keyBox.TextColor3 =
                            THEME.AccentCyan

                        listening = false

                        if cb then
                            cb(currentKey)
                        end

                    end

                end

            end
        )
    )

    return btn
end

--------------------------------------------------
-- RETURN MODULE
--------------------------------------------------

return UIModule
