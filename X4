local function equipUid(uid)
    local tool =
        waitForTool(
            uid,
            2.5
        )

    if not tool then
        return false
    end

    local hum = humanoid()

    if not hum then
        return false
    end

    pcall(function()
        hum:UnequipTools()
    end)

    task.wait(0.025)

    pcall(function()
        hum:EquipTool(tool)
    end)

    local started = os.clock()

    repeat
        local char = character()

        local held =
            char
            and char:FindFirstChildOfClass(
                "Tool"
            )

        if held
            and held:GetAttribute(
                "inventoryId"
            ) == uid then

            return true
        end

        task.wait(0.015)

    until not alive()
        or os.clock() - started > 0.8

    return false
end

