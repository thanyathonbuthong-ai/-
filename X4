local isCompletingAll = false
function CompleteGenerators()
    if GameData.GameState ~= 1 or isCompletingAll or IsKiller() then return end
    isCompletingAll = true
    pcall(function()
        for _, gen in ipairs(GameData.RoundGenerators) do
            if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then continue end
            if not gen:FindFirstChild("Progress") or gen.Progress.Value == 100 then continue end
            local prompt = gen:FindFirstChild('Main') and gen.Main:FindFirstChild('Prompt')
            if not prompt then continue end
            LocalPlayer.Character.HumanoidRootPart.CFrame = gen.Positions.Center.CFrame
            repeat fireproximityprompt(prompt) Wait(0.5) until LocalPlayer.PlayerGui:FindFirstChild('PuzzleUI')
            task.wait(0.4)
            if GameData.CurrentPuzzle then AutoGenerator(GameData.CurrentPuzzle, true) end
        end
    end)
    isCompletingAll = false
    WindUI:Notify({ Title = "ทำเครื่องปั่นไฟทั้งหมด", Content = "เสร็จสิ้นกระบวนการ", Duration = 5, Icon = "cpu" })
end

