-- --- 3. Notifications System ---
function UIModule:Notify(title, text, duration)
    if not self.Gui then return end
    duration = duration or 3
    
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 50)
    card.BackgroundColor3 = THEME.Background
    card.BackgroundTransparency = 0.1
    card.Position = UDim2.new(1, 20, 0, 0)
    card.Parent = self.NotifyHolder
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = card
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.2
    stroke.Parent = card
    addCosmicGradient(stroke, THEME.AccentCyan, THEME.AccentPurple)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -16, 0, 20)
    titleLbl.Position = UDim2.new(0, 10, 0, 4)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title or "NOTIFICATION"
    titleLbl.TextColor3 = THEME.AccentCyan
    titleLbl.Font = THEME.FontTitle
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = card
    applyTextSettings(titleLbl, 8, 13)

    local bodyLbl = Instance.new("TextLabel")
    bodyLbl.Size = UDim2.new(1, -16, 0, 22)
    bodyLbl.Position = UDim2.new(0, 10, 0, 22)
    bodyLbl.BackgroundTransparency = 1
    bodyLbl.Text = text or ""
    bodyLbl.TextColor3 = THEME.TextPrimary
    bodyLbl.Font = THEME.FontBody
    bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
    bodyLbl.Parent = card
    applyTextSettings(bodyLbl, 8, 12)

    tween(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
    
    task.delay(duration, function()
        if card and card.Parent then
            local animOut = tween(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 30, 0, 0)})
            animOut.Completed:Connect(function() card:Destroy() end)
        end
    end)
end

