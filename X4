        if success then
            sold += 1

        elseif reason == "favorited" then
            protected += 1

        else
            failed += 1
        end

        task.wait(0.04)
    end

    restorePosition(
        returnPosition
    )

    resetDigEquipment()

    Busy = false

    notify(
        "Sell All",
