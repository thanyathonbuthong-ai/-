local function manageItem(uid,force)
    local allowPlace =
        force
        or Settings.AutoPlace

    local allowSell =
        force
        or Settings.AutoSell

    local returnPosition =
        savePosition()

    local item =
        findInventory(
            uid,
            refreshData()
        )

    if not item
        or item.dirty == true then

        restorePosition(
            returnPosition
        )

        return false
    end

    local newValue =
        valueFromEntry(item)

    local open =
        getOpenPedestal()

    if open then
        if allowPlace then
            local success =
                placeUid(
                    open,
                    uid
                )

            restorePosition(
                returnPosition
            )

            resetDigEquipment()

            if success then
                notify(
                    "Item Logic",
                    "Placed in open slot"
                )
            end

            return success

        elseif allowSell then
            local success,reason =
                sellUid(uid)

            restorePosition(
                returnPosition
            )

            resetDigEquipment()

            if not success then
                notify(
                    "Item Logic",
                    "Sell failed: "
                    .. tostring(reason)
                )
            end

            return success

        else
            restorePosition(
                returnPosition
            )

            resetDigEquipment()

            return true
        end
    end

    local weakest,weakestValue =
        weakestPedestal()

    if not weakest
        or newValue <= 0
        or newValue <= weakestValue then

        if allowSell then
            local success,reason =
                sellUid(uid)

            restorePosition(
                returnPosition
            )

            resetDigEquipment()

            if not success then
                notify(
                    "Item Logic",
                    "Sell failed: "
                    .. tostring(reason)
                )
            end

            return success
        end

        restorePosition(
            returnPosition
        )

        resetDigEquipment()

        return true
    end

    if not allowPlace then
        if allowSell then
            local success,reason =
                sellUid(uid)

            restorePosition(
                returnPosition
            )

            resetDigEquipment()

            if not success then
                notify(
                    "Item Logic",
                    "Sell failed: "
                    .. tostring(reason)
                )
            end

            return success
        end

        restorePosition(
            returnPosition
        )

        resetDigEquipment()

        return true
    end

    local oldUid =
        weakest:GetAttribute(
            "ItemUid"
        )

    local oldSlot =
        weakest:GetAttribute(
            "Slot"
        )

    local picked =
        pickupPedestal(
            weakest
        )

    if picked ~= oldUid then
        restorePosition(
            returnPosition
        )

        resetDigEquipment()

        notify(
            "Item Logic",
            "Pickup failed"
        )

        return false
    end

    task.wait(0.08)

    if allowSell then
        local soldOld,reason =
            sellUid(oldUid)

        if not soldOld then
            local original =
                findPedestalBySlot(
                    oldSlot
                )

            if original then
                placeUid(
                    original,
                    oldUid
                )
            end

            restorePosition(
                returnPosition
            )

            resetDigEquipment()

            notify(
                "Item Logic",
                "Old sale failed: "
                .. tostring(reason)
            )

            return false
        end
    end

    task.wait(0.06)

    local target =
        findPedestalBySlot(
            oldSlot
        )

    local placed =
        target
        and placeUid(
            target,
            uid
        )

    restorePosition(
        returnPosition
    )

    resetDigEquipment()

    if placed then
        if allowSell then
            notify(
                "Item Logic",
                "Replaced weaker item"
            )
        else
            notify(
                "Item Logic",
                "Replaced item; old item kept in inventory"
            )
        end
    end

    return placed == true
end

local function instantClean(
    item,
    manageAfter,
    forceManage
)
    if not item or not item.uid then
        return false
    end

    local uid = item.uid

    local returnPosition =
        savePosition()

    local bench =
        getWorkbench()

    if bench then
        teleportTo(bench)

        task.wait(0.08)
    end

    unequipTools()

    if not equipUid(uid) then
        restorePosition(
            returnPosition
        )

        resetDigEquipment()

        return false
    end

    local success,result =
        invoke(
            BeginCleaningRemote,
            4,
            uid
        )

    if not success then
        restorePosition(
            returnPosition
        )

        resetDigEquipment()

        return false
    end

    if type(result) == "number" then
        KnownValues[uid] = result

    elseif type(result) == "table" then
        for _,key in ipairs({
            "value",
            "Value",
            "sellValue",
            "SellValue",
            "worth",
            "Worth"
        }) do
            if type(result[key]) == "number" then
                KnownValues[uid] =
                    result[key]

                break
            end
        end
    end

    pcall(function()
        SaveCleanProgressRemote:FireServer(
            uid,
            FULL_CLEAN_MASK
        )
    end)

    task.wait(0.03)

    pcall(function()
        FinishCleaningRemote:FireServer(
            uid
        )
    end)

    local cleaned = false
    local started = os.clock()

    repeat
        local updated =
            findInventory(
                uid,
                refreshData()
            )

        if updated
            and updated.dirty == false then

            cleaned = true
            break
        end

        task.wait(0.04)

    until not alive()
        or os.clock() - started > 1.3

    restorePosition(
        returnPosition
    )

    resetDigEquipment()

    if cleaned
        and manageAfter then

        manageItem(
            uid,
            forceManage
        )
    end

    NextSearch =
        os.clock() + 0.1

    return cleaned
end

local function findDefinition(list,id)
    for _,gear in ipairs(list) do
        if gear[1] == id then
            return gear
