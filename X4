    oldGui:Destroy()
end

-- ธีมสี Cosmic Space Palette
local THEME = {
    Background = Color3.fromRGB(12, 12, 24),
    ContainerBg = Color3.fromRGB(20, 20, 38),
    ContainerHover = Color3.fromRGB(30, 30, 58),
    AccentCyan = Color3.fromRGB(0, 240, 255),
    AccentPurple = Color3.fromRGB(160, 50, 255),
    AccentRed = Color3.fromRGB(255, 55, 95),
    TextPrimary = Color3.fromRGB(240, 245, 255),
    TextMuted = Color3.fromRGB(150, 160, 190),
    FontTitle = Enum.Font.SciFi,
    FontBody = Enum.Font.GothamBold
}

-- Tween Helper
local function tween(object, info, properties)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

-- 通用 Text Settings
local function applyTextSettings(textObject, minSize, maxSize)
    textObject.TextScaled = true
    textObject.TextWrapped = true

    local oldConstraint = textObject:FindFirstChildOfClass("UITextSizeConstraint")  
    if oldConstraint then oldConstraint:Destroy() end  

    local constraint = Instance.new("UITextSizeConstraint")  
    constraint.MinTextSize = minSize or 8  
    constraint.MaxTextSize = maxSize or 16  
    constraint.Parent = textObject
end

-- Cosmic Gradient Helper
local function addCosmicGradient(parent, color1, color2)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color1 or THEME.AccentCyan),
        ColorSequenceKeypoint.new(1, color2 or THEME.AccentPurple)
    })
    gradient.Rotation = 45
    gradient.Parent = parent
    return gradient
end

-- --- 1. 建立 UI 主視窗 (:CreateWindow) ---
function UIModule.CreateWindow(titleText, footerText)
