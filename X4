-- ---------- Hitbox Expander (velocity push toward target while attacking) ----------
task.spawn(function()
    while not isUnloaded do
        pcall(function()
            if not Flags.HitboxExpander.CurrentValue then return end
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if not root or not hum then return end
            local attacking = false
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                if track.TimePosition / math.max(track.Length, 0.01) < 0.75 then
                    attacking = true
                    break
                end
            end
            if not attacking then return end
            local range = Flags.HitboxExpanderRange.CurrentValue or 60
            local target = IsKiller() and GetClosestSurvivor(range) or GetClosestKiller(range)
            if not target then return end
            local tRoot = target:FindFirstChild("HumanoidRootPart")
            if not tRoot then return end
            local ping = 0.05
            pcall(function() ping = Stats.PerformanceStats.Ping:GetValue() / 1000 end)
            local predicted = tRoot.Position + tRoot.Velocity * (ping * 1.25)
            local vel = (predicted - root.Position) / math.max(ping * 2, 0.05)
            local old = root.Velocity
            root.Velocity = vel
            RunService.RenderStepped:Wait()
            root.Velocity = old
        end)
        Wait()
    end
end)

