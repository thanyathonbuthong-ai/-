local function AddToggle(tab, name, flag, default, callback)
    default = default or false
    Flags[flag].CurrentValue = default
    tab:Toggle({
        Title = name,
        Value = default,
        Callback = function(v)
            Flags[flag].CurrentValue = v
            if callback then task.spawn(callback, v) end
        end
    })
end

local function AddButton(tab, name, callback)
    tab:Button({
        Title = name,
        Callback = function()
            if callback then task.spawn(callback) end
        end
    })
end

local function AddSlider(tab, name, flag, minv, maxv, default, increment, callback)
    default = default or minv
    Flags[flag].CurrentValue = default
    tab:Slider({
        Title = name,
        Value = { Min = minv, Max = maxv, Default = default },
        Step = increment or 1,
        Callback = function(v)
            Flags[flag].CurrentValue = v
            if callback then task.spawn(callback, v) end
        end
    })
end

local function AddDropdown(tab, name, flag, options, default, multi, callback)
    default = default or {}
    Flags[flag].CurrentOption = default
    tab:Dropdown({
        Title = name,
        Values = options or {},
        Value = multi and default or (default[1] or (options and options[1])),
        Multi = multi == true,
        Callback = function(v)
            local val = type(v) == "table" and v or {tostring(v)}
            Flags[flag].CurrentOption = val
            if callback then task.spawn(callback, val) end
        end
    })
end

local function AddSection(tab, title)
    pcall(function() tab:Section({ Title = title }) end)
end

local function AddColor(tab, name, flag, color)
    color = color or Color3.new(1,1,1)
    Flags[flag].Color = color
    pcall(function()
        tab:Colorpicker({
            Title = name,
            Default = color,
            Callback = function(c) Flags[flag].Color = c end
        })
    end)
end

local function AddInput(tab, name, flag, default, placeholder, callback)
    default = default or ""
    Flags[flag].CurrentValue = default
    tab:Input({
        Title = name,
        Value = tostring(default),
        Placeholder = placeholder or "",
        Callback = function(txt)
            Flags[flag].CurrentValue = txt
            if callback then task.spawn(callback, txt) end
        end
    })
end

