local function saveSettings(data)
    if not Caps.WriteFile then
        return
    end

    ensureFolder()

    pcall(function()
        writefile(
            SAVE_FILE,
            HttpService:JSONEncode(data)
        )
    end)
end

local function findRecursive(rootObject,name,timeout)
    local started = os.clock()
    local found = rootObject:FindFirstChild(name,true)

    while not found
        and alive()
        and os.clock() - started < (timeout or 15) do

        task.wait(0.05)

        found =
            rootObject:FindFirstChild(
                name,
                true
            )
    end

    return found
end

local function requireRecursive(name)
    local found =
        findRecursive(
            ReplicatedStorage,
            name,
            15
        )

    if not found then
        error("Missing: "..name)
    end

    return found
end

