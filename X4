local function HookEffect(mod, flagName, displayName)
    if not mod or not mod.Applied then return end
    pcall(function()
        local old = mod.Applied
        mod.Applied = newcclosure(function(...)
            if Flags[flagName] and Flags[flagName].CurrentValue then
                Notify("Anti " .. displayName, "บล็อกเอฟเฟกต์ " .. displayName, 3)
                return
            end
            return old(...)
        end)
    end)
end

