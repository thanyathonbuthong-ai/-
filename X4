        Name = "DarkMysteriousUI",
        Parent = game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui"),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
    })

    -- MAIN (fully rounded, clips everything)
    local Main = Create("Frame", {
        Name = "Main",
        Parent = ScreenGui,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = size,
        Position = UDim2.new(0.5, -width/2, 0.5, -height/2),
        ClipsDescendants = true,
        Active = true,
    })
    AddCorner(Main, Sizes.MainCorner)
    AddStroke(Main, 1.2, Theme.Stroke)
    AddGradient(Main, MainGradient, 120)

    -- Shadow
    Create("ImageLabel", {
        Name = "Shadow",
        Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, -32, 0, -32),
        Size = UDim2.new(1, 64, 1, 64),
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.4,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = 0,
    })

    -- TOP BAR (no UICorner - Main clips the corners)
    local TopBar = Create("Frame", {
        Name = "TopBar",
        Parent = Main,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Sizes.TopBarHeight),
        ZIndex = 10,
    })
    AddGradient(TopBar, TopGradient, 0)

    -- Title
    Create("TextLabel", {
        Parent = TopBar,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 7),
        Size = UDim2.new(1, -120, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = IsMobile and 16 or 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 11,
    })

    Create("TextLabel", {
        Parent = TopBar,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 27),
        Size = UDim2.new(1, -120, 0, 15),
        Font = Enum.Font.Gotham,
        Text = subtitle,
        TextColor3 = Theme.TextDark,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 11,
    })

    -- Close
    local CloseBtn = Create("TextButton", {
        Parent = TopBar,
        BackgroundColor3 = Theme.Tertiary,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -44, 0.5, -14),
        Size = UDim2.new(0, 28, 0, 28),
        Font = Enum.Font.GothamBold,
        Text = "×",
        TextColor3 = Theme.Text,
        TextSize = 18,
        AutoButtonColor = false,
        ZIndex = 11,
    })
    AddCorner(CloseBtn, 14)

    CloseBtn.MouseButton1Click:Connect(function()
        Tween(Main, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}, 0.28)
        task.wait(0.28)
        ScreenGui:Destroy()
    end)

    local function AddPress(btn, normal, press)
        btn.InputBegan:Connect(function(input)
            if IsTouch(input) then Tween(btn, {BackgroundColor3 = press}, 0.1) end
        end)
        btn.InputEnded:Connect(function(input)
            if IsTouch(input) then Tween(btn, {BackgroundColor3 = normal}, 0.15) end
        end)
    end
    AddPress(CloseBtn, Theme.Tertiary, Theme.Danger)

    -- Minimize
    local MinBtn = Create("TextButton", {
        Parent = TopBar,
        BackgroundColor3 = Theme.Tertiary,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -78, 0.5, -14),
        Size = UDim2.new(0, 28, 0, 28),
        Font = Enum.Font.GothamBold,
        Text = "−",
        TextColor3 = Theme.Text,
        TextSize = 18,
        AutoButtonColor = false,
        ZIndex = 11,
    })
    AddCorner(MinBtn, 14)
    AddPress(MinBtn, Theme.Tertiary, Color3.fromRGB(55, 55, 70))

    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        Tween(Main, {Size = minimized and UDim2.new(0, width, 0, Sizes.TopBarHeight) or size}, 0.3)
    end)

    -- ========================
    -- SMOOTH DRAG (Mobile)
    -- ========================
    local dragging, dragStart, startPos, dragInput

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            dragInput = input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    dragInput = nil
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input == dragInput
            or input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            dragInput = nil
        end
    end)

