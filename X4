    Busy = true

    local returnPosition =
        savePosition()

    local snapshot =
        inventoryEntries()

    local sold = 0
    local protected = 0
    local failed = 0

    for _,original in ipairs(snapshot) do
        if not alive() then
            break
        end

        local item =
            findInventory(
                original.uid,
                refreshData()
            )

        if not item then
            continue
        end

        if item.pedestalSlot ~= nil then
            continue
        end

        if item.favorited == true then
            protected += 1
            continue
        end

        local success,reason =
            sellUid(
                item.uid
