if Settings.AutoFarm
    and SavedIsland
    and getIslandProfile(
        SavedIsland
    ).Mode ~= "None" then

    task.delay(
        1,
        function()
            if not alive() then
                return
            end

            local toggle =
                IslandToggles[
                    SavedIsland
                ]

            if toggle then
                pcall(function()
                    toggle:Set(true)
                end)
            else
                startFarm(
                    SavedIsland
                )
            end
        end
    )
end

Rayfield:Notify({
    Title = "Dig OP",

    Content =
        ExecutorName
        .. " | Auto Farm feature toggles added | K = UI",

    Duration = 5
})
