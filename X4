function randomstring(len)
    local result = ""
    local chars = ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"):split("")
    for i = 1, len or 16 do
        result = result .. chars[math.random(1, #chars)]
    end
    return result
end

