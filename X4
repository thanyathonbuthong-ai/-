    local function addShadow(scrollingFrame)
        local shadow = Instance.new("Frame")
        shadow.Size = UDim2.new(1,0,0,80)
        shadow.Position = UDim2.new(0,0,1,-80)
        shadow.BackgroundColor3 = Color3.new(0,0,0)
        shadow.ZIndex = scrollingFrame.ZIndex + 1
        shadow.Parent = scrollingFrame.Parent
        Instance.new("UICorner", shadow).CornerRadius = UDim.new(0,5)
        local grad = Instance.new("UIGradient", shadow)
        grad.Rotation = 90
        grad.Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0,1),
            NumberSequenceKeypoint.new(1,0.6),
        }
        local function update()
            local atBottom = (scrollingFrame.CanvasPosition.Y + scrollingFrame.AbsoluteWindowSize.Y + 10) >= scrollingFrame.AbsoluteCanvasSize.Y - 1
            TweenService:Create(shadow, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {
                BackgroundTransparency = atBottom and 1 or 0
            }):Play()
        end
        scrollingFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(update)
        return shadow
    end

    local function createRipple(parent, x, y)
        local ripple = Instance.new("Frame")
        ripple.Name = "Ripple"
        ripple.AnchorPoint = Vector2.new(0.5,0.5)
        ripple.BackgroundColor3 = Color3.fromRGB(255,255,255)
        ripple.BackgroundTransparency = 0.6
        ripple.Position = UDim2.fromOffset(x, y)
        ripple.Size = UDim2.fromOffset(0,0)
        ripple.ZIndex = parent.ZIndex + 1
        local corner = Instance.new("UICorner", ripple)
        corner.CornerRadius = UDim.new(1,0)
        ripple.Parent = parent
        local size = math.sqrt(parent.AbsoluteSize.X^2 + parent.AbsoluteSize.Y^2) * 0.2
        local tween = TweenService:Create(ripple, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
        })
        tween:Play()
        tween.Completed:Connect(function() ripple:Destroy() end)
    end

    local SmoothScroll = (function()
        local RS, UIS, CAS = game:GetService("RunService"), game:GetService("UserInputService"), game:GetService("ContextActionService")
        if not RS:IsClient() then error("SmoothScroll can only be used on the client") end
        local container = RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui") or CoreGui
        local mouse = LocalPlayer:GetMouse()
        local scrollData = {}
        local scrollGui, isDragging = nil, false
        if not UIS.TouchEnabled then
            scrollGui = Instance.new("ScreenGui", container)
            scrollGui.Name = "SmoothScroll"
            RS.Heartbeat:Connect(function()
                for frame, data in pairs(scrollData) do
                    if math.abs(data.Velocity) > 0.05 then
                        data.Velocity *= data.Frict
                        if data.Axis == "X" then
                            frame.CanvasPosition = Vector2.new(frame.CanvasPosition.X + data.Velocity, frame.CanvasPosition.Y)
                            if math.abs(data.LastPos - frame.CanvasPosition.X) == 0 then data.Velocity = 0 end
                            data.LastPos = frame.CanvasPosition.X
                        else
                            frame.CanvasPosition = Vector2.new(frame.CanvasPosition.X, frame.CanvasPosition.Y + data.Velocity)
                            if math.abs(data.LastPos - frame.CanvasPosition.Y) == 0 then data.Velocity = 0 end
                            data.LastPos = frame.CanvasPosition.Y
                        end
                    end
                end
            end)
            UIS.PointerAction:Connect(function(_, delta, _, _)
                if isDragging then return end
                local objs = container:GetGuiObjectsAtPosition(mouse.X, mouse.Y)
                for _, gui in ipairs(objs) do
                    local data = scrollData[gui]
                    if data and data.Visibility.Visible then
                        data.Velocity -= data.Sens * delta.Y * (data.Inverted and -1 or 1)
                        break
                    end
                end
            end)
            CAS:BindActionAtPriority("SmoothScroll", function(_, _, input)
                if isDragging then return Enum.ContextActionResult.Pass end
                local handled = false
                local objs = container:GetGuiObjectsAtPosition(mouse.X, mouse.Y)
                for _, gui in ipairs(objs) do
                    local data = scrollData[gui]
                    if data and data.Visibility.Visible then
                        data.Velocity -= data.Sens * input.Position.Z * (data.Inverted and -1 or 1)
                        handled = true
                        break
                    end
                end
                return handled and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
            end, false, 8000, Enum.UserInputType.MouseWheel)
        end

        local Visibility = {}
        Visibility.__index = Visibility
        function Visibility.new(guiObj)
            local bindable = Instance.new("BindableEvent")
            local self = setmetatable({
                GuiObject = guiObj, Visible = nil, Changed = bindable.Event,
                _path = {}, _conn = {}, _root = nil, _visibleChanged = bindable
            }, Visibility)
            local function check()
                local visible = (self._root and self._root.Enabled or false)
                if visible then
                    for _, obj in ipairs(self._path) do
                        if not obj.Visible then visible = false break end
                    end
                end
                if visible ~= self.Visible then
                    self.Visible = visible
                    bindable:Fire(visible)
                end
            end
            local function buildPath()
                for _, c in ipairs(self._conn) do c:Disconnect() end
                local path, conns, root = {}, {}, nil
                local cur = guiObj
                while cur and (cur:IsA("GuiObject") or cur:IsA("Folder")) do
                    if cur:IsA("GuiObject") then
                        table.insert(conns, cur:GetPropertyChangedSignal("Visible"):Connect(check))
                        table.insert(path, cur)
                    end
                    cur = cur.Parent
                end
                if cur and cur:IsA("LayerCollector") then
                    table.insert(conns, cur:GetPropertyChangedSignal("เปิดใช้งาน"):Connect(check))
                    root = cur
                end
                self._path, self._conn, self._root = path, conns, root
                check()
            end
            self._ancestry = guiObj.AncestryChanged:Connect(buildPath)
            buildPath()
            return self
        end
        function Visibility.Destroy(self)
            self._visibleChanged:Fire(false)
            self._visibleChanged:Destroy()
            self._ancestry:Disconnect()
            for _, c in ipairs(self._conn) do c:Disconnect() end
        end

        local function CreateBar(frame, axis)
            axis = axis or "Y"
            if not (frame and typeof(frame) == "Instance" and frame.ClassName == "ScrollingFrame") then return end
            local btn = Instance.new("TextButton")
            btn.Name = frame.Name .. "_Scroller_" .. axis
            btn.Text = ""
            btn.BackgroundTransparency = 1
            btn.Visible = scrollData[frame].Visibility.Visible
            local absSize, absPos, thickness = frame.AbsoluteSize, frame.AbsolutePosition, frame.ScrollBarThickness
            local dragConn
            btn.MouseButton1Down:Connect(function()
                if isDragging or dragConn then return end
                isDragging = true
                local start = Vector2.new(mouse.X, mouse.Y)
                dragConn = UIS.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        local delta = Vector2.new(input.Position.X, input.Position.Y) - start
                        local ratio = (axis == "Y" and delta.Y or delta.X) / (axis == "Y" and frame.AbsoluteWindowSize.Y or frame.AbsoluteWindowSize.X)
                        local ancestor = frame:FindFirstAncestorWhichIsA("GuiBase2d")
                        local canvas = Vector2.new(
                            (frame.CanvasSize.X.Scale * ancestor.AbsoluteSize.X) + frame.CanvasSize.X.Offset,
                            (frame.CanvasSize.Y.Scale * ancestor.AbsoluteSize.Y) + frame.CanvasSize.Y.Offset
                        )
                        frame.CanvasPosition = Vector2.new(
                            frame.CanvasPosition.X + (axis == "X" and canvas.X * ratio or 0),
                            frame.CanvasPosition.Y + (axis == "Y" and canvas.Y * ratio or 0)
                        )
                        start = Vector2.new(input.Position.X, input.Position.Y)
                    end
                end)
            end)
            local endConn = UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 and dragConn then
                    isDragging = false
                    dragConn:Disconnect()
                    dragConn = nil
                end
            end)
            scrollData[frame].Visibility.Changed:Connect(function(v)
                btn.Visible = v
                if not v and dragConn then
                    isDragging = false
                    dragConn:Disconnect()
                    dragConn = nil
                end
            end)
            if axis == "X" then
                btn.Size = UDim2.new(0, absSize.X, 0, thickness)
                btn.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y - thickness)
            else
                btn.Size = UDim2.new(0, thickness, 0, absSize.Y)
                btn.Position = UDim2.new(0, frame.VerticalScrollBarPosition == Enum.VerticalScrollBarPosition.Right and absPos.X + absSize.X - thickness or absPos.X, 0, absPos.Y)
            end
            local changeConn
            changeConn = frame.Changed:Connect(function(prop)
                if not scrollData[frame] then
                    btn:Destroy()
                    changeConn:Disconnect()
                    endConn:Disconnect()
                    if dragConn then dragConn:Disconnect() end
                    return
                end
                if frame:FindFirstAncestorWhichIsA("GuiBase2d") and (prop == "AbsoluteSize" or prop == "AbsolutePosition" or prop == "CanvasSize" or prop == "ScrollBarThickness") then
                    absSize, absPos, thickness = frame.AbsoluteSize, frame.AbsolutePosition, frame.ScrollBarThickness
                    if axis == "X" then
                        btn.Size = UDim2.new(0, absSize.X, 0, thickness)
                        btn.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y - thickness)
                    else
                        btn.Size = UDim2.new(0, thickness, 0, absSize.Y)
                        btn.Position = UDim2.new(0, frame.VerticalScrollBarPosition == Enum.VerticalScrollBarPosition.Right and absPos.X + absSize.X - thickness or absPos.X, 0, absPos.Y)
                    end
                end
            end)
            btn.Parent = scrollGui
        end

        local API = {}
        function API.Enable(frame, sens, frict, inverted, axis)
            if not UIS.MouseEnabled or UIS.TouchEnabled then return end
            if typeof(frame) ~= "Instance" or frame.ClassName ~= "ScrollingFrame" then return end
            if not scrollData[frame] then
                frame.ScrollingEnabled = false
                local actives, conns = {}, {}
                for _, desc in ipairs(frame:GetDescendants()) do
                    if desc:IsA("GuiObject") then
                        actives[desc] = desc.Active
                        desc.Active = false
                        table.insert(conns, desc:GetPropertyChangedSignal("Active"):Connect(function() desc.Active = false end))
                    end
                end
                local cur = frame
                while cur and (cur:IsA("GuiObject") or cur:IsA("Folder")) do
                    if cur:IsA("GuiObject") then
                        actives[cur] = cur.Active
                        cur.Active = false
                        table.insert(conns, cur:GetPropertyChangedSignal("Active"):Connect(function() cur.Active = false end))
                    end
                    cur = cur.Parent
                end
                table.insert(conns, frame.DescendantAdded:Connect(function(desc)
                    if desc:IsA("GuiObject") then
                        scrollData[frame].Actives[desc] = desc.Active
                        desc.Active = false
                        table.insert(scrollData[frame].Connections, desc:GetPropertyChangedSignal("Active"):Connect(function() desc.Active = false end))
                    end
                end))
                if not (axis == "X" or axis == "Y") then
                    axis = (frame.CanvasSize.Y.Offset > 0 or frame.CanvasSize.Y.Scale > 0) and "Y" or "X"
                    if frame.CanvasSize.Y.Offset == 0 and frame.CanvasSize.Y.Scale == 0 and frame.CanvasSize.X.Offset == 0 and frame.CanvasSize.X.Scale == 0 then axis = "Y" end
                end
                scrollData[frame] = {
                    Connections = conns, Actives = actives, Velocity = 0, LastPos = 0,
                    Visibility = Visibility.new(frame),
                    Inverted = inverted, Axis = axis,
                    Frict = math.clamp(type(frict) == "number" and frict or 0.78, 0.2, 0.99),
                    Sens = math.clamp(type(sens) == "number" and sens or (mouse.ViewSizeY / 27), 0.01, 1e16)
                }
                CreateBar(frame, "X")
                CreateBar(frame, "Y")
            else
                scrollData[frame].Sens = math.clamp(type(sens) == "number" and sens or (mouse.ViewSizeY / 27), 0.01, 1e16)
                scrollData[frame].Frict = math.clamp(type(frict) == "number" and frict or 0.78, 0.2, 0.99)
                scrollData[frame].Inverted = inverted
            end
        end
        function API.Disable(frame)
            if scrollData[frame] then
                frame.ScrollingEnabled = true
                for _, c in ipairs(scrollData[frame].Connections) do c:Disconnect() end
                scrollData[frame].Visibility:Destroy()
                for obj, active in pairs(scrollData[frame].Actives) do obj.Active = active end
                scrollData[frame] = nil
            end
        end
        return API
    end)()

    local function AddDrag(frame, handle)
        local dragging, dragInput, dragStart, startPos
        local function update(input)
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            TweenService:Create(frame, TweenInfo.new(0.05), {Position = newPos}):Play()
        end
        handle.InputBegan:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UserInputService:GetFocusedTextBox() == nil then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        handle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then update(input) end
        end)
    end

