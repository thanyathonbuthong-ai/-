    position,
    profile
)
    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.IgnoreWater = false

    params.FilterDescendantsInstances =
        getRaycastIgnore(
            island,
            profile
        )

    return workspace:Raycast(
        position
        + Vector3.new(
            0,
            65,
            0
        ),

        Vector3.new(
            0,
            -200,
            0
        ),

        params
    )
end

local function teleportGround(
    island,
    position,
    profile
)
    if isDigging() then
        return false
    end

    local hrp = root()
    local hum = humanoid()

    if not hrp or not hum then
        return false
    end

    local result =
        groundAt(
            island,
            position,
            profile
        )

    if not result then
        return false
    end

    local offset =
        hum.HipHeight
        + hrp.Size.Y / 2
        + 0.02

    hrp.CFrame =
        CFrame.new(
            result.Position
            + Vector3.new(
                0,
                offset,
                0
            )
        )
        * hrp.CFrame.Rotation

    hrp.AssemblyLinearVelocity =
        Vector3.zero

    hrp.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

local function randomPointInPart(
    part,
    inset
)
    inset = inset or 0.15

    local halfX =
        math.max(
            0,
            part.Size.X
            * 0.5
            * (1 - inset)
        )

    local halfZ =
        math.max(
            0,
            part.Size.Z
            * 0.5
            * (1 - inset)
        )

    local x =
        halfX > 0.5
        and RNG:NextNumber(
            -halfX,
            halfX
        )
        or 0

    local z =
        halfZ > 0.5
        and RNG:NextNumber(
            -halfZ,
            halfZ
        )
        or 0

    return
        part.CFrame
        * Vector3.new(
            x,
            0,
            z
        )
end

local function getNearestNodeForProfile(
    profile
)
    local hrp = root()

    if not hrp then
        return nil
    end

    local best
    local bestDistance = math.huge
    local now = os.clock()

    for id,node in pairs(
        BuriedNodes
    ) do
        if type(node) == "table"
            and typeof(node.position)
            == "Vector3" then

            local valid = false

            for _,part in ipairs(
                profile.Parts
            ) do
                if insidePart(
                    part,
                    node.position,
                    4
                ) then

                    valid = true
                    break
                end
            end

            if valid then
                local failed =
                    FailedNodes[id]

                if not failed
                    or now >= failed then

                    local distance =
                        (
                            hrp.Position
                            - node.position
                        ).Magnitude

                    if distance
                        < bestDistance then

                        bestDistance =
                            distance

                        best = node
                    end
                end
            end
        end
    end

    return best
end

local function nextHotspot(profile)
    local parts = profile.Parts

    if #parts == 0 then
        return nil
    end

    local state =
        getIslandState(
            profile.Island
        )

    local now = os.clock()

    for _ = 1,#parts do
        state.Cursor += 1

        if state.Cursor > #parts then
            state.Cursor = 1
        end

        local part =
            parts[state.Cursor]

        local failed =
            state.FailedParts[part]

        if part.Parent
            and (
                not failed
                or now >= failed
            ) then

            return part
        end
    end

    return
        parts[
            RNG:NextInteger(
                1,
                #parts
            )
        ]
end

local function nearestZone(profile)
    local hrp = root()

    if not hrp then
        return nil
    end

    for _,part in ipairs(
        profile.Parts
    ) do
        if insidePart(
            part,
            hrp.Position,
            1
        ) then

            return part
        end
    end

    local nearest
    local nearestDistance = math.huge

    for _,part in ipairs(
        profile.Parts
    ) do
        local distance =
            (
                hrp.Position
                - part.Position
            ).Magnitude

        if distance < nearestDistance then
            nearestDistance = distance
            nearest = part
        end
    end

    return nearest
end

local function tryDig(timeout)
    CandidateLock =
        os.clock() + 1.05

    setDetectorHeld(false)

    resetDigEquipment()

    local started = os.clock()

    repeat
        if isDigging() then
            CandidateLock =
                os.clock() + 1.5

            return true
        end

        digClick()

        task.wait(0.012)

    until not alive()
        or os.clock() - started
        > (timeout or 0.65)

    local grace = os.clock()

    repeat
        if isDigging() then
            CandidateLock =
                os.clock() + 1.5

            return true
        end

        task.wait(0.006)

    until not alive()
        or os.clock() - grace > 0.18

    CandidateLock = 0

    return false
end

local function tryNode(profile,node)
    if not teleportGround(
        profile.Island,
        node.position,
        profile
    ) then

        FailedNodes[node.id] =
            os.clock() + 0.7

        return false
    end

    setDetectorHeld(true)

    task.wait(0.035)

    setDetectorHeld(false)

    if tryDig(0.65) then
        return true
    end

    FailedNodes[node.id] =
        os.clock() + 0.75

    return false
end

local function tryHotspot(profile,part)
    if not part
        or not part.Parent then

        return false
    end

    local point =
        randomPointInPart(
            part,
            0.3
        )

    if not teleportGround(
        profile.Island,
        point,
        profile
    ) then

        getIslandState(
            profile.Island
        ).FailedParts[part] =
            os.clock() + 0.35

        return false
    end

    setDetectorHeld(true)

    task.wait(0.03)

    setDetectorHeld(false)

    if tryDig(0.6) then
        return true
    end

    getIslandState(
        profile.Island
    ).FailedParts[part] =
        os.clock() + 0.4

    return false
end

local function tryZone(profile,part)
    if not part
        or not part.Parent then

        return false
    end

    local point =
        randomPointInPart(
            part,
            0.1
        )

    if not teleportGround(
        profile.Island,
        point,
        profile
    ) then

        return false
    end

    setDetectorHeld(true)

    task.wait(0.025)

    setDetectorHeld(false)

    return tryDig(0.38)
end

local function searchDig(
    oneTest,
    island
)
    if not alive()
        or Searching
        or Busy
        or isDigging() then

        return false
    end

    island =
        island or ActiveIsland

    if not island
        or not island.Parent then

        return false
    end

    local profile =
        getIslandProfile(
            island
        )

    if #profile.Parts == 0 then
        notify(
            island.Name,
            "No DigArea parts found"
        )

        return false
    end

    Searching = true

    local found = false

    while alive()
        and (
            oneTest
            or (
                Settings.AutoFarm
                and Settings.AutoDig
                and ActiveIsland == island
            )
        ) do

        if Busy or isDigging() then
            found = isDigging()
            break
        end

        local node =
            getNearestNodeForProfile(
                profile
            )

        if node then
            if tryNode(
                profile,
                node
            ) then

                found = true
                break
            end

        elseif profile.Mode == "Hotspots" then
            local hotspot =
                nextHotspot(
                    profile
                )

            if hotspot
                and tryHotspot(
                    profile,
                    hotspot
                ) then

                found = true
                break
            end

        else
            local zone =
                nearestZone(
                    profile
                )

            if zone
                and tryZone(
                    profile,
                    zone
                ) then

                found = true
                break
            end
        end

        task.wait(0.005)
    end

    Searching = false

    return found
end

