        isMinimized = not isMinimized

        if isMinimized then

            Content.Visible = false

            tween(
                Main,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = MINIMIZED_SIZE
                }
