-- Integrated Flag Management System
Window.Flags = setmetatable({}, {
    __index = function(t, k)
        return rawget(t, k) or { CurrentValue = false, Color = Color3.fromRGB(255, 255, 255), CurrentOption = {} }
    end
})

local function AddToggle(tab, name, default, flag, cb)
    Window.Flags[flag] = { CurrentValue = default }
    local saved = loadedSettings[flag]
    if saved and saved.CurrentValue ~= nil then default = saved.CurrentValue end
    Window.Flags[flag].CurrentValue = default

    local toggleElement = tab:Toggle({
        Title = name,
        Value = default,
        Callback = function(val)
            Window.Flags[flag].CurrentValue = val
            if cb then cb(val) end
        end
    })
    
    Window.Flags[flag].Set = function(_, val)
        Window.Flags[flag].CurrentValue = val
        toggleElement:SetValue(val)
    end
    
    if default and cb then task.spawn(function() cb(default) end) end
    return toggleElement
end

local function AddSlider(tab, name, min, max, inc, default, flag, suffix, cb)
    Window.Flags[flag] = { CurrentValue = default }
    local saved = loadedSettings[flag]
    if saved and saved.CurrentValue ~= nil then default = saved.CurrentValue end
    Window.Flags[flag].CurrentValue = default

    return tab:Slider({
        Title = name,
        Min = min,
        Max = max,
        Step = inc,
        Value = default,
        Suffix = suffix or "",
        Callback = function(val)
            Window.Flags[flag].CurrentValue = val
            if cb then cb(val) end
        end
    })
end

