local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local UIModule = {}
UIModule.__index = UIModule

-- 定義 UI 的唯一名稱
local GUI_NAME = "Apex_V90_Cosmic_Pro"

-- 自動刪除舊 GUI
local oldGui = CoreGui:FindFirstChild(GUI_NAME)
if oldGui then
    oldGui:Destroy()
end

-- ธีมสี Cosmic Space Palette
local THEME = {
    Background = Color3.fromRGB(12, 12, 24),
    ContainerBg = Color3.fromRGB(20, 20, 38),
    ContainerHover = Color3.fromRGB(30, 30, 58),
    AccentCyan = Color3.fromRGB(0, 240, 255),
    AccentPurple = Color3.fromRGB(160, 50, 255),
    TextPrimary = Color3.fromRGB(240, 245, 255),
    TextMuted = Color3.fromRGB(150, 160, 190),
    FontTitle = Enum.Font.SciFi,
    FontBody = Enum.Font.GothamBold
}

-- Tween Helper
local function tween(object, info, properties)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

-- 通用 Text Settings
local function applyTextSettings(textObject, minSize, maxSize)
    textObject.TextScaled = true
    textObject.TextWrapped = true

    local oldConstraint = textObject:FindFirstChildOfClass("UITextSizeConstraint")  
    if oldConstraint then oldConstraint:Destroy() end  

    local constraint = Instance.new("UITextSizeConstraint")  
    constraint.MinTextSize = minSize or 8  
    constraint.MaxTextSize = maxSize or 16  
    constraint.Parent = textObject
end

-- Cosmic Gradient Helper
local function addCosmicGradient(parent, color1, color2)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color1 or THEME.AccentCyan),
        ColorSequenceKeypoint.new(1, color2 or THEME.AccentPurple)
    })
    gradient.Rotation = 45
    gradient.Parent = parent
    return gradient
end

-- --- 1. 建立 UI 主視窗 (:CreateWindow) ---
function UIModule.CreateWindow(titleText, footerText)
    local self = setmetatable({}, UIModule)

    local ApexHub = Instance.new("ScreenGui")  
    ApexHub.Name = GUI_NAME  
    ApexHub.Parent = CoreGui  
    self.Gui = ApexHub  

    -- Container สำหรับ Notification
    local NotifyHolder = Instance.new("Frame")
    NotifyHolder.Name = "NotifyHolder"
    NotifyHolder.Size = UDim2.new(0, 250, 1, -20)
    NotifyHolder.Position = UDim2.new(1, -260, 0, 10)
    NotifyHolder.BackgroundTransparency = 1
    NotifyHolder.Parent = ApexHub
    
    local NotifyList = Instance.new("UIListLayout")
    NotifyList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    NotifyList.Padding = UDim.new(0, 8)
    NotifyList.Parent = NotifyHolder
    self.NotifyHolder = NotifyHolder

    -- 主面板  
    local Main = Instance.new("Frame")  
    Main.Parent = ApexHub  
    Main.BackgroundColor3 = THEME.Background  
    Main.BackgroundTransparency = 0.15
    Main.BorderSizePixel = 0  
    Main.Position = UDim2.new(0.5, -135, 0.5, -200)  
    Main.Size = UDim2.new(0, 270, 0, 100)  
    Main.Active = true  
    Main.ClipsDescendants = false

    local UICorner = Instance.new("UICorner")  
    UICorner.CornerRadius = UDim.new(0, 10)  
    UICorner.Parent = Main  

    -- Neon Border
    local UIStroke = Instance.new("UIStroke")  
    UIStroke.Thickness = 1.8  
    UIStroke.Transparency = 0.2
    UIStroke.Parent = Main  
    addCosmicGradient(UIStroke, THEME.AccentCyan, THEME.AccentPurple)

    -- Top Glow Bar (เส้นเรืองแสงด้านบนสุด)
    local TopBarGlow = Instance.new("Frame")
    TopBarGlow.Size = UDim2.new(1, -20, 0, 2)
    TopBarGlow.Position = UDim2.new(0, 10, 0, 0)
    TopBarGlow.BorderSizePixel = 0
    TopBarGlow.Parent = Main
    addCosmicGradient(TopBarGlow, THEME.AccentCyan, THEME.AccentPurple)

    -- 標題文字  
    local Title = Instance.new("TextLabel")  
    Title.Parent = Main  
    Title.Size = UDim2.new(1, -50, 0, 42)  
    Title.Position = UDim2.new(0, 14, 0, 0)  
    Title.Text = titleText or "COSMIC HUB"  
    Title.TextColor3 = THEME.TextPrimary  
    Title.Font = THEME.FontTitle  
    Title.BackgroundTransparency = 1  
    Title.TextXAlignment = Enum.TextXAlignment.Left  
    applyTextSettings(Title, 10, 18)  
    self.TitleLabel = Title  

    -- 內容容器 (ScrollingFrame)  
    local Content = Instance.new("ScrollingFrame")  
    Content.Parent = Main  
    Content.Position = UDim2.new(0, 10, 0, 44)  
    Content.Size = UDim2.new(1, -20, 0, 0)  
    Content.BackgroundTransparency = 1  
    Content.BorderSizePixel = 0  
    Content.ScrollBarThickness = 3
    Content.ScrollBarImageColor3 = THEME.AccentCyan
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y  
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)  
    self.Content = Content  

    local UIList = Instance.new("UIListLayout")  
    UIList.Parent = Content  
    UIList.Padding = UDim.new(0, 7)  
    UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center  
    self.UIList = UIList  

    -- 右上角縮小按鈕  
    local isMinimized = false  
    local MINIMIZED_SIZE = UDim2.new(0, 270, 0, 42)  
      
    local MinBtn = Instance.new("TextButton")  
    MinBtn.Size = UDim2.new(0, 24, 0, 24)  
    MinBtn.Position = UDim2.new(1, -32, 0, 9)  
    MinBtn.BackgroundColor3 = THEME.ContainerBg  
    MinBtn.Text = "−"  
    MinBtn.TextColor3 = THEME.AccentCyan  
    MinBtn.Font = THEME.FontBody  
    MinBtn.TextSize = 16  
    MinBtn.Parent = Main  

    local MinBtnCorner = Instance.new("UICorner")  
    MinBtnCorner.CornerRadius = UDim.new(0, 6)  
    MinBtnCorner.Parent = MinBtn  

    local MinBtnStroke = Instance.new("UIStroke")  
    MinBtnStroke.Thickness = 1  
    MinBtnStroke.Color = THEME.AccentCyan  
    MinBtnStroke.Transparency = 0.5
    MinBtnStroke.Parent = MinBtn  

    -- 自動調整高度邏輯  
    local TITLE_PADDING = 54  
    local MAX_HEIGHT = 380  

    local function updateMainSize()  
        if not isMinimized then  
            local contentHeight = UIList.AbsoluteContentSize.Y  
            local targetContentHeight = math.min(contentHeight, MAX_HEIGHT)  
            Content.Size = UDim2.new(1, -20, 0, targetContentHeight)  
            
            tween(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 270, 0, targetContentHeight + TITLE_PADDING)
            })
        end  
    end  
    self.UpdateSize = updateMainSize  
    UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateMainSize)  

    -- 縮小功能  
    MinBtn.MouseButton1Click:Connect(function()  
        isMinimized = not isMinimized  
        if isMinimized then  
            Content.Visible = false  
            tween(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = MINIMIZED_SIZE})
            MinBtn.Text = "+"  
        else  
            Content.Visible = true  
            updateMainSize()  
            MinBtn.Text = "−"  
        end  
    end)  

    -- 拖曳邏輯  
    local dragToggle, dragInput, dragStart, startPos  
    Main.InputBegan:Connect(function(input)  
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then  
            dragToggle = true  
            dragStart = input.Position  
            startPos = Main.Position  
            input.Changed:Connect(function()  
                if input.UserInputState == Enum.UserInputState.End then  
                    dragToggle = false  
                end  
            end)  
        end  
    end)  

    Main.InputChanged:Connect(function(input)  
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then  
            dragInput = input  
        end  
    end)  

    UIS.InputChanged:Connect(function(input)  
        if input == dragInput and dragToggle then  
            local delta = input.Position - dragStart  
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)  
        end  
    end)  

    -- 頁尾標籤  
    if footerText then  
        local Footer = Instance.new("TextLabel")  
        Footer.Size = UDim2.new(0.95, 0, 0, 18)  
        Footer.BackgroundTransparency = 1  
        Footer.Text = footerText  
        Footer.TextColor3 = THEME.TextMuted  
        Footer.Font = THEME.FontBody  
        Footer.Parent = Content  
        applyTextSettings(Footer, 8, 11)  
    end  

    return self
end

-- --- 2. Notifications System (ระบบแจ้งเตือนป๊อปอัป) ---
function UIModule:Notify(title, text, duration)
    duration = duration or 3
    
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 50)
    card.BackgroundColor3 = THEME.Background
    card.BackgroundTransparency = 0.1
    card.Position = UDim2.new(1, 20, 0, 0)
    card.Parent = self.NotifyHolder
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = card
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.2
    stroke.Parent = card
    addCosmicGradient(stroke, THEME.AccentCyan, THEME.AccentPurple)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -16, 0, 20)
    titleLbl.Position = UDim2.new(0, 10, 0, 4)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title or "NOTIFICATION"
    titleLbl.TextColor3 = THEME.AccentCyan
    titleLbl.Font = THEME.FontTitle
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = card
    applyTextSettings(titleLbl, 8, 13)

    local bodyLbl = Instance.new("TextLabel")
    bodyLbl.Size = UDim2.new(1, -16, 0, 22)
    bodyLbl.Position = UDim2.new(0, 10, 0, 22)
    bodyLbl.BackgroundTransparency = 1
    bodyLbl.Text = text or ""
    bodyLbl.TextColor3 = THEME.TextPrimary
    bodyLbl.Font = THEME.FontBody
    bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
    bodyLbl.Parent = card
    applyTextSettings(bodyLbl, 8, 12)

    -- Animate In
    tween(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
    
    task.delay(duration, function()
        local animOut = tween(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 30, 0, 0)})
        animOut.Completed:Connect(function()
            card:Destroy()
        end)
    end)
end

