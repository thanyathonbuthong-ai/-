    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            Tween(Main, {Size = UDim2.new(0, width, 0, Sizes.TopBarHeight)}, 0.3)
        else
            Tween(Main, {Size = size}, 0.3)
        end
