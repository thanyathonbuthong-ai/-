local Flags = {}
local function CreateFlag(name, default)
    Flags[name] = {
        CurrentValue = default,
        CurrentOption = type(default) == "table" and default or {},
        Color = typeof(default) == "Color3" and default or Color3.new(1,1,1),
        Set = function(self, val, silent)
            self.CurrentValue = val
            if type(val) == "table" then self.CurrentOption = val end
        end
    }
    return Flags[name]
end

