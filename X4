    -- Content
    local Content = Create("Frame", {
        Name = "Content",
        Parent = Main,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, Sizes.TopBarHeight + Sizes.TabBarHeight),
        Size = UDim2.new(1, 0, 1, -(Sizes.TopBarHeight + Sizes.TabBarHeight)),
        ClipsDescendants = true,
    })

    local Pages = Create("Folder", { Name = "Pages", Parent = Content })

    local Window = {
        ScreenGui = ScreenGui,
        Main = Main,
        Tabs = {},
        SelectedTab = nil,
