                local awaiting, busy = false, false
                local pulseThread
                local tweenFast = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local tweenBounce = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

                local function SetAwaiting()
                    if pulseThread then task.cancel(pulseThread) end
                    TweenService:Create(keyFrame, tweenFast, {BackgroundColor3 = Color3.fromRGB(160,100,15), BackgroundTransparency = 0.3}):Play()
                    TweenService:Create(keyBtn, tweenFast, {TextColor3 = Color3.fromRGB(245,159,39)}):Play()
                    pulseThread = task.spawn(function()
                        while awaiting do
                            TweenService:Create(keyFrame, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.1}):Play()
                            task.wait(0.5)
                            TweenService:Create(keyFrame, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.4}):Play()
                            task.wait(0.5)
                        end
                    end)
                end
                local function SetKeybind()
                    if pulseThread then task.cancel(pulseThread) pulseThread = nil end
                    TweenService:Create(keyFrame, tweenFast, {BackgroundColor3 = Color3.fromRGB(60,180,80), BackgroundTransparency = 0.2}):Play()
                    TweenService:Create(keyBtn, tweenFast, {TextColor3 = Color3.new(1,1,1)}):Play()
                    task.wait()
                    local w = math.max(30, keyBtn.TextBounds.X + 16)
                    TweenService:Create(keyFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, w + 8, 0, 24)}):Play()
                    task.delay(0.1, function() TweenService:Create(keyFrame, tweenBounce, {Size = UDim2.new(0, w, 0, 20)}):Play() end)
                    task.delay(0.4, function() TweenService:Create(keyFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundColor3 = Color3.fromRGB(53,53,53), BackgroundTransparency = 0.7}):Play() end)
                end
                local function SetEmpty()
                    if pulseThread then task.cancel(pulseThread) pulseThread = nil end
                    TweenService:Create(keyFrame, tweenFast, {BackgroundColor3 = Color3.fromRGB(53,53,53), BackgroundTransparency = 0.7}):Play()
                    TweenService:Create(keyBtn, tweenFast, {TextColor3 = Color3.new(1,1,1)}):Play()
                end

                keyBtn.MouseButton1Click:Connect(function()
                    if busy then return end
                    busy = true
                    bindData.Pressable = false
                    icon.Visible = false
                    keyBtn.Text = "..."
                    awaiting = true
                    SetAwaiting()
                    task.wait(0.1)
                    busy = false
                end)

                UserInputService.InputBegan:Connect(function(input, processed)
                    if isUnloaded or processed then return end
                    if awaiting and input.KeyCode.Name ~= "Unknown" then
                        local old = bindData.KeyCode
                        bindData.KeyCode = input.KeyCode.Name
                        awaiting = false
                        if old == bindData.KeyCode then
                            bindData.KeyCode = nil
                            icon.Visible = true
                            keyBtn.Text = ""
                            SetEmpty()
                            return
                        end
                        keyBtn.Text = bindData.KeyCode
