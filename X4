local function parseMoney(text)
    if type(text) ~= "string" then
        return nil
    end

    local clean =
        text:gsub(",","")
        :gsub("¢","")
        :gsub("%$","")
        :gsub("%s+","")

    local number,suffix =
        clean:match(
            "([%d%.]+)([%a]*)"
        )

    number = tonumber(number)

    if not number then
        return nil
    end

    suffix =
        string.lower(
            suffix or ""
        )

    local mult = {
        [""] = 1,
        k = 1e3,
        m = 1e6,
        b = 1e9,
        t = 1e12,
        qa = 1e15,
        qi = 1e18,
        sx = 1e21,
        sp = 1e24,
        oc = 1e27,
        no = 1e30,
        dc = 1e33
    }

    return
        number
        * (
            mult[suffix]
            or 1
        )
end

local function valueFromEntry(item)
    if not item then
        return 0
    end

    if KnownValues[item.uid] then
        return KnownValues[item.uid]
    end

    for _,key in ipairs({
        "value",
        "Value",
        "sellValue",
        "SellValue",
        "worth",
        "Worth",
        "price",
        "Price"
    }) do
        if type(item[key]) == "number" then
            return item[key]
        end
    end

    local tool =
        getToolByUid(
            item.uid
        )

    if tool then
        for _,key in ipairs({
            "value",
            "Value",
            "sellValue",
            "SellValue",
            "worth",
            "Worth",
            "price",
            "Price"
        }) do
            local value =
                tool:GetAttribute(
                    key
                )

            if type(value) == "number" then
                return value
            end
        end
    end

    return 0
end

local function getPedestalValue(pedestal)
    for _,object in ipairs(
        pedestal:GetDescendants()
    ) do
        if object:IsA("TextLabel") then
            local lower =
                string.lower(
                    object.Name
                )

            if lower == "money"
                or string.find(
                    lower,
                    "value",
                    1,
                    true
                ) then

                local value =
                    parseMoney(
                        object.Text
                    )

                if value then
                    return value
                end
            end
        end
    end

    local uid =
        pedestal:GetAttribute(
            "ItemUid"
        )

    if type(uid) == "string"
        and uid ~= "" then

        return valueFromEntry(
            findInventory(
                uid,
                getData()
            )
        )
    end

    return 0
end

