function UIModule:Notify(title, text, duration)

    if not self.Gui then
        return
    end

    duration = duration or 3

    --------------------------------------------------

    local card =
        Instance.new("Frame")

    card.Name = "Notification"

    card.Size =
        UDim2.new(1, 0, 0, 64)

    card.BackgroundColor3 =
        THEME.ContainerBg

    card.BackgroundTransparency = 0.05

    card.BorderSizePixel = 0

    card.Position =
        UDim2.new(1, 30, 0, 0)

    card.Parent =
        self.NotifyHolder

    addCorner(card, 11)

    --------------------------------------------------

    local stroke =
        addStroke(
            card,
            1.2,
            0.35
        )

    addGradient(
        stroke,
        THEME.AccentCyan,
        THEME.AccentPurple
    )

    --------------------------------------------------
    -- Accent line
    --------------------------------------------------

    local accent =
        Instance.new("Frame")

    accent.Size =
        UDim2.new(0, 3, 1, -20)

    accent.Position =
        UDim2.new(0, 7, 0, 10)

    accent.BorderSizePixel = 0

    accent.Parent = card

    addCorner(accent, 3)

    addGradient(
        accent,
        THEME.AccentCyan,
        THEME.AccentPurple,
        90
    )

    --------------------------------------------------
    -- TITLE
    --------------------------------------------------

    local titleLbl =
        Instance.new("TextLabel")

    titleLbl.Size =
        UDim2.new(1, -30, 0, 22)

    titleLbl.Position =
        UDim2.new(0, 18, 0, 7)

    titleLbl.BackgroundTransparency = 1

    titleLbl.Text =
        title or "NOTIFICATION"

    titleLbl.TextColor3 =
        THEME.AccentCyan

    titleLbl.Font =
        THEME.FontTitle

    titleLbl.TextXAlignment =
        Enum.TextXAlignment.Left

    titleLbl.Parent = card

    applyTextSettings(
        titleLbl,
        8,
        13
    )

    --------------------------------------------------
    -- BODY
    --------------------------------------------------

    local bodyLbl =
        Instance.new("TextLabel")

    bodyLbl.Size =
        UDim2.new(1, -30, 0, 27)

    bodyLbl.Position =
        UDim2.new(0, 18, 0, 29)

    bodyLbl.BackgroundTransparency = 1

    bodyLbl.Text =
        text or ""

    bodyLbl.TextColor3 =
        THEME.TextPrimary

    bodyLbl.Font =
        THEME.FontBody

    bodyLbl.TextXAlignment =
        Enum.TextXAlignment.Left

    bodyLbl.Parent = card

    applyTextSettings(
        bodyLbl,
        8,
        12
    )

    --------------------------------------------------
    -- ANIMATION IN
    --------------------------------------------------

    tween(
        card,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Position =
                UDim2.new(0, 0, 0, 0)
        }
    )

    --------------------------------------------------
    -- AUTO REMOVE
    --------------------------------------------------

    task.delay(
        duration,
        function()

            if card and card.Parent then

                local animOut =
                    tween(
                        card,
                        TweenInfo.new(
                            0.3,
                            Enum.EasingStyle.Quad,
                            Enum.EasingDirection.In
                        ),
                        {
                            Position =
                                UDim2.new(
                                    1,
                                    30,
                                    0,
                                    0
                                )
                        }
                    )

                if animOut then

                    animOut.Completed:Connect(
                        function()

                            if card then
                                card:Destroy()
                            end

                        end
                    )

                end

            end

        end
    )

end

