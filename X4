local function getPedestals()
    if CachedPedestals
        and os.clock() - PedestalCacheTime < 1 then

        local valid = true

        for _,pedestal in ipairs(
            CachedPedestals
        ) do
            if not pedestal.Parent then
                valid = false
                break
            end
        end

        if valid then
            return CachedPedestals
        end
    end

    local result = {}
    local plot = getPlot()

    if not plot then
        return result
    end

    for _,object in ipairs(
        plot:GetDescendants()
    ) do
        if object:IsA("Model")
            and type(
                object:GetAttribute(
                    "Slot"
                )
            ) == "number"
            and object:GetAttribute(
                "Owned"
            ) == true then

            table.insert(
                result,
                object
            )
        end
    end

    table.sort(
        result,
        function(a,b)
            return
                a:GetAttribute("Slot")
                <
                b:GetAttribute("Slot")
        end
    )

    CachedPedestals = result
    PedestalCacheTime = os.clock()

    return result
end

