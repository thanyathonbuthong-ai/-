local function isDigAreaPart(object)
    return
        object:IsA("BasePart")
        and object.Name == "DigArea"
end

local function invalidateIsland(island)
    IslandProfiles[island] = nil
    IslandStates[island] = nil
end

local function buildIslandProfile(island)
    local parts = {}

    if not island
        or not island.Parent then

        return {
            Island = island,
            Parts = parts,
            Mode = "None"
        }
    end

    for _,object in ipairs(
        island:GetDescendants()
    ) do
        if isDigAreaPart(object) then
            local ancestor =
                object.Parent

            local valid =
                object.Parent
                and object.Parent.Name
                == "DigAreas"

            while not valid
                and ancestor
                and ancestor ~= island do

                if ancestor.Name == "DigAreas" then
                    valid = true
                    break
                end

                ancestor =
                    ancestor.Parent
            end

            if valid then
                table.insert(
                    parts,
                    object
                )
            end
        end
    end

    table.sort(
        parts,
        function(a,b)
            return
                a:GetFullName()
                <
                b:GetFullName()
        end
    )

    return {
        Island = island,

        Parts = parts,

        Mode =
            #parts >= 4
            and "Hotspots"
            or "Zone"
    }
end

local function getIslandProfile(island)
    local cached =
        IslandProfiles[island]

    if cached then
        local valid = true

        for _,part in ipairs(
            cached.Parts
        ) do
            if not part.Parent then
                valid = false
                break
            end
        end

        if valid then
            return cached
        end
    end

    local profile =
        buildIslandProfile(
            island
        )

    IslandProfiles[island] =
        profile

    return profile
end

local function getIslandState(island)
    if not IslandStates[island] then
        IslandStates[island] = {
            Cursor = 0,
            FailedParts = {}
        }
    end

    return IslandStates[island]
end

local function insidePart(
    part,
    position,
    padding
)
    local point =
        part.CFrame:PointToObjectSpace(
            position
        )

    padding = padding or 0

    return
        math.abs(point.X)
        <= part.Size.X / 2 + padding
        and
        math.abs(point.Z)
        <= part.Size.Z / 2 + padding
end

local function getRaycastIgnore(
    island,
    profile
)
    local ignore = {}

    local char = character()

    if char then
        table.insert(
            ignore,
            char
        )
    end

    profile =
        profile
        or getIslandProfile(
            island
        )

    for _,part in ipairs(
        profile.Parts
    ) do
        table.insert(
            ignore,
            part
        )
    end

    return ignore
end

