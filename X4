local RequestId = -1000000

local function invoke(remote,timeout,...)
    if not alive() then
        return false,nil
    end

    RequestId -= 1

    local id = RequestId
    local finished = false
    local status
    local result
    local connection

    connection =
        remote.OnClientEvent:Connect(function(
            responseId,
            responseStatus,
            responseResult
        )
            if not alive() then
                return
            end

            if responseId ~= id then
                return
            end

            status = responseStatus
            result = responseResult
            finished = true
        end)

    local args = table.pack(...)

    local fired = pcall(function()
        remote:FireServer(
            id,
            table.unpack(args,1,args.n)
        )
    end)

    if not fired then
        connection:Disconnect()
        return false,nil
    end

    local started = os.clock()

    while not finished
        and alive()
        and os.clock() - started < (timeout or 5) do

        task.wait()
    end

    connection:Disconnect()

    if not alive() or not finished then
        return false,nil
    end

    if status ~= true then
        return false,result
    end

    return true,result
end

