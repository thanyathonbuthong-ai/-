local function weakestPedestal()
    local weakest
    local weakestValue = math.huge

    for _,pedestal in ipairs(
        getPedestals()
    ) do
        if not pedestalEmpty(pedestal)
            and not pedestalFavorited(
                pedestal
            ) then

            local value =
                getPedestalValue(
                    pedestal
                )

            if value
                and value < weakestValue then

                weakest = pedestal
                weakestValue = value
            end
        end
    end

    return weakest,weakestValue
end

local function findPrompt(object,words)
    if not object then
        return nil
    end

    local fallback

    for _,descendant in ipairs(
        object:GetDescendants()
    ) do
        if descendant:IsA(
            "ProximityPrompt"
        ) then

            fallback =
                fallback or descendant

            local text =
                string.lower(
                    tostring(
                        descendant.ActionText
                    )
                    .. " "
                    .. tostring(
                        descendant.ObjectText
                    )
                    .. " "
                    .. descendant.Name
                )

            for _,word in ipairs(
                words or {}
            ) do
                if string.find(
                    text,
                    string.lower(word),
                    1,
                    true
                ) then

                    return descendant
                end
            end
        end
    end

    return fallback
end

local function triggerPrompt(prompt)
    if not prompt then
        return false
    end

    if Caps.FirePrompt then
        local success =
            pcall(function()
                fireproximityprompt(
                    prompt
                )
            end)

        if success then
            task.wait(0.1)

            return true
        end
    end

    local duration =
        math.max(
            prompt.HoldDuration,
            0.05
        )

    local success =
        pcall(function()
            prompt:InputHoldBegin()

            task.wait(
                duration + 0.08
            )

            prompt:InputHoldEnd()
        end)

    if success then
        task.wait(0.1)

        return true
    end

    local key =
        prompt.KeyboardKeyCode

    if key == Enum.KeyCode.Unknown then
        key = Enum.KeyCode.E
    end

    success =
        pcall(function()
            VirtualInputManager:SendKeyEvent(
                true,
                key,
                false,
                game
            )

            task.wait(
                duration + 0.08
            )

            VirtualInputManager:SendKeyEvent(
                false,
                key,
                false,
                game
            )
        end)

    task.wait(0.1)

    return success
end

