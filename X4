end

local function restorePosition(cf)
    local hrp = root()

    if not hrp or not cf then
        return
    end

    hrp.CFrame = cf
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return
            object.PrimaryPart
            or object:FindFirstChild(
                "HumanoidRootPart",
                true
            )
            or object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function teleportTo(object)
    local hrp = root()
    local part = getPart(object)

    if not hrp or not part then
        return false
    end

    hrp.CFrame =
        part.CFrame
        * CFrame.new(
            0,
            part.Size.Y / 2 + 3,
            0
        )

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    return true
end

local function teleportNear(object,distance)
    local hrp = root()
    local part = getPart(object)

    if not hrp or not part then
        return false
    end

    hrp.CFrame =
        part.CFrame
        * CFrame.new(
            0,
            0,
            -(distance or 3)
        )

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    return true
end

local function getData(force)
    if not force
        and CachedData
        and os.clock() - DataTime < 0.2 then

        return CachedData
    end

    local success,data =
        invoke(
            RequestDataRemote,
            4
        )

    if success
        and type(data) == "table" then

        CachedData = data
        DataTime = os.clock()
    end

    return CachedData
end

local function refreshData()
    DataTime = 0

    return getData(true)
end

local function findInventory(uid,data)
    data = data or getData()

    if not data
        or type(data.Inventory) ~= "table" then

        return nil
    end

    for _,item in pairs(
        data.Inventory
    ) do
        if type(item) == "table"
            and item.uid == uid then

            return item
        end
    end

    return nil
end

local function isCollectible(item)
    return
        type(item) == "table"
        and type(item.uid) == "string"
        and (
            item.dirty ~= nil
            or item.condition ~= nil
            or item.pedestalSlot ~= nil
        )
end

local function inventoryEntries()
    local result = {}
    local data = refreshData()

    if not data
        or type(data.Inventory) ~= "table" then

        return result
    end

    for _,item in pairs(
        data.Inventory
    ) do
        if isCollectible(item) then
            table.insert(
                result,
                item
            )
        end
    end

    return result
end

local function getDirtyItem()
    local data = getData()

    if not data
        or type(data.Inventory) ~= "table" then

        return nil
    end

    for _,item in pairs(
        data.Inventory
    ) do
        if isCollectible(item)
            and item.dirty == true
            and item.pedestalSlot == nil then

            return item
        end
    end

    return nil
end

local function getToolByUid(uid)
    local containers = {
        character(),
        Backpack
    }

    for _,container in ipairs(
        containers
    ) do
        if container then
            for _,object in ipairs(
                container:GetChildren()
            ) do
                if object:IsA("Tool")
                    and object:GetAttribute(
                        "inventoryId"
                    ) == uid then

                    return object
                end
            end
        end
    end

    return nil
end

local function waitForTool(uid,timeout)
    local started = os.clock()

    repeat
        local tool =
            getToolByUid(uid)

        if tool then
            return tool
        end

        task.wait(0.035)

    until not alive()
        or os.clock() - started
        >= (timeout or 2.5)

    return nil
end

