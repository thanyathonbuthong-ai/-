    mainBtn.Font = THEME.FontBody  
    mainBtn.TextXAlignment = Enum.TextXAlignment.Left  
    mainBtn.Parent = dropdownFrame  
    applyTextSettings(mainBtn, 8, 13)  

    local arrow = Instance.new("TextLabel")  
    arrow.Size = UDim2.new(0, 24, 0, 36)  
    arrow.Position = UDim2.new(1, -28, 0, 0)  
    arrow.BackgroundTransparency = 1  
    arrow.Text = "▼"  
    arrow.TextColor3 = THEME.AccentCyan  
    arrow.Font = THEME.FontBody  
    arrow.TextSize = 10  
    arrow.Parent = dropdownFrame  

    -- คอนเทนเนอร์ตัวเลือก + ช่องค้นหา
    local container = Instance.new("Frame")  
    container.Size = UDim2.new(1, -16, 0, 160)  
    container.Position = UDim2.new(0, 8, 0, 38)  
    container.BackgroundTransparency = 1  
    container.Parent = dropdownFrame  

    -- ช่อง Search Input
    local searchBoxFrame = Instance.new("Frame")
    searchBoxFrame.Size = UDim2.new(1, 0, 0, 26)
    searchBoxFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 26)
    searchBoxFrame.Parent = container

    local searchCorner = Instance.new("UICorner")
    searchCorner.CornerRadius = UDim.new(0, 4)
    searchCorner.Parent = searchBoxFrame

    local searchStroke = Instance.new("UIStroke")
    searchStroke.Thickness = 1
    searchStroke.Color = THEME.AccentCyan
    searchStroke.Transparency = 0.6
    searchStroke.Parent = searchBoxFrame

    local searchIcon = Instance.new("TextLabel")
    searchIcon.Size = UDim2.new(0, 20, 1, 0)
    searchIcon.Position = UDim2.new(0, 4, 0, 0)
    searchIcon.BackgroundTransparency = 1
    searchIcon.Text = "🔍"
    searchIcon.TextSize = 11
    searchIcon.Parent = searchBoxFrame

    local searchInput = Instance.new("TextBox")
    searchInput.Size = UDim2.new(1, -28, 1, 0)
    searchInput.Position = UDim2.new(0, 24, 0, 0)
    searchInput.BackgroundTransparency = 1
    searchInput.Text = ""
    searchInput.PlaceholderText = "Search..."
    searchInput.PlaceholderColor3 = THEME.TextMuted
    searchInput.TextColor3 = THEME.TextPrimary
    searchInput.Font = THEME.FontBody
    searchInput.ClearTextOnFocus = false
    searchInput.Parent = searchBoxFrame
    applyTextSettings(searchInput, 8, 12)

    -- Scrolling Frame สำหรับ List ตัวเลือก
    local optionScroll = Instance.new("ScrollingFrame")
    optionScroll.Size = UDim2.new(1, 0, 1, -32)
    optionScroll.Position = UDim2.new(0, 0, 0, 32)
    optionScroll.BackgroundTransparency = 1
    optionScroll.BorderSizePixel = 0
    optionScroll.ScrollBarThickness = 3
    optionScroll.ScrollBarImageColor3 = THEME.AccentCyan
    optionScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    optionScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    optionScroll.Parent = container

    local listLayout = Instance.new("UIListLayout")  
    listLayout.Padding = UDim.new(0, 4)  
    listLayout.Parent = optionScroll  

    local optionButtons = {}

    local function filterOptions(query)
        query = string.lower(query or "")
        for _, btnData in ipairs(optionButtons) do
            if query == "" or string.find(string.lower(btnData.Text), query, 1, true) then
                btnData.Button.Visible = true
            else
                btnData.Button.Visible = false
            end
        end
    end

    local function toggleDropdown()  
        isOpen = not isOpen  
        
        if isOpen then
            tween(arrow, TweenInfo.new(0.2), {Rotation = 180})
            tween(dropdownFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0.96, 0, 0, 204)
            }).Completed:Connect(function()
                self.UpdateSize()
            end)
        else
            tween(arrow, TweenInfo.new(0.2), {Rotation = 0})
            tween(dropdownFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0.96, 0, 0, 36)
            }).Completed:Connect(function()
                self.UpdateSize()
            end)
        end  
    end  

    mainBtn.MouseButton1Click:Connect(toggleDropdown)  
    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        filterOptions(searchInput.Text)
    end)

    local function populateOptions(opts)
        for _, oldBtn in ipairs(optionScroll:GetChildren()) do
            if oldBtn:IsA("TextButton") then oldBtn:Destroy() end
        end
        optionButtons = {}

        for _, optionText in ipairs(opts) do  
            local optBtn = Instance.new("TextButton")  
            optBtn.Size = UDim2.new(0.98, 0, 0, 26)  
            optBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 48)  
            optBtn.Text = optionText  
            optBtn.TextColor3 = THEME.TextMuted  
            optBtn.Font = THEME.FontBody  
            optBtn.Parent = optionScroll  
            applyTextSettings(optBtn, 8, 12)  

            local optCorner = Instance.new("UICorner")  
            optCorner.CornerRadius = UDim.new(0, 4)  
            optCorner.Parent = optBtn  

            optBtn.MouseEnter:Connect(function()
                tween(optBtn, TweenInfo.new(0.15), {BackgroundColor3 = THEME.AccentPurple, TextColor3 = THEME.TextPrimary})
            end)
            optBtn.MouseLeave:Connect(function()
                tween(optBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(26, 26, 48), TextColor3 = THEME.TextMuted})
            end)

            optBtn.MouseButton1Click:Connect(function()  
                selected = optionText  
                mainBtn.Text = txt .. ": " .. tostring(selected)  
                toggleDropdown()  
                if cb then cb(selected) end  
            end)  

            table.insert(optionButtons, {Text = optionText, Button = optBtn})
        end  
    end

    populateOptions(options)

    self.UpdateSize()  
    return {
        Frame = dropdownFrame,
        Refresh = function(newOptions)
            populateOptions(newOptions)
        end
    }
end

-- --- 9. 🔥 [ระบบที่ 1] Collapsible Groupbox / Accordion (กลุ่มเมนูย่อ/ขยายได้) ---
function UIModule:CreateGroupbox(titleText, parentFrame)
    local targetParent = parentFrame or self.Content
    local isExpanded = true

    local box = Instance.new("Frame")
    box.Size = UDim2.new(0.96, 0, 0, 36)
    box.BackgroundColor3 = THEME.ContainerBg
    box.BackgroundTransparency = 0.3
    box.ClipsDescendants = true
    box.Parent = targetParent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Thickness = 1.2
    boxStroke.Transparency = 0.4
    boxStroke.Parent = box
    addCosmicGradient(boxStroke, THEME.AccentCyan, THEME.AccentPurple)

    -- Header Button กดพับ/ขยาย
    local headerBtn = Instance.new("TextButton")
    headerBtn.Size = UDim2.new(1, 0, 0, 34)
    headerBtn.BackgroundTransparency = 1
    headerBtn.Text = "  " .. (titleText or "GROUPBOX")
    headerBtn.TextColor3 = THEME.AccentCyan
    headerBtn.Font = THEME.FontTitle
    headerBtn.TextXAlignment = Enum.TextXAlignment.Left
    headerBtn.Parent = box
    applyTextSettings(headerBtn, 9, 14)

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 24, 0, 34)
    arrow.Position = UDim2.new(1, -28, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = THEME.AccentCyan
    arrow.Font = THEME.FontBody
    arrow.TextSize = 10
    arrow.Parent = headerBtn

    -- คอนเทนเนอร์ย่อยสำหรับยัด Controls
    local groupContent = Instance.new("Frame")
    groupContent.Size = UDim2.new(1, -12, 0, 0)
    groupContent.Position = UDim2.new(0, 6, 0, 36)
    groupContent.BackgroundTransparency = 1
    groupContent.Parent = box

    local groupList = Instance.new("UIListLayout")
    groupList.Padding = UDim.new(0, 6)
    groupList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    groupList.Parent = groupContent

    local function updateGroupHeight()
        if isExpanded then
            local targetH = groupList.AbsoluteContentSize.Y + 44
            tween(box, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0.96, 0, 0, targetH)
            })
        else
            tween(box, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0.96, 0, 0, 36)
            })
        end
        task.wait(0.22)
        self.UpdateSize()
    end

    table.insert(self.Connections, groupList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if isExpanded then updateGroupHeight() end
    end))

    headerBtn.MouseButton1Click:Connect(function()
        isExpanded = not isExpanded
        if isExpanded then
            tween(arrow, TweenInfo.new(0.2), {Rotation = 0})
        else
            tween(arrow, TweenInfo.new(0.2), {Rotation = -90})
        end
        updateGroupHeight()
    end)

    self.UpdateSize()

    -- สร้าง Sub-Module Object เพื่อเปิดฟังก์ชันยัดใส่ใน Groupbox ได้โดยตรง
    local groupObj = {}
    groupObj.Content = groupContent

    function groupObj:CreateButton(txt, cb)
        return UIModule.CreateButton(self, txt, cb, groupContent)
    end
    function groupObj:CreateToggle(txt, defaultState, cb)
        return UIModule.CreateToggle(self, txt, defaultState, cb, groupContent)
    end
    function groupObj:CreateSlider(txt, min, max, default, cb)
        return UIModule.CreateSlider(self, txt, min, max, default, cb, groupContent)
    end
    function groupObj:CreateSearchDropdown(txt, options, default, cb)
        return UIModule.CreateSearchDropdown(self, txt, options, default, cb, groupContent)
    end

    return groupObj
end

