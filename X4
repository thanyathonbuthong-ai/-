    ContentPadding.PaddingBottom =
        UDim.new(0, 10)

    ContentPadding.PaddingLeft =
        UDim.new(0, 2)

    ContentPadding.PaddingRight =
        UDim.new(0, 2)

    ContentPadding.Parent = Content

    --------------------------------------------------
    -- CONTENT LIST
    --------------------------------------------------

