    if isUnloaded then return oldNamecall(self, ...) end
    if typeof(self) == 'Instance' and tostring(self) == 'RemoteEvent' then
        local args = ({...})[2]
        if type(args) == 'table' and typeof(args[1]) == 'buffer' then
            local str = buffer.tostring(args[1])
