    local listLayout =
        Instance.new("UIListLayout")

    listLayout.Padding =
        UDim.new(0, 5)

    listLayout.Parent =
        optionScroll

    --------------------------------------------------

    local optionButtons = {}

    --------------------------------------------------
    -- FILTER
    --------------------------------------------------

    local function filterOptions(query)

        query =
            string.lower(
                query or ""
            )

        for _, btnData in
            ipairs(optionButtons) do

            local optionText =
                string.lower(
                    tostring(
                        btnData.Text
                    )
                )

            if query == ""
                or
                string.find(
                    optionText,
                    query,
                    1,
                    true
                ) then

                btnData.Button.Visible = true

            else

                btnData.Button.Visible = false

            end

        end

    end

    --------------------------------------------------
    -- TOGGLE
    --------------------------------------------------

    local function toggleDropdown()

        isOpen = not isOpen

        if isOpen then

            tween(
                arrow,
                TweenInfo.new(0.2),
                {
                    Rotation = 180
                }
            )

            tween(
                dropdownFrame,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Size =
                        UDim2.new(
                            0.96,
                            0,
                            0,
                            212
                        )
                }
            )

        else

            tween(
                arrow,
                TweenInfo.new(0.2),
                {
                    Rotation = 0
                }
            )

            tween(
                dropdownFrame,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Size =
                        UDim2.new(
                            0.96,
                            0,
                            0,
                            38
                        )
                }
            )

        end

    end

    --------------------------------------------------

    mainBtn.MouseButton1Click:Connect(
        toggleDropdown
    )

    --------------------------------------------------

    searchInput:GetPropertyChangedSignal(
        "Text"
    ):Connect(function()

        filterOptions(
            searchInput.Text
        )

    end)

    --------------------------------------------------
    -- POPULATE OPTIONS
    --------------------------------------------------

    local function populateOptions(opts)

        for _, child in
            ipairs(
                optionScroll:GetChildren()
            ) do

            if child:IsA("TextButton") then
                child:Destroy()
            end

        end

        optionButtons = {}

        for _, optionText in
            ipairs(opts or {}) do

            local optBtn =
                Instance.new("TextButton")

            optBtn.Size =
                UDim2.new(
                    0.98,
                    0,
                    0,
                    29
                )

            optBtn.BackgroundColor3 =
                THEME.InputBg

            optBtn.BackgroundTransparency =
                0.05

            optBtn.BorderSizePixel = 0

            optBtn.Text =
                tostring(optionText)

            optBtn.TextColor3 =
                THEME.TextMuted

            optBtn.Font =
                THEME.FontBody

            optBtn.AutoButtonColor = false

            optBtn.Parent =
                optionScroll

            addCorner(
                optBtn,
                7
            )

            applyTextSettings(
                optBtn,
                8,
                12
            )

            --------------------------------------------------

            optBtn.MouseEnter:Connect(
                function()

                    tween(
                        optBtn,
                        TweenInfo.new(0.15),
                        {
                            BackgroundColor3 =
                                THEME.ContainerHover,
                            TextColor3 =
                                THEME.TextPrimary
                        }
                    )

                end
            )

            --------------------------------------------------

            optBtn.MouseLeave:Connect(
                function()

                    tween(
                        optBtn,
                        TweenInfo.new(0.15),
                        {
                            BackgroundColor3 =
                                THEME.InputBg,
                            TextColor3 =
                                THEME.TextMuted
                        }
                    )

                end
            )

            --------------------------------------------------

            optBtn.MouseButton1Click:Connect(
                function()

                    selected =
                        optionText

                    mainBtn.Text =
                        tostring(txt or "Select")
                        .. ": "
                        .. tostring(selected)

                    toggleDropdown()

                    if cb then
                        cb(selected)
                    end

                end
            )

            --------------------------------------------------

            table.insert(
                optionButtons,
                {
                    Text = tostring(optionText),
                    Button = optBtn
                }
            )

        end

    end

    --------------------------------------------------

    populateOptions(options)

    --------------------------------------------------

    return {

        Frame = dropdownFrame,

        Refresh = function(
            newOptions
        )

            populateOptions(
                newOptions or {}
            )

        end

    }

end

