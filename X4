-- Utility
local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            obj[k] = v
        end
    end
    if props and props.Parent then
        obj.Parent = props.Parent
    end
    return obj
end

local function Tween(obj, props, duration, style, direction)
    local info = TweenInfo.new(
        duration or 0.28,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

local function AddCorner(parent, radius)
    local old = parent:FindFirstChildOfClass("UICorner")
    if old then old:Destroy() end
    return Create("UICorner", {
        Parent = parent,
        CornerRadius = UDim.new(0, radius or Sizes.Corner),
    })
end

local function AddStroke(parent, thickness, color, transparency)
    -- Borderless premium style: no UIStroke is created.
    return nil
end

local function AddPadding(parent, t, b, l, r)
    return Create("UIPadding", {
        Parent = parent,
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
    })
end

local function AddGradient(parent, colorSeq, rotation)
    return Create("UIGradient", {
        Parent = parent,
        Color = colorSeq,
        Rotation = rotation or 90,
    })
end

local function IsTouch(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

