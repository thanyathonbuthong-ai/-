            MinBtn.Text = "+"

        else

            Content.Visible = true

            tween(
                Main,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = EXPANDED_SIZE
                }
            )

            MinBtn.Text = "−"

        end

    end)

    --------------------------------------------------
    -- MOBILE DRAG SYSTEM
    -- Drag only from HEADER
    --------------------------------------------------

    local dragging = false
    local dragInput
    local dragStart
    local startPos

    Header.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            input.UserInputType ==
            Enum.UserInputType.Touch then

            dragging = true

            dragStart = input.Position
            startPos = Main.Position

            input.Changed:Connect(function()

                if input.UserInputState ==
                    Enum.UserInputState.End then

                    dragging = false

                end

            end)

        end

    end)

    Header.InputChanged:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or
            input.UserInputType ==
            Enum.UserInputType.Touch then

            dragInput = input

        end

    end)

    table.insert(
        self.Connections,

        UIS.InputChanged:Connect(function(input)

            if input == dragInput and dragging then

                local delta =
                    input.Position - dragStart

                Main.Position =
                    UDim2.new(
                        startPos.X.Scale,
                        startPos.X.Offset + delta.X,

                        startPos.Y.Scale,
                        startPos.Y.Offset + delta.Y
                    )

            end

        end)
    )

    --------------------------------------------------
    -- FOOTER
    --------------------------------------------------

    if footerText then

        local Footer =
            Instance.new("TextLabel")

        Footer.Name = "Footer"

        Footer.Size =
            UDim2.new(0.96, 0, 0, 20)

        Footer.BackgroundTransparency = 1

        Footer.Text = footerText

        Footer.TextColor3 =
            THEME.TextMuted

        Footer.Font =
            THEME.FontBody

        Footer.TextXAlignment =
            Enum.TextXAlignment.Center

        Footer.LayoutOrder = 999999

        Footer.Parent = Content

        applyTextSettings(
            Footer,
            8,
            11
        )

    end

    --------------------------------------------------

    self.UpdateSize = function()
        -- Kept for compatibility
    end

    return self
end

--------------------------------------------------
-- UNLOAD SYSTEM
--------------------------------------------------

function UIModule:Unload()

    for _, callback in
        ipairs(self.OnUnloadCallbacks or {}) do

        pcall(callback)

    end

    for _, conn in
        ipairs(self.Connections or {}) do

        if conn and conn.Connected then
            conn:Disconnect()
        end

    end

    self.Connections = {}

    if self.Gui then

        self.Gui:Destroy()

        self.Gui = nil

    end

end

--------------------------------------------------

function UIModule:Destroy()
    self:Unload()
end

--------------------------------------------------

function UIModule:OnUnload(cb)

    if typeof(cb) == "function" then

        table.insert(
            self.OnUnloadCallbacks,
            cb
        )

    end

end

