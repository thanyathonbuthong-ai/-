                fill.Size = UDim2.new(0.5,0,1,0)
                Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

                local min, max = range[1], range[2]
                local function valueToAlpha(v) return (v - min) / (max - min) end
                local function alphaToValue(a)
                    local v = a * (max - min) + min
                    local rounded = math.round(v / inc) * inc
                    local decimals = math.max(0, math.ceil(-math.log10(inc)))
                    return tonumber(string.format("%."..decimals.."f", math.clamp(rounded, min, max)))
                end
                local function updateVisual(alpha, animate)
                    local val = alphaToValue(alpha)
                    nameLabel.Text = name .. string.format(' <font color="rgb(245, 159, 39)">%s<font color="rgb(141, 141, 141)">%s</font></font>', tostring(val), suffix)
                    local size = UDim2.new(alpha,0,1,0)
                    local pos = UDim2.new(alpha,0,0.5,0)
                    if animate then
                        TweenService:Create(fill, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = size}):Play()
                        TweenService:Create(ball, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = pos}):Play()
                    else
                        fill.Size = size
                        ball.Position = pos
                    end
                end

                if loadedSettings[flag] then
                    default = loadedSettings[flag].CurrentValue
                    WindowAPI.Flags[flag] = {CurrentValue = default}
                    task.spawn(function() cb(default) end)
                end
                updateVisual(valueToAlpha(default), false)

                local dragging, hoveringBar, hoveringBall = false, false, false
                local normalSize, hoverSize = UDim2.new(0,120,0,6), UDim2.new(0,120,0,9)
                local ballNormal, ballHover = UDim2.new(0,16,0,16), UDim2.new(0,20,0,20)
                local tweenInf = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

                local function onDrag(x)
                    local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    local val = alphaToValue(alpha)
                    if val ~= WindowAPI.Flags[flag].CurrentValue then
                        WindowAPI.Flags[flag].CurrentValue = val
                        updateVisual(valueToAlpha(val), true)
                        cb(val)
                    end
                end

                bar.MouseEnter:Connect(function() hoveringBar = true TweenService:Create(bar, tweenInf, {Size = hoverSize}):Play() TweenService:Create(ball, tweenInf, {Size = ballHover}):Play() end)
                bar.MouseLeave:Connect(function() hoveringBar = false if not hoveringBall and not dragging then TweenService:Create(bar, tweenInf, {Size = normalSize}):Play() TweenService:Create(ball, tweenInf, {Size = ballNormal}):Play() end end)
                ball.MouseEnter:Connect(function() hoveringBall = true TweenService:Create(bar, tweenInf, {Size = hoverSize}):Play() TweenService:Create(ball, tweenInf, {Size = ballHover}):Play() end)
                ball.MouseLeave:Connect(function() hoveringBall = false if not hoveringBar and not dragging then TweenService:Create(bar, tweenInf, {Size = normalSize}):Play() TweenService:Create(ball, tweenInf, {Size = ballNormal}):Play() end end)
                ball.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dragging = true onDrag(inp.Position.X) end end)
                bar.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dragging = true onDrag(inp.Position.X) end end)
                UserInputService.InputChanged:Connect(function(inp) if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then onDrag(inp.Position.X) end end)
                UserInputService.InputEnded:Connect(function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        if inp.UserInputType == Enum.UserInputType.Touch or (not hoveringBar and not hoveringBall) then
                            TweenService:Create(bar, tweenInf, {Size = normalSize}):Play()
                            TweenService:Create(ball, tweenInf, {Size = ballNormal}):Play()
                        end
                    end
                end)
            end

