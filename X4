local Library = {}
Library.Flags = {}
Library.Keybinds = {}
Library.__Window__ = nil

local function EmptyCallback() end

-- Helper: create / get flag object
local function EnsureFlag(flagName, defaultValue)
    if not Library.Flags[flagName] then
        Library.Flags[flagName] = {
            CurrentValue = defaultValue,
            CurrentOption = type(defaultValue) == "table" and defaultValue or {},
            Color = typeof(defaultValue) == "Color3" and defaultValue or Color3.new(1, 1, 1),
            Set = function(self, val, silent)
                self.CurrentValue = val
                if type(val) == "table" then
                    self.CurrentOption = val
                end
            end
        }
    end
    return Library.Flags[flagName]
end

function Library.CreateWindow(_, config)
    local winTitle = config.Name or "AmberCore v9"
    local winIcon = config.Icon or "solar:folder-2-bold-duotone"

    local WindWindow = WindUI:CreateWindow({
        Title = winTitle .. " | WindUI",
        Folder = "AmberCoreWindUI",
        Icon = type(winIcon) == "string" and winIcon:find("rbxasset") and "solar:folder-2-bold-duotone" or "solar:folder-2-bold-duotone",
        NewElements = true,
        HideSearchBar = false,
        OpenButton = {
            Title = "เปิด AmberCore",
            CornerRadius = UDim.new(1, 0),
            StrokeThickness = 3,
            Enabled = true,
            Draggable = true,
            OnlyMobile = false,
            Scale = 0.5,
            Color = ColorSequence.new(
                Color3.fromHex("#F59F27"),
                Color3.fromHex("#FFD700")
            ),
        },
        Topbar = {
            Height = 44,
            ButtonsType = "Mac",
        },
    })

    WindWindow:Tag({
        Title = "Thai",
        Icon = "globe",
        Color = Color3.fromHex("#F59F27"),
        Border = true,
    })

    Library.__Window__ = WindWindow

    local WindowAPI = {}
    WindowAPI.Flags = Library.Flags
    WindowAPI.Keybinds = Library.Keybinds
    WindowAPI._wind = WindWindow
    WindowAPI._tabs = {}

    function WindowAPI.CreateTab(_, name, iconName)
        local tab = WindWindow:Tab({
            Title = name,
            Icon = "solar:widget-bold", -- WindUI uses its own icons
            Border = true,
        })

        local TabAPI = {}
        TabAPI._tab = tab
        TabAPI.Features = {}
        TabAPI.Index = #WindowAPI._tabs + 1
        table.insert(WindowAPI._tabs, TabAPI)

        -- Section
        function TabAPI.CreateSection(_, title, column)
            tab:Section({ Title = title or "" })
            return { Set = function(_, txt) end }
        end

        -- Label
        function TabAPI.CreateLabel(_, text)
            tab:Section({ Title = tostring(text or ""), TextSize = 14 })
            return { Set = function(_, t) end }
        end

        -- Toggle
        function TabAPI.CreateToggle(_, cfg)
            local flag = cfg.Flag
            local default = cfg.CurrentValue
            local name = cfg.Name
            local cb = cfg.Callback or EmptyCallback

            local flagObj = EnsureFlag(flag, default)
            table.insert(TabAPI.Features, name)

            -- Load saved
            if loadedSettings[flag] and loadedSettings[flag].CurrentValue ~= nil and not cfg.NoSave then
                default = loadedSettings[flag].CurrentValue
                flagObj.CurrentValue = default
            end

            tab:Toggle({
                Title = name,
                Value = default == true,
                Flag = flag,
                Callback = function(v)
                    flagObj.CurrentValue = v
                    task.spawn(cb, v)
                end
            })

            function flagObj.Set(_, val, silent)
                flagObj.CurrentValue = val
                if not silent then
                    task.spawn(cb, val, silent)
                end
            end

            return flagObj
        end

        -- Button
        function TabAPI.CreateButton(_, cfg)
            local name = cfg.Name
            local cb = cfg.Callback or EmptyCallback
            table.insert(TabAPI.Features, name)
            tab:Button({
                Title = name,
                Callback = function()
                    task.spawn(cb)
                end
            })
        end

        -- Slider
        function TabAPI.CreateSlider(_, cfg)
            local name = cfg.Name
            local range = cfg.Range or {0, 100}
            local default = cfg.CurrentValue or range[1]
            local flag = cfg.Flag
            local cb = cfg.Callback or EmptyCallback
            local inc = cfg.Increment or 1

            local flagObj = EnsureFlag(flag, default)
            table.insert(TabAPI.Features, name)

            if loadedSettings[flag] and loadedSettings[flag].CurrentValue then
                default = loadedSettings[flag].CurrentValue
                flagObj.CurrentValue = default
            end

            tab:Slider({
                Title = name,
                Step = inc,
                Value = {
                    Min = range[1],
                    Max = range[2],
                    Default = default
                },
                Flag = flag,
                Callback = function(v)
                    flagObj.CurrentValue = v
                    task.spawn(cb, v)
                end
            })

            return flagObj
        end

        -- Dropdown
        function TabAPI.CreateDropdown(_, cfg)
            local name = cfg.Name
            local flag = cfg.Flag
            local default = deepcopy(cfg.CurrentOption or {})
            local options = deepcopy(cfg.Options or {})
            local multi = cfg.MultipleOptions
            local cb = cfg.Callback or EmptyCallback

            table.insert(TabAPI.Features, name)

            local flagObj = EnsureFlag(flag, default)
            flagObj.CurrentOption = default

            if loadedSettings[flag] and loadedSettings[flag].CurrentOption then
                default = loadedSettings[flag].CurrentOption
                flagObj.CurrentOption = default
            end

            local drop = tab:Dropdown({
                Title = name,
                Values = options,
                Value = multi and default or (default[1] or options[1]),
                Multi = multi == true,
                Flag = flag,
                Callback = function(v)
                    local val = type(v) == "table" and v or {tostring(v)}
                    flagObj.CurrentOption = val
                    task.spawn(cb, val)
                end
            })

            local DropdownAPI = {
                __DropdownOptions = {},
                Refresh = function(_, newOptions)
                    -- WindUI may support Refresh; call if available
                    pcall(function() drop:Refresh(newOptions) end)
                end,
                SetTitle = function(_, newTitle)
                    -- limited support
                end
            }
            return DropdownAPI
        end

        -- Keybind
        function TabAPI.CreateKeybind(_, cfg)
            local defaultKey = cfg.CurrentKeybind
            local name = cfg.Name
            local cb = cfg.Callback or EmptyCallback
            table.insert(TabAPI.Features, name)

            local bindData = {KeyCode = defaultKey, Callback = cb, Pressable = true}
            table.insert(Library.Keybinds, bindData)

            tab:Keybind({
                Title = name,
                Value = defaultKey or "None",
                Callback = function(key)
                    bindData.KeyCode = key
                    -- keybind press is handled by WindUI + our listener
                end
            })
        end

        -- Input
        function TabAPI.CreateInput(_, cfg)
            local name = cfg.Name
            local flag = cfg.Flag
            local default = cfg.CurrentValue or ""
            local placeholder = cfg.PlaceholderText
            local cb = cfg.Callback or EmptyCallback

            table.insert(TabAPI.Features, name)
            local flagObj = EnsureFlag(flag, default)

            if loadedSettings[flag] and loadedSettings[flag].CurrentValue then
                default = loadedSettings[flag].CurrentValue
                flagObj.CurrentValue = default
            end

            tab:Input({
                Title = name,
                Value = tostring(default),
                Placeholder = placeholder,
                Flag = flag,
                Callback = function(txt)
                    flagObj.CurrentValue = txt
                    task.spawn(cb, txt)
                end
            })

            return flagObj
        end

        -- ColorPicker
        function TabAPI.CreateColorPicker(_, cfg)
            local name = cfg.Name
            local defaultColor = cfg.Color or Color3.new(1,1,1)
            local flag = cfg.Flag
            local cb = cfg.Callback or EmptyCallback

            local flagObj = EnsureFlag(flag, defaultColor)
            flagObj.Color = defaultColor
            table.insert(TabAPI.Features, name)

            tab:Colorpicker({
                Title = name,
                Default = defaultColor,
                Flag = flag,
                Callback = function(color)
                    flagObj.Color = color
                    task.spawn(cb, color)
                end
            })

            return flagObj
        end

        -- Divide (spacer)
        function TabAPI.Divide(_)
            tab:Space()
        end

        -- Make TabAPI also respond to method calls like GeneratorsTab:CreateToggle
        setmetatable(TabAPI, {
            __index = function(t, k)
                if type(rawget(t, k)) == "function" then return rawget(t, k) end
                -- fallback so GeneratorsTab:CreateToggle works (same as TabAPI.CreateToggle)
                return function(self, ...)
                    return TabAPI[k](TabAPI, ...)
                end
            end
        })

        return TabAPI
    end

    function WindowAPI.SelectTab(_, idx)
        -- WindUI handles tab selection internally
    end

    -- Keybind listener
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or isUnloaded then return end
        for _, bind in pairs(Library.Keybinds) do
            if bind.Pressable and bind.KeyCode and input.KeyCode == Enum.KeyCode[bind.KeyCode] then
                task.spawn(bind.Callback)
            end
        end
    end)

    -- F4 toggle support
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or isUnloaded then return end
        if input.KeyCode == Enum.KeyCode.F4 then
            -- WindUI OpenButton handles most cases; we can force toggle if needed
        end
    end)

    setmetatable(WindowAPI, {
        __index = function(t, k)
            return rawget(t, k)
        end
    })

    return WindowAPI
end

function Library.Destroy(_)
    pcall(function()
        if Library.__Window__ then
            Library.__Window__:Destroy()
        end
    end)
end

local notified = {}
function Library.Notify(_, data)
    if notified[data.Content] then return end
    if not data.NoQueue then notified[data.Content] = true end
    task.delay(data.Duration or 5, function() notified[data.Content] = nil end)

    if WindUI then
        WindUI:Notify({
            Title = data.Title or "AmberCore",
            Content = data.Content or "",
            Duration = data.Duration or 5,
            Icon = data.Image
        })
    else
        -- very basic fallback
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = data.Title or "AmberCore",
            Text = data.Content or "",
            Duration = data.Duration or 5
        })
    end
end

