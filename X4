    Main.Parent = ApexHub  
    Main.BackgroundColor3 = THEME.Background  
    Main.BackgroundTransparency = 0.15
    Main.BorderSizePixel = 0  
    Main.Position = UDim2.new(0.5, -140, 0.5, -200)  
    Main.Size = UDim2.new(0, 280, 0, 100)  
    Main.Active = true  
    Main.ClipsDescendants = false

    local UICorner = Instance.new("UICorner")  
    UICorner.CornerRadius = UDim.new(0, 10)  
    UICorner.Parent = Main  

    -- Neon Border
    local UIStroke = Instance.new("UIStroke")  
    UIStroke.Thickness = 1.8  
    UIStroke.Transparency = 0.2
    UIStroke.Parent = Main  
    addCosmicGradient(UIStroke, THEME.AccentCyan, THEME.AccentPurple)

    -- Top Glow Bar
    local TopBarGlow = Instance.new("Frame")
    TopBarGlow.Size = UDim2.new(1, -20, 0, 2)
    TopBarGlow.Position = UDim2.new(0, 10, 0, 0)
    TopBarGlow.BorderSizePixel = 0
    TopBarGlow.Parent = Main
    addCosmicGradient(TopBarGlow, THEME.AccentCyan, THEME.AccentPurple)

    -- 標題文字  
    local Title = Instance.new("TextLabel")  
    Title.Parent = Main  
    Title.Size = UDim2.new(1, -50, 0, 42)  
    Title.Position = UDim2.new(0, 14, 0, 0)  
    Title.Text = titleText or "COSMIC HUB"  
    Title.TextColor3 = THEME.TextPrimary  
    Title.Font = THEME.FontTitle  
    Title.BackgroundTransparency = 1  
    Title.TextXAlignment = Enum.TextXAlignment.Left  
    applyTextSettings(Title, 10, 18)  
    self.TitleLabel = Title  

    -- 內容容器 (ScrollingFrame)  
    local Content = Instance.new("ScrollingFrame")  
    Content.Parent = Main  
    Content.Position = UDim2.new(0, 10, 0, 44)  
    Content.Size = UDim2.new(1, -20, 0, 0)  
    Content.BackgroundTransparency = 1  
    Content.BorderSizePixel = 0  
    Content.ScrollBarThickness = 3
    Content.ScrollBarImageColor3 = THEME.AccentCyan
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y  
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)  
    self.Content = Content  

    local UIList = Instance.new("UIListLayout")  
    UIList.Parent = Content  
    UIList.Padding = UDim.new(0, 8)  
    UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center  
    self.UIList = UIList  

    -- 右上角縮小按鈕  
    local isMinimized = false  
    local MINIMIZED_SIZE = UDim2.new(0, 280, 0, 42)  
      
    local MinBtn = Instance.new("TextButton")  
    MinBtn.Size = UDim2.new(0, 24, 0, 24)  
    MinBtn.Position = UDim2.new(1, -32, 0, 9)  
    MinBtn.BackgroundColor3 = THEME.ContainerBg  
    MinBtn.Text = "−"  
    MinBtn.TextColor3 = THEME.AccentCyan  
    MinBtn.Font = THEME.FontBody  
    MinBtn.TextSize = 16  
    MinBtn.Parent = Main  

    local MinBtnCorner = Instance.new("UICorner")  
    MinBtnCorner.CornerRadius = UDim.new(0, 6)  
    MinBtnCorner.Parent = MinBtn  

    local MinBtnStroke = Instance.new("UIStroke")  
    MinBtnStroke.Thickness = 1  
    MinBtnStroke.Color = THEME.AccentCyan  
    MinBtnStroke.Transparency = 0.5
    MinBtnStroke.Parent = MinBtn  

    -- 自動調整高度邏輯  
    local TITLE_PADDING = 54  
    local MAX_HEIGHT = 420  

    local function updateMainSize()  
        if not isMinimized then  
            local contentHeight = UIList.AbsoluteContentSize.Y  
            local targetContentHeight = math.min(contentHeight, MAX_HEIGHT)  
            Content.Size = UDim2.new(1, -20, 0, targetContentHeight)  
            
            tween(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 280, 0, targetContentHeight + TITLE_PADDING)
            })
        end  
    end  
    self.UpdateSize = updateMainSize  
    table.insert(self.Connections, UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateMainSize))  

    -- 縮小功能  
    MinBtn.MouseButton1Click:Connect(function()  
        isMinimized = not isMinimized  
        if isMinimized then  
            Content.Visible = false  
            tween(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = MINIMIZED_SIZE})
            MinBtn.Text = "+"  
        else  
            Content.Visible = true  
            updateMainSize()  
            MinBtn.Text = "−"  
        end  
    end)  

    -- 拖曳邏輯  
    local dragToggle, dragInput, dragStart, startPos  
    Main.InputBegan:Connect(function(input)  
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then  
            dragToggle = true  
            dragStart = input.Position  
            startPos = Main.Position  
            input.Changed:Connect(function()  
                if input.UserInputState == Enum.UserInputState.End then  
                    dragToggle = false  
                end  
            end)  
        end  
    end)  

    Main.InputChanged:Connect(function(input)  
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then  
            dragInput = input  
        end  
    end)  

    table.insert(self.Connections, UIS.InputChanged:Connect(function(input)  
        if input == dragInput and dragToggle then  
            local delta = input.Position - dragStart  
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)  
        end  
    end))  

    -- 頁尾標籤  
    if footerText then  
        local Footer = Instance.new("TextLabel")  
        Footer.Size = UDim2.new(0.96, 0, 0, 18)  
        Footer.BackgroundTransparency = 1  
        Footer.Text = footerText  
        Footer.TextColor3 = THEME.TextMuted  
        Footer.Font = THEME.FontBody  
        Footer.Parent = Content  
        applyTextSettings(Footer, 8, 11)  
    end  

    return self
end

-- --- Unload / Destroy System ---
function UIModule:Unload()
    for _, callback in ipairs(self.OnUnloadCallbacks or {}) do
        pcall(callback)
    end
    for _, conn in ipairs(self.Connections or {}) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    self.Connections = {}
    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end
end

function UIModule:Destroy()
    self:Unload()
end

function UIModule:OnUnload(cb)
    if typeof(cb) == "function" then
        table.insert(self.OnUnloadCallbacks, cb)
    end
end

-- --- 2. ปุ่ม Unload / Danger Button ---
function UIModule:CreateUnloadButton(txt, onUnloadCb)
    if onUnloadCb then self:OnUnload(onUnloadCb) end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.96, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(45, 15, 25)
    btn.BackgroundTransparency = 0.1
    btn.Text = txt or "🚨 SHUTDOWN / UNLOAD SYSTEM"
    btn.TextColor3 = THEME.AccentRed
    btn.Font = THEME.FontBody
    btn.Parent = self.Content

    applyTextSettings(btn, 8, 13)  
      
    local BtnStroke = Instance.new("UIStroke")  
    BtnStroke.Thickness = 1.2  
    BtnStroke.Color = THEME.AccentRed
    BtnStroke.Transparency = 0.3
    BtnStroke.Parent = btn  

    local c = Instance.new("UICorner")  
    c.CornerRadius = UDim.new(0, 6)  
    c.Parent = btn  
    
    btn.MouseEnter:Connect(function()
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 20, 35)})
        tween(BtnStroke, TweenInfo.new(0.2), {Transparency = 0})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 15, 25)})
        tween(BtnStroke, TweenInfo.new(0.2), {Transparency = 0.3})
    end)

    btn.MouseButton1Click:Connect(function()  
        self:Notify("SYSTEM", "Unloading Cosmic UI...", 2)
        task.wait(0.3)
        self:Unload()
    end)  
      
    self.UpdateSize()  
    return btn
