function UIModule:CreateToggle(
    txt,
    defaultState,
    cb,
    parentFrame
)

    local targetParent =
        parentFrame or self.Content

    local state =
        defaultState or false

    --------------------------------------------------

    local btn =
        Instance.new("TextButton")

    btn.Name = "Toggle"

    btn.Size =
        UDim2.new(0.96, 0, 0, 42)

    btn.BackgroundColor3 =
        THEME.ContainerBg

    btn.BackgroundTransparency = 0.08

    btn.BorderSizePixel = 0

    btn.Text = ""

    btn.AutoButtonColor = false

    btn.Parent =
        targetParent

    addCorner(btn, 9)

    --------------------------------------------------

    local stroke =
        addStroke(
            btn,
            1,
            0.55
        )

    addGradient(
        stroke,
        THEME.AccentCyan,
        THEME.AccentPurple
    )

    --------------------------------------------------
    -- LABEL
    --------------------------------------------------

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.new(1, -70, 1, 0)

    label.Position =
        UDim2.new(0, 12, 0, 0)

    label.BackgroundTransparency = 1

    label.Text =
        txt or "Toggle"

    label.TextColor3 =
        THEME.TextPrimary

    label.Font =
        THEME.FontBody

    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Parent =
        btn

    applyTextSettings(
        label,
        8,
        13
    )

    --------------------------------------------------
    -- SWITCH
    --------------------------------------------------

    local switchBg =
        Instance.new("Frame")

    switchBg.Name =
        "SwitchBackground"

    switchBg.Size =
        UDim2.new(0, 38, 0, 20)

    switchBg.Position =
        UDim2.new(1, -50, 0.5, -10)

    switchBg.BackgroundColor3 =
        THEME.SwitchOff

    switchBg.BorderSizePixel = 0

    switchBg.Parent =
        btn

    addCorner(
        switchBg,
        20
    )

    --------------------------------------------------

    local switchDot =
        Instance.new("Frame")

    switchDot.Name =
        "SwitchDot"

    switchDot.Size =
        UDim2.new(0, 14, 0, 14)

    switchDot.Position =
        UDim2.new(0, 3, 0.5, -7)

    switchDot.BackgroundColor3 =
        THEME.TextMuted

    switchDot.BorderSizePixel = 0

    switchDot.Parent =
        switchBg

    addCorner(
        switchDot,
        20
    )

    --------------------------------------------------
    -- STATE UPDATE
    --------------------------------------------------

    local function updateState(animate)

        local duration =
            animate and 0.2 or 0

        if state then

            tween(
                switchBg,
                TweenInfo.new(duration),
                {
                    BackgroundColor3 =
                        THEME.SwitchOn
                }
            )

            tween(
                switchDot,
                TweenInfo.new(
                    duration,
                    Enum.EasingStyle.Quad
                ),
                {
                    Position =
                        UDim2.new(
                            1,
                            -17,
                            0.5,
                            -7
                        ),

                    BackgroundColor3 =
                        THEME.AccentCyan
                }
            )

        else

            tween(
                switchBg,
                TweenInfo.new(duration),
                {
                    BackgroundColor3 =
                        THEME.SwitchOff
                }
            )

            tween(
                switchDot,
                TweenInfo.new(
                    duration,
                    Enum.EasingStyle.Quad
                ),
                {
                    Position =
                        UDim2.new(
                            0,
                            3,
                            0.5,
                            -7
                        ),

                    BackgroundColor3 =
                        THEME.TextMuted
                }
            )

        end

    end

    updateState(false)

    --------------------------------------------------

    btn.MouseEnter:Connect(function()

        tween(
            btn,
            TweenInfo.new(0.18),
            {
                BackgroundColor3 =
                    THEME.ContainerHover
            }
        )

        tween(
            stroke,
            TweenInfo.new(0.18),
            {
                Transparency = 0.15
            }
        )

    end)

    btn.MouseLeave:Connect(function()

        tween(
            btn,
            TweenInfo.new(0.18),
            {
                BackgroundColor3 =
                    THEME.ContainerBg
            }
        )

        tween(
            stroke,
            TweenInfo.new(0.18),
            {
                Transparency = 0.55
            }
        )

    end)

    --------------------------------------------------

    btn.MouseButton1Click:Connect(function()

        state = not state

        updateState(true)

        if cb then
            cb(state)
        end

    end)

    return btn
end

