-- ---------- ESP (Highlight) ----------
local function AddHighlight(inst, colorFlag)
    if not inst or inst:FindFirstChildOfClass("Highlight") then return end
    local hl = Instance.new("Highlight")
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = inst
    task.spawn(function()
        while hl.Parent and not isUnloaded do
            local col = Flags[colorFlag] and Flags[colorFlag].Color or Color3.new(1,1,1)
            hl.FillColor = col
            hl.OutlineColor = col
            hl.FillTransparency = 0.5
            RunService.Heartbeat:Wait()
        end
    end)
end

local function ClearHighlight(inst)
    if not inst then return end
    local hl = inst:FindFirstChildOfClass("Highlight")
    if hl then hl:Destroy() end
end

