    return nil
end

local function islandUnlocked(
    data,
    islandId
)
    if islandId == "starterIsland" then
        return true
    end

    return
        data
        and type(
            data.UnlockedIslands
        ) == "table"
        and table.find(
            data.UnlockedIslands,
            islandId
        ) ~= nil
end

local function gearOwned(data,key,id)
    return
        data
        and type(data[key]) == "table"
        and table.find(
            data[key],
            id
        ) ~= nil
end

local function bestOwnedGear(
    list,
    data,
    key
)
    if not data
        or type(data[key]) ~= "table" then

        return nil
    end

    local best
    local score = -math.huge

    for _,id in ipairs(
        data[key]
    ) do
        local gear =
            findDefinition(
                list,
                id
            )

        if gear
            and gear[4] > score then

            best = gear
            score = gear[4]
        end
    end

    return best
end

local function bestAffordableGear(
    list,
    data,
    ownedKey,
    equippedKey
)
    if not data then
        return nil
    end

    local money =
        tonumber(data.Gold)
        or 0

    local current =
        findDefinition(
            list,
            data[equippedKey]
        )

    local bestScore =
        current
        and current[4]
        or 0

    local best

    for _,gear in ipairs(list) do
        if gear[3] > 0
            and gear[3] <= money
            and gear[4] > bestScore
            and islandUnlocked(
                data,
                gear[5]
            )
            and not gearOwned(
                data,
                ownedKey,
                gear[1]
            ) then

            best = gear
            bestScore = gear[4]
        end
    end

    return best
end

local ShopCache = {}

local function findShopModel(
    gear,
    folderName
)
    local key =
        folderName
        .. ":"
        .. gear[1]

    local cached =
        ShopCache[key]

    if cached
        and cached.Parent then

        return cached
    end

    for _,object in ipairs(
        workspace:GetDescendants()
    ) do
        if object:IsA("Model")
            and object.Name == gear[2] then

            local ancestor =
                object.Parent

            while ancestor
                and ancestor ~= workspace do

                if ancestor.Name == folderName then
                    ShopCache[key] = object

                    return object
                end

                ancestor =
                    ancestor.Parent
            end
        end
    end

    return nil
end

local function autoBuyGear(
    category,
    list,
    ownedKey,
    equippedKey,
    shopFolder
)
    local data =
        refreshData()

    if not data then
        return false
    end

    local current =
        findDefinition(
            list,
            data[equippedKey]
        )

    local ownedBest =
        bestOwnedGear(
            list,
            data,
            ownedKey
        )

    if ownedBest
        and (
            not current
            or ownedBest[4] > current[4]
        ) then

        local success =
            invoke(
                EquipGearRemote,
                3,
                category,
                ownedBest[1]
            )

        refreshData()

        resetDigEquipment()

        return success == true
    end

    local gear =
        bestAffordableGear(
            list,
            data,
            ownedKey,
            equippedKey
        )

    if not gear then
        return false
    end

    local returnPosition =
        savePosition()

    local shop =
        findShopModel(
            gear,
            shopFolder
        )

    if shop then
        teleportTo(shop)

        task.wait(0.07)
    end

    local success,bought =
        invoke(
            BuyGearRemote,
            4,
            category,
            gear[1]
        )

    if success
        and bought == true then

        task.wait(0.04)

        invoke(
            EquipGearRemote,
            3,
            category,
            gear[1]
        )

        refreshData()
    end

    restorePosition(
        returnPosition
    )

    resetDigEquipment()

    return
        success
        and bought == true
end

