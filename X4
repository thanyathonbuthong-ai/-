            function SectionAPI.CreateSection(_, title, column)
                tabData.NumSections += 1
                local colName
                if isMobile or _G.SINGLE_COLUMNS then colName = "Left"
                elseif column then colName = column
                else
                    tabData.AutoIndex += 1
                    colName = (tabData.AutoIndex % 2 == 1) and "Left" or "Right"
                end
                local col = tabData.Columns[colName]
                if col.Count > 0 and col.LastSection then
                    local spacer = Instance.new("Frame", col.ScrollingFrame)
                    spacer.BackgroundTransparency = 1
                    spacer.Size = UDim2.new(0,0,0,10)
                    spacer.LayoutOrder = col.LastSection.LayoutOrder + #tabData.SectionGroups[col.LastSection] + 1
                    table.insert(tabData.SectionGroups[col.LastSection], spacer)
                end
                currentScroll = col.ScrollingFrame

                local secFrame = Instance.new("Frame", currentScroll)
                secFrame.Name = "Section"
                secFrame.BackgroundTransparency = 1
                secFrame.Size = UDim2.new(1,0,0,28)

                local secBtn = Instance.new("TextButton", secFrame)
                secBtn.BackgroundTransparency = 1
                secBtn.Position = UDim2.new(0,10,0,0)
                secBtn.Size = UDim2.new(1,-20,1,0)
                secBtn.Font = Enum.Font.ArialBold
                secBtn.Text = title
                secBtn.TextColor3 = Color3.fromRGB(199,199,199)
                secBtn.TextSize = 13
                secBtn.TextXAlignment = Enum.TextXAlignment.Left
                secBtn.ZIndex = 2

                local shadow = secBtn:Clone()
                shadow.ZIndex = 1
                shadow.TextColor3 = Color3.new(0,0,0)
                shadow.Position += UDim2.fromOffset(1,1)
                shadow.Parent = secFrame
                shadow.Active = false

                tabData.CurrentSectionIndex += 1
                secFrame.LayoutOrder = tabData.CurrentSectionIndex * 1000
                tabData.CurrentSection = secFrame
                tabData.SectionGroups[secFrame] = {}
                col.Count += 1
                col.LastSection = secFrame

                local collapsed, busy = false, false
                local dur, step = 0.2, 0.06
                local tweenInf = TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                secBtn.MouseButton1Click:Connect(function()
                    if busy then return end
                    busy = true
                    collapsed = not collapsed
                    local items = tabData.SectionGroups[secFrame]
                    local count = #items
                    local total = dur + (count > 0 and (count - 1) * step or 0)
                    if collapsed then
                        local sizes, clips, poses, autos = {}, {}, {}, {}
                        for i = 1, count do
                            local it = items[i]
                            sizes[it] = it.Size
                            autos[it] = it.AutomaticSize
                            if it.AutomaticSize ~= Enum.AutomaticSize.None then it.AutomaticSize = Enum.AutomaticSize.None end
                            clips[it] = it.ClipsDescendants
                            poses[it] = it.Position
                            it.ClipsDescendants = true
                        end
                        for i = count, 1, -1 do
                            local it = items[i]
                            local delay = (count - i) * step
                            local h = sizes[it].Y.Offset
                            task.delay(delay, function()
                                TweenService:Create(it, tweenInf, {Size = UDim2.new(it.Size.X.Scale, it.Size.X.Offset, 0, 0)}):Play()
                                for j = i + 1, count do
                                    local other = items[j]
                                    TweenService:Create(other, tweenInf, {Position = UDim2.new(other.Position.X.Scale, other.Position.X.Offset, other.Position.Y.Scale, other.Position.Y.Offset - h)}):Play()
                                end
                            end)
                        end
                        task.delay(total, function()
                            for i = 1, count do
                                local it = items[i]
                                it.Parent = hiddenFolder
                                it.Position = poses[it]
                                it:SetAttribute("__restoreX", sizes[it].X.Scale)
                                it:SetAttribute("__restoreXO", sizes[it].X.Offset)
                                it:SetAttribute("__restoreY", sizes[it].Y.Scale)
                                it:SetAttribute("__restoreYO", sizes[it].Y.Offset)
                                it:SetAttribute("__clips", clips[it])
                                it:SetAttribute("__autosize", autos[it].Name)
                            end
                            busy = false
                        end)
                    else
                        for i = 1, count do
                            local it = items[i]
                            it.Size = UDim2.new(it:GetAttribute("__restoreX") or 0, it:GetAttribute("__restoreXO") or 0, 0, 0)
                            it.Parent = currentScroll
                        end
                        task.wait()
                        local posMap = {}
                        for i = 1, count do posMap[items[i]] = items[i].Position end
                        for i = 1, count do items[i].Position = posMap[items[i]] end
                        for i = 1, count do
                            local it = items[i]
                            local rx, rxo, ry, ryo = it:GetAttribute("__restoreX") or 0, it:GetAttribute("__restoreXO") or 0, it:GetAttribute("__restoreY") or 0, it:GetAttribute("__restoreYO") or 0
                            task.delay((i-1)*step, function()
                                TweenService:Create(it, tweenInf, {Size = UDim2.new(rx, rxo, ry, ryo)}):Play()
                                for j = i+1, count do
                                    local other = items[j]
                                    TweenService:Create(other, tweenInf, {Position = UDim2.new(other.Position.X.Scale, other.Position.X.Offset, other.Position.Y.Scale, other.Position.Y.Offset + ryo)}):Play()
                                end
                            end)
                        end
                        task.delay(total, function()
                            for i = 1, count do
                                local it = items[i]
                                local clip = it:GetAttribute("__clips")
                                it.ClipsDescendants = clip == nil and false or clip
                                local auto = it:GetAttribute("__autosize")
                                if auto then it.AutomaticSize = Enum.AutomaticSize[auto] end
                            end
                            busy = false
                        end)
                    end
                end)

                return { Set = function(_, txt) secBtn.Text = txt shadow.Text = txt end }
            end

