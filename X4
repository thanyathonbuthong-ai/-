local function loadSettings()
    if not Caps.ReadFile or not Caps.IsFile then
        return {}
    end

    local success,data = pcall(function()
        if not isfile(SAVE_FILE) then
            return nil
        end

        return HttpService:JSONDecode(
            readfile(SAVE_FILE)
        )
    end)

    if success and type(data) == "table" then
        return data
    end

    return {}
end

