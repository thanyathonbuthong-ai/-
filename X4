local function sellUid(uid)
    if not uid then
        return false,"missing uid"
    end

    local item =
        findInventory(
            uid,
            refreshData()
        )

    if not item then
        return true,"gone"
    end

    if item.favorited == true then
        return false,"favorited"
    end

    if item.pedestalSlot ~= nil then
        return false,"displayed"
    end

    unequipTools()

    if not equipUid(uid) then
        return false,"equip failed"
    end

    local seller =
        getSeller()

    if not seller then
        return false,"seller missing"
    end

    teleportNear(
        seller,
        3
    )

    task.wait(0.09)

    for attempt = 1,3 do
        if not equipUid(uid) then
            task.wait(0.1)
            continue
        end

        local success,result =
            invoke(
                SellHeldRemote,
                3
            )

        task.wait(0.1)

        if not itemStillExists(uid) then
            resetDigEquipment()

            return true,"sold"
        end

        if result == "favorited" then
            resetDigEquipment()

            return false,"favorited"
        end

        if attempt < 3 then
            teleportNear(
                seller,
                3
            )

            task.wait(0.1)
        end
    end

    resetDigEquipment()

    return false,"sell failed"
end

