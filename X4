-- ---------- Helpers ----------
local function GetClosestKiller(maxDist)
    maxDist = maxDist or 5000
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, maxDist
    for _, char in ipairs(GameData.Killers) do
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - root.Position).Magnitude
            if d < bestD then bestD, best = d, char end
        end
    end
    return best
end

local function GetClosestSurvivor(maxDist)
    maxDist = maxDist or 5000
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, maxDist
    for _, char in ipairs(GameData.Survivors) do
        if char == LocalPlayer.Character then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - root.Position).Magnitude
            if d < bestD then bestD, best = d, char end
        end
    end
    return best
end

local function IsKiller()
    local char = LocalPlayer.Character
    return char and KillersFolder and char.Parent == KillersFolder
end

local function HasAbility(name)
    local ui = PlayerGui:FindFirstChild("MainUI")
    return ui and ui:FindFirstChild("AbilityContainer") and ui.AbilityContainer:FindFirstChild(name)
end

local function HasAbilityReady(name)
    local ab = HasAbility(name)
    return ab and ab:FindFirstChild("CooldownTime") and ab.CooldownTime.Text == ""
end

local function FireAbility(name)
    if Network then
        pcall(function()
            Network:FireServerConnection("UseActorAbility", "REMOTE_EVENT", name)
        end)
    end
end

local function stareFunc(target)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end
    local pos = myRoot.Position
    myRoot.CFrame = CFrame.new(pos, Vector3.new(targetRoot.Position.X, pos.Y, targetRoot.Position.Z))
end

