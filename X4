-- Helper to create toggle with Flag support
-- ------------------------------------------------------------------
local function MakeToggle(parent, opts)
    local flagName = opts.Flag
    local default = opts.CurrentValue or false
    if flagName and Flags[flagName] then
        Flags[flagName].CurrentValue = default
    end
    return parent:Toggle({
        Title = opts.Name or opts.Title or "Toggle",
        Desc = opts.Desc,
        Value = default,
        Flag = flagName,
        Callback = function(v)
            if flagName and Flags[flagName] then
                Flags[flagName].CurrentValue = v
            end
            if opts.Callback then
                task.spawn(opts.Callback, v)
            end
        end
    })
end

local function MakeButton(parent, opts)
    return parent:Button({
        Title = opts.Name or opts.Title or "Button",
        Icon = opts.Icon,
        Callback = opts.Callback or EmptyCallback
    })
end

local function MakeSlider(parent, opts)
    local flagName = opts.Flag
    local default = opts.CurrentValue or (opts.Range and opts.Range[1]) or 0
    if flagName and Flags[flagName] then
        Flags[flagName].CurrentValue = default
    end
    return parent:Slider({
        Title = opts.Name or opts.Title or "Slider",
        Desc = opts.Desc,
        Step = opts.Increment or 1,
        Value = {
            Min = opts.Range and opts.Range[1] or 0,
            Max = opts.Range and opts.Range[2] or 100,
            Default = default
        },
        Flag = flagName,
        Callback = function(v)
            if flagName and Flags[flagName] then
                Flags[flagName].CurrentValue = v
            end
            if opts.Callback then opts.Callback(v) end
        end
    })
end

local function MakeDropdown(parent, opts)
    local flagName = opts.Flag
    local default = opts.CurrentOption or {}
    if flagName and Flags[flagName] then
        Flags[flagName].CurrentOption = default
    end
    return parent:Dropdown({
        Title = opts.Name or opts.Title or "Dropdown",
        Values = opts.Options or {},
        Value = type(default) == "table" and default[1] or default,
        Multi = opts.MultipleOptions,
        Flag = flagName,
        Callback = function(v)
            local val = type(v) == "table" and v or {v}
            if flagName and Flags[flagName] then
                Flags[flagName].CurrentOption = val
            end
            if opts.Callback then opts.Callback(val) end
        end
    })
end

local function MakeColorpicker(parent, opts)
    local flagName = opts.Flag
    local default = opts.Color or Color3.new(1,1,1)
    if flagName and Flags[flagName] then
        Flags[flagName].Color = default
    end
    return parent:Colorpicker({
        Title = opts.Name or opts.Title or "Color",
        Default = default,
        Flag = flagName,
        Callback = function(color)
            if flagName and Flags[flagName] then
                Flags[flagName].Color = color
            end
            if opts.Callback then opts.Callback(color) end
        end
    })
end

local function MakeInput(parent, opts)
    local flagName = opts.Flag
    local default = opts.CurrentValue or ""
    if flagName and Flags[flagName] then
        Flags[flagName].CurrentValue = default
    end
    return parent:Input({
        Title = opts.Name or opts.Title or "Input",
        Value = default,
        Placeholder = opts.PlaceholderText,
        Flag = flagName,
        Callback = function(txt)
            if flagName and Flags[flagName] then
                Flags[flagName].CurrentValue = txt
            end
            if opts.Callback then opts.Callback(txt) end
        end
    })
end

local function MakeSection(parent, title)
    return parent:Section({ Title = title })
end

local function Notify(data)
    WindUI:Notify({
        Title = data.Title or "AmberCore",
        Content = data.Content or "",
        Duration = data.Duration or 5,
        Icon = data.Image
    })
end

