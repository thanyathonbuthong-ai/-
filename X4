    frameStroke.Transparency = 0.5
    frameStroke.Parent = frame  
    addCosmicGradient(frameStroke, THEME.AccentCyan, THEME.AccentPurple)

    local label = Instance.new("TextLabel")  
    label.Size = UDim2.new(0.45, 0, 1, 0)  
    label.Position = UDim2.new(0, 10, 0, 0)  
    label.BackgroundTransparency = 1  
    label.Text = txt  
    label.TextColor3 = THEME.TextPrimary  
    label.Font = THEME.FontBody  
    label.TextXAlignment = Enum.TextXAlignment.Left  
    label.Parent = frame  
    applyTextSettings(label, 8, 13)  

    local textBox = Instance.new("TextBox")  
    textBox.Size = UDim2.new(0.5, -8, 0, 24)  
    textBox.Position = UDim2.new(0.5, 0, 0.5, -12)  
    textBox.BackgroundColor3 = Color3.fromRGB(12, 12, 26)  
    textBox.Text = ""  
    textBox.PlaceholderText = placeholder or "Enter..."  
    textBox.PlaceholderColor3 = THEME.TextMuted  
    textBox.TextColor3 = THEME.AccentCyan  
    textBox.Font = THEME.FontBody  
    textBox.ClearTextOnFocus = false  
    textBox.Parent = frame  
    applyTextSettings(textBox, 8, 13)  

    local boxCorner = Instance.new("UICorner")  
    boxCorner.CornerRadius = UDim.new(0, 4)  
    boxCorner.Parent = textBox  

    local boxStroke = Instance.new("UIStroke")  
    boxStroke.Thickness = 1  
    boxStroke.Color = THEME.AccentCyan  
    boxStroke.Transparency = 0.6
    boxStroke.Parent = textBox  

    textBox.Focused:Connect(function()
        tween(boxStroke, TweenInfo.new(0.2), {Transparency = 0, Color = THEME.AccentCyan})
    end)
    textBox.FocusLost:Connect(function(enterPressed)  
        tween(boxStroke, TweenInfo.new(0.2), {Transparency = 0.6})
        if cb then cb(textBox.Text, enterPressed) end  
    end)  

    self.UpdateSize()  
    return frame
end

-- --- 11. Keybind (:CreateKeybind) ---
function UIModule:CreateKeybind(txt, defaultKey, cb, parentFrame)
    local targetParent = parentFrame or self.Content
    local currentKey = defaultKey or Enum.KeyCode.E
    local listening = false

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.96, 0, 0, 36)
    btn.BackgroundColor3 = THEME.ContainerBg
    btn.BackgroundTransparency = 0.2
    btn.Text = ""
    btn.Parent = targetParent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Thickness = 1.2
    BtnStroke.Transparency = 0.5
    BtnStroke.Parent = btn
    addCosmicGradient(BtnStroke, THEME.AccentCyan, THEME.AccentPurple)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = txt
    label.TextColor3 = THEME.TextPrimary
    label.Font = THEME.FontBody
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn
    applyTextSettings(label, 8, 13)

    local keyBox = Instance.new("TextLabel")
    keyBox.Size = UDim2.new(0.35, -8, 0, 24)
    keyBox.Position = UDim2.new(0.65, 0, 0.5, -12)
    keyBox.BackgroundColor3 = Color3.fromRGB(14, 14, 30)
    keyBox.Text = currentKey.Name
    keyBox.TextColor3 = THEME.AccentCyan
    keyBox.Font = THEME.FontBody
    keyBox.Parent = btn
    applyTextSettings(keyBox, 8, 12)

    local keyCorner = Instance.new("UICorner")
    keyCorner.CornerRadius = UDim.new(0, 4)
    keyCorner.Parent = keyBox

    btn.MouseButton1Click:Connect(function()
        listening = true
        keyBox.Text = "..."
        keyBox.TextColor3 = THEME.AccentPurple
    end)

    table.insert(self.Connections, UIS.InputBegan:Connect(function(input, gpe)
        if listening and not gpe then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                keyBox.Text = currentKey.Name
                keyBox.TextColor3 = THEME.AccentCyan
                listening = false
                if cb then cb(currentKey) end
            end
        end
    end))

    self.UpdateSize()
    return btn
end

return UIModule
