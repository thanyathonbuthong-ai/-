-- เก็บสถานะการย่อของ Section แยกกัน และบังคับให้เปิดกลับได้เสมอ
do
	local sectionState = setmetatable({}, { __mode = "k" })

	local function patchSection(section)
		if not section or sectionState[section] then
			return
		end
		sectionState[section] = {
			collapsed = false
		}
	end

	-- หากไลบรารีมีเมธอดสำหรับ Section ให้ห่อ callback เดิมโดยไม่ทำลายของเดิม
	local ok, sections = pcall(function()
		return value4.Sections
	end)
	if ok and type(sections) == "table" then
		for _, section in pairs(sections) do
			patchSection(section)
		end
	end
end

