                local optionButtons = {}
                local optionCircles = {}

                local RadioFrame = Instance.new("Frame")
                RadioFrame.Size = UDim2.new(1, 0, 0, 35)
                RadioFrame.BackgroundTransparency = 1
                RadioFrame.Parent = ItemsContainer

                local RadioLabel = Instance.new("TextLabel")
