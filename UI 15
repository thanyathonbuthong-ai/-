--[[
================================================================================
  KiraUI Library  (standalone rebuild of the Kira Hub UI layer)
--------------------------------------------------------------------------------
  Extracted & cleaned from the "Kira Hub" script (game: Steal an Egg).
  The original was heavily minified and tangled with game logic, so this is a
  faithful, self-contained rebuild preserving Kira's design language:
    - warm dark/light themes with gold accent
    - left icon-rail navigation
    - BuilderSans typography
    - components: Section / Button / Toggle / Slider / Dropdown / Input
                  / Keybind / Label / ColorPicker
    - notifications, drag, open-keybind, config persistence, unload

  Usage:
    local KiraUI = loadstring(game:HttpGet("<raw-url-of-this-file>"))()
    local Window = KiraUI:CreateWindow({
        Title   = "My Hub",
        Version = "1.0",
        Product = "Game Name",
        Discord = "https://discord.gg/...",   -- optional
        Author  = "@you",
        OpenBind = Enum.KeyCode.RightShift,
        Theme   = "Dark",                     -- "Dark" | "Light"
    })
    local Tab = Window:CreateTab({ Name = "Main", Icon = "info" })
    Tab:AddSection("Hello")
    Tab:AddButton({ Name = "Click me", Callback = function() print("hi") end })
    Tab:AddToggle({ Name = "Auto farm", Flag = "auto_farm", Default = false,
                    Callback = function(v) print(v) end })
    -- see Example.lua for the full component demo
================================================================================
]]

