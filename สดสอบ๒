-- Arrest Aura
MiscTab:AddSection("Arrest Aura")

local AAState = {
    Enabled = false,
    FriendCheck = false,
    HandCheck = false,
    Radius = 8,
    Whitelist = {},
}

local ArrestRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("ArrestPlayer")
local arrestCooldown = 0

local function IsArrestable(player)
    local teamName = player.Team and player.Team.Name or ""
    if teamName == "Criminals" then return true end
    if teamName == "Inmates" then
        local char = player.Character
        if char then
            local status = PL.GetInmateStatus(char)
            if status == "Arrestable" or status == "Aggressive" then return true end
        end
    end
    return false
end

MiscTab:AddToggle({
    Name = "Arrest Aura",
    Description = "Auto arrest nearby players",
    Callback = function(Value) AAState.Enabled = Value end
})

MiscTab:AddInput({
    Name = "Arrest Radius",
    Description = "Max 8 studs",
    SaveConfig = true,
    Callback = function(text)
        local num = tonumber(text)
        if num then AAState.Radius = math.clamp(num, 1, 8) end
    end
})

MiscTab:AddToggle({
    Name = "Hand Check",
    Description = "Require holding handcuffs",
    Callback = function(Value) AAState.HandCheck = Value end
})

MiscTab:AddToggle({
    Name = "Arrest Friend Check",
    Description = "Ignore friends",
    Callback = function(Value) AAState.FriendCheck = Value end
})

TrackConnection(RunService.RenderStepped:Connect(function()
    if not AAState.Enabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local closestPlayer, closestDist = nil, AAState.Radius

    for _, player in Players:GetPlayers() do
        if player == LocalPlayer then continue end
        if AAState.Whitelist[player.Name] then continue end
        if AAState.FriendCheck and FriendsCache[player.Name] then continue end
        if not IsArrestable(player) then continue end

        local targetChar = player.Character
        if not targetChar then continue end
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then continue end

        local dist = (rootPart.Position - targetRoot.Position).Magnitude
        if dist <= closestDist then
            closestDist = dist
            closestPlayer = player
        end
    end

    local canArrest = arrestCooldown < os.clock()
    if AAState.HandCheck then
        local tool = character:FindFirstChildWhichIsA("Tool")
        canArrest = canArrest and tool and tool.Name == "Handcuffs"
    end

    if closestPlayer and canArrest and ArrestRemote then
        local tChar = closestPlayer.Character
        if tChar and not tChar:GetAttribute("Arrested") then
            local success, didArrest = pcall(function()
                return ArrestRemote:InvokeServer(closestPlayer, 1)
            end)
            if success and didArrest then
                arrestCooldown = os.clock() + 7
                windows:Notification({
                    Name = "Arrest",
                    Description = "Arrested " .. closestPlayer.Name,
                    Type = "Notification",
                    Duration = 3
                })
            end
        end
    end
end))

-- Anti Tase
MiscTab:AddSection("Utility")

local ATEnabled = false
local taseOldFn, taseConn = nil, nil
local PlayerTased = ReplicatedStorage:FindFirstChild("GunRemotes") and ReplicatedStorage.GunRemotes:FindFirstChild("PlayerTased")

local function hookTaseHandler()
    if taseOldFn or not PlayerTased then return end
    local conns = getconnections(PlayerTased.OnClientEvent)
    if not conns[1] or not conns[1].Function then return end

    taseConn = conns[1]
    taseOldFn = hookfunction(taseConn.Function, function()
        local char = LocalPlayer.Character
        LocalPlayer:SetAttribute("BackpackEnabled", false)
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid:UnequipTools() end
        end
        task.wait(3.5)
        if LocalPlayer.Character == char then
            LocalPlayer:SetAttribute("BackpackEnabled", true)
        end
    end)
end

local function unhookTaseHandler()
    if taseOldFn and taseConn and taseConn.Function then
        hookfunction(taseConn.Function, taseOldFn)
        taseOldFn = nil
    end
end

MiscTab:AddToggle({
    Name = "Anti Tase",
    Description = "Reduce tase effects",
    Callback = function(Value)
        ATEnabled = Value
        if Value then hookTaseHandler() else unhookTaseHandler() end
    end
})

TrackConnection(LocalPlayer.CharacterAdded:Connect(function()
    if ATEnabled then
        unhookTaseHandler()
        task.defer(hookTaseHandler)
    end
end))

RegisterCleanup(unhookTaseHandler)

-- Remove Jump Cooldown
local NJCEnabled = false
local jumpConnDisabled = nil

local function onCharJump(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid or not NJCEnabled then return end
    local conns = getconnections(humanoid:GetPropertyChangedSignal("Jump"))
    if conns[1] then
        jumpConnDisabled = conns[1]
        jumpConnDisabled:Disable()
    end
end

MiscTab:AddToggle({
    Name = "Remove Jump Cooldown",
    Description = "Remove jump delay",
    Callback = function(Value)
        NJCEnabled = Value
        if Value then
            if LocalPlayer.Character then task.spawn(onCharJump, LocalPlayer.Character) end
        elseif jumpConnDisabled then
            pcall(function() jumpConnDisabled:Enable() end)
            jumpConnDisabled = nil
        end
    end
})

TrackConnection(LocalPlayer.CharacterAdded:Connect(function(character)
    if NJCEnabled then task.spawn(onCharJump, character) end
end))

RegisterCleanup(function()
    if jumpConnDisabled then
        pcall(function() jumpConnDisabled:Enable() end)
    end
end)

-- Simulate Keycard
MiscTab:AddSection("Simulate Keycard")

local SKState = { Enabled = false, Connection = nil, CharConnection = nil }

local function openDoor(door)
    door:SetAttribute("LocalPlayerOpened", true)
    local glow = door:FindFirstChild("scn") and door.scn:FindFirstChild("glow")
    if glow then
        glow.BrickColor = BrickColor.new("Bright green")
        glow.Material = Enum.Material.Neon
    end
    local scanner = door:FindFirstChild("scn") and door.scn:FindFirstChild("cardScanner")
    if scanner and scanner:FindFirstChild("Sound") then
        scanner.Sound:Play()
    end
    task.delay(2, function()
        door:SetAttribute("LocalPlayerOpened", false)
        if glow then
            glow.BrickColor = BrickColor.new("Bright red")
            glow.Material = Enum.Material.SmoothPlastic
        end
    end)
end

local function onCharKeycard(character)
    if SKState.Connection then
        SKState.Connection:Disconnect()
        SKState.Connection = nil
    end
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    SKState.Connection = root.Touched:Connect(function(hit)
        if not SKState.Enabled then return end
        if hit.Name ~= "hitbox" then return end
        local door = hit.Parent and hit.Parent.Parent
        if door and CollectionService:HasTag(door, "Door") then
            openDoor(door)
        end
    end)
end

MiscTab:AddToggle({
    Name = "Simulate Keycard",
    Description = "Open keycard doors without card",
    Callback = function(Value)
        SKState.Enabled = Value
        if Value then
            if LocalPlayer.Character then onCharKeycard(LocalPlayer.Character) end
            SKState.CharConnection = LocalPlayer.CharacterAdded:Connect(onCharKeycard)
        else
            if SKState.Connection then SKState.Connection:Disconnect() SKState.Connection = nil end
            if SKState.CharConnection then SKState.CharConnection:Disconnect() SKState.CharConnection = nil end
        end
    end
})

RegisterCleanup(function()
    if SKState.Connection then SKState.Connection:Disconnect() end
    if SKState.CharConnection then SKState.CharConnection:Disconnect() end
end)

