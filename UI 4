local MINIMIZED_SIZE = UDim2.new(0, 260, 0, 42)
​local MinBtn = Instance.new("TextButton")
MinBtn.Size = UDim2.new(0, 22, 0, 22)
MinBtn.Position = UDim2.new(1, -30, 0, 10)
MinBtn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
MinBtn.Text = "-"
